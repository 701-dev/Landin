    elsif which == 16 then
        put(into, at, canonical_32(bits_32(math.log2(from_32(take_32(record, 0))))), 4)
    elsif which == 17 then
        put(into, at, canonical_32(bits_32(math.log10(from_32(take_32(record, 0))))), 4)
    elsif which == 18 then
        put(into, at, canonical_32(bits_32(math.log1p(from_32(take_32(record, 0))))), 4)
    elsif which == 19 then
        put(into, at, canonical_32(bits_32(math.pow(from_32(take_32(record, 0)), from_32(take_32(record, 1))))), 4)
    elsif which == 20 then
        put(into, at, canonical_32(bits_32(math.sin(from_32(take_32(record, 0))))), 4)
    elsif which == 21 then
        put(into, at, canonical_32(bits_32(math.cos(from_32(take_32(record, 0))))), 4)
    elsif which == 22 then
        put(into, at, canonical_32(bits_32(math.tan(from_32(take_32(record, 0))))), 4)
    elsif which == 23 then
        put(into, at, canonical_32(bits_32(math.asin(from_32(take_32(record, 0))))), 4)
    elsif which == 24 then
        put(into, at, canonical_32(bits_32(math.acos(from_32(take_32(record, 0))))), 4)
