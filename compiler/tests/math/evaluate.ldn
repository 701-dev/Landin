    elsif which == 36 then
        put(into, at, canonical_32(bits_32(math.log_gamma(from_32(take_32(record, 0))))), 4)
    elsif which == 37 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        w: complex.number(f32) = (real: from_32(take_32(record, 2)), imaginary: from_32(take_32(record, 3)))
        got: complex.number(f32) = complex.add(z, w)
        put(into, at, canonical_32(bits_32(got.real)), 4)
        put(into, at + 4, canonical_32(bits_32(got.imaginary)), 4)
    elsif which == 38 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        w: complex.number(f32) = (real: from_32(take_32(record, 2)), imaginary: from_32(take_32(record, 3)))
        got: complex.number(f32) = complex.subtract(z, w)
        put(into, at, canonical_32(bits_32(got.real)), 4)
        put(into, at + 4, canonical_32(bits_32(got.imaginary)), 4)
    elsif which == 39 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        w: complex.number(f32) = (real: from_32(take_32(record, 2)), imaginary: from_32(take_32(record, 3)))
        got: complex.number(f32) = complex.multiply(z, w)
