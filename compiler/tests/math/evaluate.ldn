end apply_64

apply_32: (which: u32, record: []u8, into: []mut u8, at: usize) -> none =
    if which == 1 then
        put(into, at, canonical_32(bits_32(math.sqrt(from_32(take_32(record, 0))))), 4)
    elsif which == 2 then
        put(into, at, canonical_32(bits_32(math.cbrt(from_32(take_32(record, 0))))), 4)
    elsif which == 3 then
        put(into, at, canonical_32(bits_32(math.hypot(from_32(take_32(record, 0)), from_32(take_32(record, 1))))), 4)
    elsif which == 4 then
        put(into, at, canonical_32(bits_32(math.fma(from_32(take_32(record, 0)), from_32(take_32(record, 1)), from_32(take_32(record, 2))))), 4)
