--  The function's result for the inputs in `record`, written into `into`
--  from `at`.
apply_64: (which: u32, record: []u8, into: []mut u8, at: usize) -> none =
    if which == 1 then
        put(into, at, canonical_64(bits_64(math.sqrt(from_64(take_64(record, 0))))), 8)
    elsif which == 2 then
        put(into, at, canonical_64(bits_64(math.cbrt(from_64(take_64(record, 0))))), 8)
    elsif which == 3 then
        put(into, at, canonical_64(bits_64(math.hypot(from_64(take_64(record, 0)), from_64(take_64(record, 1))))), 8)
    elsif which == 4 then
        put(into, at, canonical_64(bits_64(math.fma(from_64(take_64(record, 0)), from_64(take_64(record, 1)), from_64(take_64(record, 2))))), 8)
    elsif which == 5 then
        put(into, at, canonical_64(bits_64(math.floor(from_64(take_64(record, 0))))), 8)
    elsif which == 6 then
        put(into, at, canonical_64(bits_64(math.ceil(from_64(take_64(record, 0))))), 8)
    elsif which == 7 then
        put(into, at, canonical_64(bits_64(math.trunc(from_64(take_64(record, 0))))), 8)
    elsif which == 8 then
        put(into, at, canonical_64(bits_64(math.round(from_64(take_64(record, 0))))), 8)
    elsif which == 9 then
        put(into, at, canonical_64(bits_64(math.round_even(from_64(take_64(record, 0))))), 8)
    elsif which == 10 then
        put(into, at, canonical_64(bits_64(math.remainder(from_64(take_64(record, 0)), from_64(take_64(record, 1))))), 8)
    elsif which == 11 then
        put(into, at, canonical_64(bits_64(math.remainder_nearest(from_64(take_64(record, 0)), from_64(take_64(record, 1))))), 8)
    elsif which == 12 then
        put(into, at, canonical_64(bits_64(math.exp(from_64(take_64(record, 0))))), 8)
    elsif which == 13 then
        put(into, at, canonical_64(bits_64(math.exp2(from_64(take_64(record, 0))))), 8)
    elsif which == 14 then
        put(into, at, canonical_64(bits_64(math.expm1(from_64(take_64(record, 0))))), 8)
    elsif which == 15 then
        put(into, at, canonical_64(bits_64(math.log(from_64(take_64(record, 0))))), 8)
    elsif which == 16 then
        put(into, at, canonical_64(bits_64(math.log2(from_64(take_64(record, 0))))), 8)
    elsif which == 17 then
        put(into, at, canonical_64(bits_64(math.log10(from_64(take_64(record, 0))))), 8)
    elsif which == 18 then
        put(into, at, canonical_64(bits_64(math.log1p(from_64(take_64(record, 0))))), 8)
    elsif which == 19 then
        put(into, at, canonical_64(bits_64(math.pow(from_64(take_64(record, 0)), from_64(take_64(record, 1))))), 8)
    elsif which == 20 then
        put(into, at, canonical_64(bits_64(math.sin(from_64(take_64(record, 0))))), 8)
    elsif which == 21 then
        put(into, at, canonical_64(bits_64(math.cos(from_64(take_64(record, 0))))), 8)
    elsif which == 22 then
        put(into, at, canonical_64(bits_64(math.tan(from_64(take_64(record, 0))))), 8)
    elsif which == 23 then
        put(into, at, canonical_64(bits_64(math.asin(from_64(take_64(record, 0))))), 8)
    elsif which == 24 then
        put(into, at, canonical_64(bits_64(math.acos(from_64(take_64(record, 0))))), 8)
    elsif which == 25 then
        put(into, at, canonical_64(bits_64(math.atan(from_64(take_64(record, 0))))), 8)
    elsif which == 26 then
        put(into, at, canonical_64(bits_64(math.atan2(from_64(take_64(record, 0)), from_64(take_64(record, 1))))), 8)
    elsif which == 27 then
        put(into, at, canonical_64(bits_64(math.sinh(from_64(take_64(record, 0))))), 8)
    elsif which == 28 then
        put(into, at, canonical_64(bits_64(math.cosh(from_64(take_64(record, 0))))), 8)
    elsif which == 29 then
        put(into, at, canonical_64(bits_64(math.tanh(from_64(take_64(record, 0))))), 8)
    elsif which == 30 then
        put(into, at, canonical_64(bits_64(math.asinh(from_64(take_64(record, 0))))), 8)
    elsif which == 31 then
        put(into, at, canonical_64(bits_64(math.acosh(from_64(take_64(record, 0))))), 8)
    elsif which == 32 then
        put(into, at, canonical_64(bits_64(math.atanh(from_64(take_64(record, 0))))), 8)
    elsif which == 33 then
        put(into, at, canonical_64(bits_64(math.erf(from_64(take_64(record, 0))))), 8)
    elsif which == 34 then
        put(into, at, canonical_64(bits_64(math.erfc(from_64(take_64(record, 0))))), 8)
    elsif which == 35 then
        put(into, at, canonical_64(bits_64(math.gamma(from_64(take_64(record, 0))))), 8)
    elsif which == 36 then
        put(into, at, canonical_64(bits_64(math.log_gamma(from_64(take_64(record, 0))))), 8)
    elsif which == 37 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        w: complex.number(f64) = (real: from_64(take_64(record, 2)), imaginary: from_64(take_64(record, 3)))
        got: complex.number(f64) = complex.add(z, w)
        put(into, at, canonical_64(bits_64(got.real)), 8)
        put(into, at + 8, canonical_64(bits_64(got.imaginary)), 8)
    elsif which == 38 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        w: complex.number(f64) = (real: from_64(take_64(record, 2)), imaginary: from_64(take_64(record, 3)))
        got: complex.number(f64) = complex.subtract(z, w)
        put(into, at, canonical_64(bits_64(got.real)), 8)
        put(into, at + 8, canonical_64(bits_64(got.imaginary)), 8)
    elsif which == 39 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        w: complex.number(f64) = (real: from_64(take_64(record, 2)), imaginary: from_64(take_64(record, 3)))
        got: complex.number(f64) = complex.multiply(z, w)
        put(into, at, canonical_64(bits_64(got.real)), 8)
        put(into, at + 8, canonical_64(bits_64(got.imaginary)), 8)
    elsif which == 40 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        w: complex.number(f64) = (real: from_64(take_64(record, 2)), imaginary: from_64(take_64(record, 3)))
        got: complex.number(f64) = complex.divide(z, w)
        put(into, at, canonical_64(bits_64(got.real)), 8)
        put(into, at + 8, canonical_64(bits_64(got.imaginary)), 8)
    elsif which == 41 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        got: complex.number(f64) = complex.negate(z)
        put(into, at, canonical_64(bits_64(got.real)), 8)
        put(into, at + 8, canonical_64(bits_64(got.imaginary)), 8)
    elsif which == 42 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        got: complex.number(f64) = complex.conjugate(z)
        put(into, at, canonical_64(bits_64(got.real)), 8)
        put(into, at + 8, canonical_64(bits_64(got.imaginary)), 8)
    elsif which == 43 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        got: complex.number(f64) = complex.project(z)
        put(into, at, canonical_64(bits_64(got.real)), 8)
        put(into, at + 8, canonical_64(bits_64(got.imaginary)), 8)
    elsif which == 44 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        put(into, at, canonical_64(bits_64(complex.abs(z))), 8)
    elsif which == 45 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        put(into, at, canonical_64(bits_64(complex.arg(z))), 8)
    elsif which == 46 then
        got: complex.number(f64) = complex.from_polar(from_64(take_64(record, 0)), from_64(take_64(record, 1)))
        put(into, at, canonical_64(bits_64(got.real)), 8)
        put(into, at + 8, canonical_64(bits_64(got.imaginary)), 8)
    elsif which == 47 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        got: complex.number(f64) = complex.exp(z)
        put(into, at, canonical_64(bits_64(got.real)), 8)
        put(into, at + 8, canonical_64(bits_64(got.imaginary)), 8)
    elsif which == 48 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
        got: complex.number(f64) = complex.log(z)
        put(into, at, canonical_64(bits_64(got.real)), 8)
        put(into, at + 8, canonical_64(bits_64(got.imaginary)), 8)
    elsif which == 49 then
        z: complex.number(f64) = (real: from_64(take_64(record, 0)), imaginary: from_64(take_64(record, 1)))
