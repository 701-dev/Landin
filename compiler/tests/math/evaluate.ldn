--  Generated by scripts/math_oracle.py: run `python3 scripts/math_oracle.py
--  fixtures` to write it again.  The program `measure` and `exhaustive`
--  run: `evaluate FUNCTION WIDTH` reads records of the function's inputs,
--  little-endian at WIDTH bits, from standard input and writes each
--  record back with core/math's result after it;  `evaluate FUNCTION 32
--  FIRST COUNT` writes the records of COUNT f32 inputs, every bit pattern
--  from FIRST up, without reading any.
import core/io
import core/math
import core/text
import hosted/blocking

arity: (name: []u8) -> (count: usize) =
    count = 1
    if same(name, "hypot") or same(name, "remainder")
      or same(name, "remainder_nearest") or same(name, "pow")
      or same(name, "atan2") then
        count = 2
    elsif same(name, "fma") then
        count = 3
    end if
end arity

same: (left: []u8, right: []u8) -> (yes: bool) =
    yes = lenof left == lenof right
    if yes then
        for at in 0..<lenof left do
            if left[at] <> right[at] then
                yes = false
            end if
        end for
    end if
end same

bits_64: (x: f64) -> (bits: u64) =
    view: ptr u64 = ptr(usize(addr x))
    bits = view.val
end bits_64

from_64: (bits: u64) -> (x: f64) =
    view: ptr f64 = ptr(usize(addr bits))
    x = view.val
end from_64

bits_32: (x: f32) -> (bits: u64) =
    view: ptr u32 = ptr(usize(addr x))
    bits = u64(view.val)
end bits_32

from_32: (bits: u64) -> (x: f32) =
    narrow: u32 = u32(bits & 0xffffffff)
    view: ptr f32 = ptr(usize(addr narrow))
    x = view.val
end from_32

take_64: (record: []u8, index: usize) -> (bits: u64) =
    bits = 0
    for k in 0..<usize(8) do
        bits = bits | (u64(record[index * 8 + k]) << u64(8 * k))
    end for
end take_64

take_32: (record: []u8, index: usize) -> (bits: u64) =
    bits = 0
    for k in 0..<usize(4) do
        bits = bits | (u64(record[index * 4 + k]) << u64(8 * k))
    end for
end take_32

put: (into: []mut u8, at: usize, bits: u64, bytes: usize) -> none =
    for k in 0..<bytes do
        into[at + k] = u8((bits >> u64(8 * k)) & 0xff)
    end for
end put

result_64: (name: []u8, record: []u8) -> (result: u64) =
    result = 0
    if same(name, "sqrt") then
        result = bits_64(math.sqrt(from_64(take_64(record, 0))))
    elsif same(name, "cbrt") then
        result = bits_64(math.cbrt(from_64(take_64(record, 0))))
    elsif same(name, "hypot") then
        result = bits_64(math.hypot(from_64(take_64(record, 0)), from_64(take_64(record, 1))))
    elsif same(name, "fma") then
        result = bits_64(math.fma(from_64(take_64(record, 0)), from_64(take_64(record, 1)), from_64(take_64(record, 2))))
    elsif same(name, "floor") then
        result = bits_64(math.floor(from_64(take_64(record, 0))))
    elsif same(name, "ceil") then
        result = bits_64(math.ceil(from_64(take_64(record, 0))))
    elsif same(name, "trunc") then
        result = bits_64(math.trunc(from_64(take_64(record, 0))))
    elsif same(name, "round") then
        result = bits_64(math.round(from_64(take_64(record, 0))))
    elsif same(name, "round_even") then
        result = bits_64(math.round_even(from_64(take_64(record, 0))))
    elsif same(name, "remainder") then
        result = bits_64(math.remainder(from_64(take_64(record, 0)), from_64(take_64(record, 1))))
    elsif same(name, "remainder_nearest") then
        result = bits_64(math.remainder_nearest(from_64(take_64(record, 0)), from_64(take_64(record, 1))))
    elsif same(name, "exp") then
        result = bits_64(math.exp(from_64(take_64(record, 0))))
    elsif same(name, "exp2") then
        result = bits_64(math.exp2(from_64(take_64(record, 0))))
    elsif same(name, "expm1") then
        result = bits_64(math.expm1(from_64(take_64(record, 0))))
    elsif same(name, "log") then
        result = bits_64(math.log(from_64(take_64(record, 0))))
    elsif same(name, "log2") then
        result = bits_64(math.log2(from_64(take_64(record, 0))))
    elsif same(name, "log10") then
        result = bits_64(math.log10(from_64(take_64(record, 0))))
    elsif same(name, "log1p") then
        result = bits_64(math.log1p(from_64(take_64(record, 0))))
    elsif same(name, "pow") then
        result = bits_64(math.pow(from_64(take_64(record, 0)), from_64(take_64(record, 1))))
    elsif same(name, "sin") then
        result = bits_64(math.sin(from_64(take_64(record, 0))))
    elsif same(name, "cos") then
        result = bits_64(math.cos(from_64(take_64(record, 0))))
    elsif same(name, "tan") then
        result = bits_64(math.tan(from_64(take_64(record, 0))))
    elsif same(name, "asin") then
        result = bits_64(math.asin(from_64(take_64(record, 0))))
    elsif same(name, "acos") then
        result = bits_64(math.acos(from_64(take_64(record, 0))))
    elsif same(name, "atan") then
        result = bits_64(math.atan(from_64(take_64(record, 0))))
    elsif same(name, "atan2") then
        result = bits_64(math.atan2(from_64(take_64(record, 0)), from_64(take_64(record, 1))))
    elsif same(name, "sinh") then
        result = bits_64(math.sinh(from_64(take_64(record, 0))))
    elsif same(name, "cosh") then
        result = bits_64(math.cosh(from_64(take_64(record, 0))))
    elsif same(name, "tanh") then
        result = bits_64(math.tanh(from_64(take_64(record, 0))))
    elsif same(name, "asinh") then
        result = bits_64(math.asinh(from_64(take_64(record, 0))))
    elsif same(name, "acosh") then
        result = bits_64(math.acosh(from_64(take_64(record, 0))))
    elsif same(name, "atanh") then
        result = bits_64(math.atanh(from_64(take_64(record, 0))))
    elsif same(name, "erf") then
        result = bits_64(math.erf(from_64(take_64(record, 0))))
    elsif same(name, "erfc") then
        result = bits_64(math.erfc(from_64(take_64(record, 0))))
    elsif same(name, "gamma") then
        result = bits_64(math.gamma(from_64(take_64(record, 0))))
    elsif same(name, "log_gamma") then
        result = bits_64(math.log_gamma(from_64(take_64(record, 0))))
    end if
end result_64

