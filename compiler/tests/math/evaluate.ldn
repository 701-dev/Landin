        put(into, at, canonical_32(bits_32(math.cosh(from_32(take_32(record, 0))))), 4)
    elsif which == 29 then
        put(into, at, canonical_32(bits_32(math.tanh(from_32(take_32(record, 0))))), 4)
    elsif which == 30 then
        put(into, at, canonical_32(bits_32(math.asinh(from_32(take_32(record, 0))))), 4)
