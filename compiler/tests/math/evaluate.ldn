        put(into, at, canonical_32(bits_32(math.acosh(from_32(take_32(record, 0))))), 4)
    elsif which == 32 then
        put(into, at, canonical_32(bits_32(math.atanh(from_32(take_32(record, 0))))), 4)
    elsif which == 33 then
        put(into, at, canonical_32(bits_32(math.erf(from_32(take_32(record, 0))))), 4)
    elsif which == 34 then
        put(into, at, canonical_32(bits_32(math.erfc(from_32(take_32(record, 0))))), 4)
