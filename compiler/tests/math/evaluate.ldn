--  Generated by scripts/math_oracle.py: run `python3 scripts/math_oracle.py
--  fixtures` to write it again.  The program `measure` and `exhaustive`
--  run: `evaluate FUNCTION WIDTH` reads records of the function's inputs,
--  little-endian at WIDTH bits, from standard input and writes each
--  record back with the result after it, a complex number as its real
--  and imaginary parts;  `evaluate FUNCTION 32 FIRST COUNT` writes the
--  records of COUNT f32 inputs, every bit pattern from FIRST up, without
--  reading any.
import core/complex
import core/io
import core/math
import core/text
import hosted/blocking

same: (left: []u8, right: []u8) -> (yes: bool) =
    yes = lenof left == lenof right
    if yes then
        for at in 0..<lenof left do
            if left[at] <> right[at] then
                yes = false
            end if
        end for
    end if
end same

bits_64: (x: f64) -> (bits: u64) =
    view: ptr u64 = ptr(usize(addr x))
    bits = view.val
end bits_64

from_64: (bits: u64) -> (x: f64) =
    view: ptr f64 = ptr(usize(addr bits))
    x = view.val
end from_64

bits_32: (x: f32) -> (bits: u64) =
    view: ptr u32 = ptr(usize(addr x))
    bits = u64(view.val)
end bits_32

from_32: (bits: u64) -> (x: f32) =
    narrow: u32 = u32(bits & 0xffffffff)
    view: ptr f32 = ptr(usize(addr narrow))
    x = view.val
end from_32

--  A NaN's bits are the target's own [0240], so every NaN is written
--  as one pattern: what `digest` compares between targets is the value.
canonical_64: (bits: u64) -> (result: u64) =
    result = if bits & 0x7fffffffffffffff > 0x7ff0000000000000 then 0x7ff8000000000000
             else bits end if
end canonical_64

canonical_32: (bits: u64) -> (result: u64) =
    result = if bits & 0x7fffffff > 0x7f800000 then 0x7fc00000 else bits end if
end canonical_32

take_64: (record: []u8, index: usize) -> (bits: u64) =
    bits = 0
    for k in 0..<usize(8) do
        bits = bits | (u64(record[index * 8 + k]) << u64(8 * k))
    end for
end take_64

take_32: (record: []u8, index: usize) -> (bits: u64) =
    bits = 0
    for k in 0..<usize(4) do
        bits = bits | (u64(record[index * 4 + k]) << u64(8 * k))
    end for
end take_32

put: (into: []mut u8, at: usize, bits: u64, bytes: usize) -> none =
    for k in 0..<bytes do
        into[at + k] = u8((bits >> u64(8 * k)) & 0xff)
    end for
end put

--  The function's number, its place in the list, so that each input is
--  dispatched by comparing integers rather than names.
number: (name: []u8) -> (which: u32) =
    which = 0
    if same(name, "sqrt") then
        which = 1
    elsif same(name, "cbrt") then
        which = 2
    elsif same(name, "hypot") then
        which = 3
    elsif same(name, "fma") then
