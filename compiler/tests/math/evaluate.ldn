        got: complex.number(f32) = complex.divide(z, w)
        put(into, at, canonical_32(bits_32(got.real)), 4)
        put(into, at + 4, canonical_32(bits_32(got.imaginary)), 4)
    elsif which == 41 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        got: complex.number(f32) = complex.negate(z)
        put(into, at, canonical_32(bits_32(got.real)), 4)
        put(into, at + 4, canonical_32(bits_32(got.imaginary)), 4)
    elsif which == 42 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        got: complex.number(f32) = complex.conjugate(z)
        put(into, at, canonical_32(bits_32(got.real)), 4)
        put(into, at + 4, canonical_32(bits_32(got.imaginary)), 4)
    elsif which == 43 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        got: complex.number(f32) = complex.project(z)
        put(into, at, canonical_32(bits_32(got.real)), 4)
        put(into, at + 4, canonical_32(bits_32(got.imaginary)), 4)
    elsif which == 44 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        put(into, at, canonical_32(bits_32(complex.abs(z))), 4)
    elsif which == 45 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        put(into, at, canonical_32(bits_32(complex.arg(z))), 4)
    elsif which == 46 then
        got: complex.number(f32) = complex.from_polar(from_32(take_32(record, 0)), from_32(take_32(record, 1)))
        put(into, at, canonical_32(bits_32(got.real)), 4)
        put(into, at + 4, canonical_32(bits_32(got.imaginary)), 4)
    elsif which == 47 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        got: complex.number(f32) = complex.exp(z)
        put(into, at, canonical_32(bits_32(got.real)), 4)
        put(into, at + 4, canonical_32(bits_32(got.imaginary)), 4)
    elsif which == 48 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        got: complex.number(f32) = complex.log(z)
        put(into, at, canonical_32(bits_32(got.real)), 4)
        put(into, at + 4, canonical_32(bits_32(got.imaginary)), 4)
    elsif which == 49 then
        z: complex.number(f32) = (real: from_32(take_32(record, 0)), imaginary: from_32(take_32(record, 1)))
        w: complex.number(f32) = (real: from_32(take_32(record, 2)), imaginary: from_32(take_32(record, 3)))
        got: complex.number(f32) = complex.pow(z, w)
