--  D2180: the record of an environment variable was `io.variable` and is
--  `text.os_variable` (D2008, D2033); `io.variable` now names the routine
--  that lends one.  Written as a type it is refused naming the record, and
--  the fix writes it, importing `core/text` once.
import core/io
import core/text

name_length: (item: text.os_variable) -> (n: usize) =
    n = 0
end name_length

both: (left: text.os_variable, right: text.os_variable) -> (same: bool) =
    same = true
end both

public main: () -> (code: i32) =
    code = 0
end main
