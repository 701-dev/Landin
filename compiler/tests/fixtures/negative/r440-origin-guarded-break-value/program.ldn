absent: atom
maybe_pointer: type = absent | ptr u32

bad: (cell: ptr u32, choose: bool) -> (result: maybe_pointer from cell) =
    local: u32 = 42
    mut candidate: maybe_pointer = addr local
    result = cell
    mut value: i32
    loop do
        if choose then
            value = begin
                candidate = absent
                0
            end
            break
        end if
        result = candidate
        return
    end loop
    _ = value
end bad
