import core/iter

bag: type = struct
    values: []mut i32
end bag
first: (s: ptr bag) -> (c: usize) = 0 end first
at_end: (s: ptr bag, c: usize) -> (yes: bool) =
    view := s.val.values
    yes = c >= lenof view
end at_end
item: (s: ptr bag, c: usize) -> (v: ptr i32 from s) =
    v = addr s.val.values[c]
end item
next: (s: ptr bag, c: usize) -> (c2: usize) = c + 1 end next
bag is iter.iterable (cur: usize, item_type: ptr i32,
                      first: first, at_end: at_end, item: item, next: next)
