import core/iter

bag: type = struct value: u32 end bag
first: (s: ptr bag) -> (c: usize) = 0 end first
at_end: (s: ptr bag, c: usize) -> (yes: bool) = c == 1 end at_end
bag_item: (s: ptr bag, c: usize) -> (v: u16) = u16(s.val.value) end bag_item
next: (s: ptr bag, c: usize) -> (c2: usize) = c + 1 end next
bag is iter.iterable (cur: usize, item_type: u32, first: first,
                 at_end: at_end, item: bag_item, next: next)
read: (source: bag) -> (result: u32) =
    result = 0
    for element in source do
        result = element
    end for
end read
