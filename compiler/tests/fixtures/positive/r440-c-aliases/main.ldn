import platform/c

--  The imported module itself asserts the selected target's LP64 facts.
--  These assertions use only the established compiler directives.
compiler.assert(compiler.arch == x86_64)
compiler.assert(compiler.word_size == 64)
compiler.assert(compiler.byte_order == little)

signed: c.c_int = -42
unsigned: c.c_uint = 42
wide: c.c_long = c.c_long(signed)
narrow: c.c_int = c.c_int(wide)
ordinary: i32 = narrow
single: c.c_float = c.c_float(3)
double: c.c_double = c.c_double(single)
truth: c.c_bool = c.c_bool(1)
ordinary_truth: bool = truth
