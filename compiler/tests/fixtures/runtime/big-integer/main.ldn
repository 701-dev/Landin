--  A signed number from `table` at `at` into `into`, `at` moved past it.
take: (provider: type is mem.allocator, table: []u32, inout at: usize,
       inout into: big.integer, memory: provider)
      -> none ! mem.out_of_memory =
    header: u32 = table[at]
    count: usize = usize(header & 0x7fffffff)
    inc at
    try big.set_limbs(into, memory, table[at..<at + count], header >> 31 == 1)
    at = at + count
end take

--  Whether `value` is the signed number `want`.
equals: (value: big.integer, want: big.integer) -> (yes: bool) =
    yes = big.compare(value, want) == cmp.equal
          and same(big.limbs_of(value), big.limbs_of(want))
end equals

--  The digest of `value`'s text in base 10 or 16, and whether reading it
--  back gives `value`.
text_of: (provider: type is mem.allocator, value: big.integer,
          memory: provider, decimal: bool)
         -> (hash: u32, back: bool) ! mem.out_of_memory | text.invalid_number =
    mut out := text.over(buffer[0..<512])
    if decimal then
        try big.append_decimal(out, memory, value)
    else
        try big.append_hex(out, memory, value)
    end if
    hash = digest_text(text.used(out))
    mut read := big.new()
    if decimal then
        try big.parse_decimal(read, memory, text.used(out))
    else
        try big.parse_hex(read, memory, text.used(out))
    end if
    back = equals(read, value)
end text_of

--  Whether one record, from `at`, agrees.
agrees: (provider: type is mem.allocator, inout at: usize, memory: provider)
        -> (yes: bool) ! mem.out_of_memory | text.invalid_number =
    yes = false
    op: u32 = cases[at]
    inc at
    mut a := big.new()
    mut b := big.new()
    mut c := big.new()
    try take(cases, at, a, memory)
    try take(cases, at, b, memory)
    try take(cases, at, c, memory)
    p: u64 = u64(cases[at]) | (u64(cases[at + 1]) << 32)
    at = at + 2
    mut want := big.new()
    mut also := big.new()
    try take(cases, at, want, memory)
    try take(cases, at, also, memory)
    word: u32 = cases[at]
    inc at
    mut r := big.new()
    mut s := big.new()
    mut w: u32 = 0
    if op >= 0x100 then
        --  The result written over the first operand: `r` is a copy of
        --  `a` and is passed as both.
        try big.set(r, memory, a)
        kind: u32 = op - 0x100
        if kind == 1 then
            try big.add(r, memory, r, b)
        elsif kind == 2 then
            try big.subtract(r, memory, r, b)
        elsif kind == 3 then
            try big.multiply(r, memory, r, b)
        elsif kind == 4 then
            try big.divide_truncating(r, s, memory, r, b)
        elsif kind == 5 then
            try big.divide_floor(r, s, memory, r, b)
        elsif kind == 8 then
            try big.gcd(r, memory, r, b)
        elsif kind == 10 then
            try big.power_modulo(r, memory, r, b, c)
        elsif kind == 11 then
            try big.and_bits(r, memory, r, b)
        elsif kind == 13 then
            try big.xor_bits(r, memory, r, b)
        elsif kind == 15 then
            try big.shift_left(r, memory, r, usize(p))
        elsif kind == 16 then
            try big.shift_right(r, memory, r, usize(p))
        end if
    elsif op == 1 then
        try big.add(r, memory, a, b)
    elsif op == 2 then
        try big.subtract(r, memory, a, b)
    elsif op == 3 then
        try big.multiply(r, memory, a, b)
    elsif op == 4 then
        try big.divide_truncating(r, s, memory, a, b)
    elsif op == 5 then
        try big.divide_floor(r, s, memory, a, b)
    elsif op == 6 then
        try big.power(r, memory, a, p)
    elsif op == 7 then
        try big.root(r, memory, a, u32(p))
    elsif op == 8 then
        try big.gcd(r, memory, a, b)
    elsif op == 9 then
        big.inverse_modulo(r, memory, a, b) else (problem)
            match problem
                big.not_invertible: w = 1
                mem.out_of_memory: fail mem.out_of_memory
            end match
        end
    elsif op == 10 then
        try big.power_modulo(r, memory, a, b, c)
    elsif op == 11 then
        try big.and_bits(r, memory, a, b)
    elsif op == 12 then
        try big.or_bits(r, memory, a, b)
    elsif op == 13 then
        try big.xor_bits(r, memory, a, b)
    elsif op == 14 then
        try big.complement(r, memory, a)
    elsif op == 15 then
        try big.shift_left(r, memory, a, usize(p))
    elsif op == 16 then
        try big.shift_right(r, memory, a, usize(p))
    elsif op == 17 then
        w = if big.bit(a, usize(p)) then 1 else 0 end if
    elsif op == 18 then
        w = u32(big.bit_length(a))
    elsif op == 19 then
        order := big.compare(a, b)
        w = if order == cmp.less then 0 elsif order == cmp.equal then 1 else 2 end if
    elsif op == 20 then
        w = u32(big.sign(a) + 1)
    elsif op == 21 then
        try big.set(r, memory, a)
        big.negate(r)
    elsif op == 22 then
        try big.set(r, memory, a)
        big.absolute(r)
    elsif op == 23 then
        value: i64 = big.to_i64(a) else (problem)
            _ = problem
            yes = word == 1
            return
        end
        try big.set_i64(r, memory, value)
        bits: u64 = if value < 0 then 0 -% u64(-(value + 1)) -% 1
                    else u64(value) end if
        yes = word == 0 and bits == p and equals(r, a)
        return
    elsif op == 24 then
        value: u64 = big.to_u64(a) else (problem)
            _ = problem
            yes = word == 1
            return
        end
        try big.set_u64(r, memory, value)
        yes = word == 0 and value == p and equals(r, a)
        return
    elsif op == 25 then
        got: f64 = big.to_f64(a)
        view: ptr u64 = ptr(usize(addr got))
        yes = view.val == p
        return
    elsif op == 26 then
        got: f32 = big.to_f32(a)
        view: ptr u32 = ptr(usize(addr got))
        yes = u64(view.val) == p
        return
    elsif op == 27 then
        bits: u64 = p
        value: ptr f64 = ptr(usize(addr bits))
        big.set_f64(r, memory, value.val) else (problem)
            match problem
                big.not_finite: w = 1
                mem.out_of_memory: fail mem.out_of_memory
            end match
        end
    elsif op == 28 then
        bits: u32 = u32(p)
        value: ptr f32 = ptr(usize(addr bits))
        big.set_f32(r, memory, value.val) else (problem)
            match problem
                big.not_finite: w = 1
                mem.out_of_memory: fail mem.out_of_memory
            end match
        end
    elsif op == 29 or op == 30 then
        (hash: hash, back: back) := try text_of(a, memory, op == 29)
        yes = hash == word and back
        return
    end if
    yes = w == word and equals(r, want) and equals(s, also)
end agrees

--  Whether every record of `cases` agrees, each in an empty arena.
run_cases: () -> (ok: bool) =
    ok = true
    mut at: usize = 0
    while at < lenof cases do
        mut space: arena.space = zeroed
        memory := arena.over_unchecked(space, addr backing[0], 7168)
        agreed := agrees(at, memory) else false
        if not agreed then
            ok = false
            return
        end if
    end while
end run_cases

--  `count` limbs drawn from `source` made the integer `into`.
draw: (provider: type is mem.allocator, inout source: random.generator,
       inout into: big.integer, memory: provider, count: usize)
      -> none ! mem.out_of_memory =
    for slot in drawn[0..<count] do
        slot = random.next_u32(source)
    end for
    try big.set_limbs(into, memory, drawn[0..<count], false)
end draw

--  Whether one record of `seeded`, from `at`, agrees.
seeded_agrees: (provider: type is mem.allocator, at: usize, memory: provider)
               -> (yes: bool) ! mem.out_of_memory =
    op: u32 = seeded[at]
    mut source := random.new(u64(seeded[at + 1]))
    first: u64 = u64(seeded[at + 4]) | (u64(seeded[at + 5]) << 32)
    second: u64 = u64(seeded[at + 6]) | (u64(seeded[at + 7]) << 32)
    mut a := big.new()
    mut b := big.new()
    mut r := big.new()
    mut s := big.new()
    try draw(source, a, memory, usize(seeded[at + 2]))
    count: usize = usize(seeded[at + 3])
    try draw(source, b, memory, count)
    if op == 1 then
        try big.multiply(r, memory, a, b)
        yes = digest(big.limbs_of(r)) == first
    else
        if drawn[count - 1] == 0 then
            drawn[count - 1] = 1
            try big.set_limbs(b, memory, drawn[0..<count], false)
        end if
        try big.divide_floor(r, s, memory, a, b)
        yes = digest(big.limbs_of(r)) == first and digest(big.limbs_of(s)) == second
    end if
end seeded_agrees

--  Whether every record of `seeded` agrees.
run_seeded: () -> (ok: bool) =
    ok = true
    mut at: usize = 0
    while at < lenof seeded do
        mut space: arena.space = zeroed
        memory := arena.over_unchecked(space, addr backing[0], 7168)
        agreed := seeded_agrees(at, memory) else false
        if not agreed then ok = false end if
        at = at + 8
    end while
end run_seeded

--  Text that does not spell an integer is refused, the destination left
--  as it was.
refused: (provider: type is mem.allocator, inout into: big.integer,
          memory: provider, source: []u8, decimal: bool) -> (yes: bool) =
    yes = false
    mut problem_seen: bool = false
    if decimal then
        big.parse_decimal(into, memory, source) else (problem)
            problem_seen = problem == text.invalid_number
        end
    else
        big.parse_hex(into, memory, source) else (problem)
            problem_seen = problem == text.invalid_number
        end
    end if
    kept: i64 = (big.to_i64(into) else 0)
    yes = problem_seen and kept == 7
end refused

refusals: () -> (ok: bool) =
    ok = false
    mut space: arena.space = zeroed
    memory := arena.over_unchecked(space, addr backing[0], 7168)
    mut value := big.new()
    big.set_i64(value, memory, 7) else (problem)
        _ = problem
        return
    end
    ok = refused(value, memory, "", true) and refused(value, memory, "-", true)
         and refused(value, memory, "+1", true) and refused(value, memory, " 1", true)
         and refused(value, memory, "12x", true) and refused(value, memory, "1-", true)
         and refused(value, memory, "0x10", false) and refused(value, memory, "g", false)
         and refused(value, memory, "--1", false)
end refusals

public main: () -> (code: i32) =
    code = 42
    if not run_cases() then
        code = 1
    elsif not run_seeded() then
        code = 2
    elsif not refusals() then
        code = 3
    end if
end main
