seeded: [64]u32 = [
    0x00000001, 0x00000bb8, 0x000000a0, 0x00000097, 0x4f717561, 0x39d3a5c9,
    0x00000000, 0x00000000, 0x00000002, 0x00000bb8, 0x000000a0, 0x00000097,
    0xfeb20016, 0xc2530ea3, 0x7968fe9d, 0x44405c3c, 0x00000001, 0x00000bb9,
    0x00000097, 0x000000a0, 0x0298dc2e, 0xd79e827a, 0x00000000, 0x00000000,
    0x00000002, 0x00000bb9, 0x00000097, 0x000000a0, 0x84222325, 0xcbf29ce4,
    0x91ac0c99, 0xbedc4192, 0x00000001, 0x00000bba, 0x00000060, 0x00000032,
    0xd15b1493, 0x0db7fc86, 0x00000000, 0x00000000, 0x00000002, 0x00000bba,
    0x00000060, 0x00000032, 0x587f29f9, 0x630b8c0d, 0x1b8fa4a7, 0xad8cebcd,
    0x00000001, 0x00000bbb, 0x0000003c, 0x0000003c, 0x01782620, 0xae1acf9f,
    0x00000000, 0x00000000, 0x00000002, 0x00000bbb, 0x0000003c, 0x0000003c,
    0x8601b62c, 0xaf63bc4c, 0xa6a2203f, 0x5e06e6c8]

--  A signed number from `table` at `at` into `into`, `at` moved past it.
take: (provider: type is mem.allocator, table: []u32, inout at: usize,
       inout into: big.integer, memory: provider)
      -> none ! mem.out_of_memory =
    header: u32 = table[at]
    count: usize = usize(header & 0x7fffffff)
    inc at
    try big.set_limbs(into, memory, table[at..<at + count], header >> 31 == 1)
    at = at + count
end take

--  Whether `value` is the signed number `want`.
equals: (value: big.integer, want: big.integer) -> (yes: bool) =
    yes = big.compare(value, want) == cmp.equal
          and same(big.limbs_of(value), big.limbs_of(want))
end equals

--  Whether one record, from `at`, agrees.
agrees: (provider: type is mem.allocator, inout at: usize, memory: provider)
        -> (yes: bool) ! mem.out_of_memory =
    yes = false
    op: u32 = cases[at]
    inc at
    mut a := big.new()
    mut b := big.new()
    mut c := big.new()
    try take(cases, at, a, memory)
    try take(cases, at, b, memory)
    try take(cases, at, c, memory)
    p: u64 = u64(cases[at]) | (u64(cases[at + 1]) << 32)
    at = at + 2
    mut want := big.new()
    mut also := big.new()
    try take(cases, at, want, memory)
    try take(cases, at, also, memory)
    word: u32 = cases[at]
    inc at
    mut r := big.new()
    mut s := big.new()
    mut w: u32 = 0
    if op == 0x1 then
        try big.add(r, memory, a, b)
    elsif op == 0x2 then
        try big.subtract(r, memory, a, b)
    elsif op == 0x3 then
        try big.multiply(r, memory, a, b)
    elsif op == 0x4 then
        try big.divide_truncating(r, s, memory, a, b)
    elsif op == 0x5 then
        try big.divide_floor(r, s, memory, a, b)
    elsif op == 0x13 then
        order := big.compare(a, b)
        w = if order == cmp.less then 0 elsif order == cmp.equal then 1 else 2 end if
    elsif op == 0x14 then
        w = u32(big.sign(a) + 1)
    elsif op == 0x15 then
        try big.set(r, memory, a)
        big.negate(r)
    elsif op == 0x16 then
        try big.set(r, memory, a)
        big.absolute(r)
    elsif op == 0x101 then
        try big.set(r, memory, a)
        try big.add(r, memory, r, b)
    elsif op == 0x102 then
        try big.set(r, memory, a)
        try big.subtract(r, memory, r, b)
    elsif op == 0x103 then
        try big.set(r, memory, a)
        try big.multiply(r, memory, r, b)
    elsif op == 0x104 then
        try big.set(r, memory, a)
        try big.divide_truncating(r, s, memory, r, b)
    elsif op == 0x105 then
        try big.set(r, memory, a)
        try big.divide_floor(r, s, memory, r, b)
    end if
    yes = w == word and equals(r, want) and equals(s, also)
end agrees

--  Whether every record of `cases` agrees, each in an empty arena.
run_cases: () -> (ok: bool) =
    ok = true
    mut at: usize = 0
    while at < lenof cases do
        mut space: arena.space = zeroed
        memory := arena.over_unchecked(space, addr backing[0], 7168)
        agreed := agrees(at, memory) else false
        if not agreed then
            ok = false
            return
        end if
    end while
end run_cases

--  `count` limbs drawn from `source` made the integer `into`.
draw: (provider: type is mem.allocator, inout source: random.generator,
       inout into: big.integer, memory: provider, count: usize)
      -> none ! mem.out_of_memory =
    for slot in drawn[0..<count] do
        slot = random.next_u32(source)
    end for
    try big.set_limbs(into, memory, drawn[0..<count], false)
end draw

--  Whether one record of `seeded`, from `at`, agrees.
seeded_agrees: (provider: type is mem.allocator, at: usize, memory: provider)
               -> (yes: bool) ! mem.out_of_memory =
    op: u32 = seeded[at]
    mut source := random.new(u64(seeded[at + 1]))
    first: u64 = u64(seeded[at + 4]) | (u64(seeded[at + 5]) << 32)
    second: u64 = u64(seeded[at + 6]) | (u64(seeded[at + 7]) << 32)
    mut a := big.new()
    mut b := big.new()
    mut r := big.new()
    mut s := big.new()
    try draw(source, a, memory, usize(seeded[at + 2]))
    count: usize = usize(seeded[at + 3])
    try draw(source, b, memory, count)
    if op == 1 then
        try big.multiply(r, memory, a, b)
        yes = digest(big.limbs_of(r)) == first
    else
        if drawn[count - 1] == 0 then
            drawn[count - 1] = 1
            try big.set_limbs(b, memory, drawn[0..<count], false)
        end if
        try big.divide_floor(r, s, memory, a, b)
        yes = digest(big.limbs_of(r)) == first and digest(big.limbs_of(s)) == second
    end if
end seeded_agrees

--  Whether every record of `seeded` agrees.
run_seeded: () -> (ok: bool) =
    ok = true
    mut at: usize = 0
    while at < lenof seeded do
        mut space: arena.space = zeroed
        memory := arena.over_unchecked(space, addr backing[0], 7168)
        agreed := seeded_agrees(at, memory) else false
        if not agreed then ok = false end if
        at = at + 8
    end while
end run_seeded

public main: () -> (code: i32) =
    code = 42
    if not run_cases() then
        code = 1
    elsif not run_seeded() then
        code = 2
    end if
end main
