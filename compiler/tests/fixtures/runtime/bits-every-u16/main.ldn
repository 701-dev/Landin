--  core/bits's operations at u16 against references written here bit by
--  bit or by arithmetic, sharing no code with core/bits: every input of
--  each one-operand operation, every rotation count up to twice the
--  width, and every first operand against eighteen second ones: zero,
--  each power of two and the largest value.  The program exits 42 when
--  all agree, and otherwise the number of the first operation that did
--  not.
import core/bits

width: u32 = 16
top: u32 = 65535

--  Bit `index` of `value`.
bit: (value: u32, index: u32) -> (set: bool) =
    set = (value >> index) & 1 == 1
end bit

ones_by_bits: (value: u32) -> (count: u32) =
    count = 0
    for index in u32(0)..<width do
        if bit(value, index) then inc count end if
    end for
end ones_by_bits

leading_by_bits: (value: u32) -> (count: u32) =
    count = 0
    mut index: u32 = width
    while index > 0 do
        dec index
        return when bit(value, index)
        inc count
    end while
end leading_by_bits

trailing_by_bits: (value: u32) -> (count: u32) =
    count = 0
    for index in u32(0)..<width do
        return when bit(value, index)
        inc count
    end for
end trailing_by_bits

--  One place up, the top bit coming in at the bottom, by arithmetic.
up_one: (value: u32) -> (result: u32) =
    result = (value * 2) % (top + 1) + value / ((top + 1) / 2)
end up_one

--  One place down, the bottom bit coming in at the top.
down_one: (value: u32) -> (result: u32) =
    result = value / 2 + (value % 2) * ((top + 1) / 2)
end down_one

mirrored_by_bits: (value: u32) -> (result: u32) =
    result = 0
    for index in u32(0)..<width do
        if bit(value, index) then
            result = result | (u32(1) << (width - 1 - index))
        end if
    end for
end mirrored_by_bits

swapped_by_bytes: (value: u32) -> (result: u32) =
    result = 0
    for index in u32(0)..<width / 8 do
        byte: u32 = (value >> (8 * index)) & 0xff
        result = result | (byte << (width - 8 - 8 * index))
    end for
end swapped_by_bytes

--  Every operation on one operand, `x`, against the references.
single: (x: u32) -> (failed: i32) =
    value: u16 = u16(x)
    failed = 1
    return when bits.ones(value) <> ones_by_bits(x)
    failed = 2
    return when bits.leading_zeros(value) <> leading_by_bits(x)
    failed = 3
    return when bits.trailing_zeros(value) <> trailing_by_bits(x)
    failed = 4
    return when bits.bit_length(value) <> width - leading_by_bits(x)
    failed = 5
    return when u32(bits.reverse_bits(value)) <> mirrored_by_bits(x)
    failed = 6
    return when u32(bits.reverse_bytes(value)) <> swapped_by_bytes(x)
    --  Each count from the one before it, a place at a time.
    mut left: u32 = x
    mut right: u32 = x
    for count in u32(0)..<2 * width + 1 do
        failed = 7
        return when u32(bits.rotate_left(value, count)) <> left
        failed = 8
        return when u32(bits.rotate_right(value, count)) <> right
        left = up_one(left)
        right = down_one(right)
    end for
    failed = 0
end single

--  Every operation on two operands, `x` and `y`, against the references.
pair: (x: u32, y: u32) -> (failed: i32) =
    left: u16 = u16(x)
    right: u16 = u16(y)
    product: u64 = u64(x) * u64(y)
    (high: high, low: low) := bits.multiply_wide(left, right)
    failed = 9
    return when u64(high) <> product >> u64(width)
      or u64(low) <> product & u64(top)
    for carry in u32(0)..<2 do
        total: u32 = x + y + carry
        (sum: sum, carry_out: carry_out) := bits.add_carry(left, right, carry == 1)
        failed = 10
        return when u32(sum) <> total & top or carry_out <> (total > top)
        below: bool = x < y + carry
        expected: u32 = if below then x + (top + 1) - y - carry
                        else x - y - carry end if
        (difference: difference, borrow_out: borrow_out) :=
            bits.subtract_borrow(left, right, carry == 1)
        failed = 11
        return when u32(difference) <> expected or borrow_out <> below
    end for
    failed = 0
end pair

--  The second operands: zero, every power of two and the largest value.
second: (index: u32) -> (y: u32) =
    y = if index == 0 then 0 elsif index == 17 then top
        else u32(1) << (index - 1) end if
end second

public main: () -> (code: i32) =
    for x in u32(0)..<top + 1 do
        code = single(x)
        return when code <> 0
        for index in u32(0)..<18 do
            code = pair(x, second(index))
            return when code <> 0
        end for
    end for
    code = 42
end main
