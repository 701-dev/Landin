--  core/bits's reader and writer: every width written and read back in
--  both byte orders, the bytes each order lays down, short input and a
--  full buffer refused without moving, and LEB128 varints: known
--  encodings, round trips at every length, padding accepted, and
--  truncated, overlong and overflowing ones refused.  The program exits
--  42 when every check holds, and otherwise the number of the first that
--  did not.
import core/bits
import core/mem

--  Whether the first bytes of `bytes` are `expected`.
same: (bytes: []u8, expected: []u8) -> (yes: bool) =
    yes = lenof bytes == lenof expected
    return when not yes
    for byte, index in bytes do
        if byte <> expected[index] then
            yes = false
            return
        end if
    end for
end same

--  Every width in both orders, written then read back.
round_trips: (order: bits.byte_order) -> (failed: i32) =
    mut buffer: [30]u8 = zeroed
    mut out := bits.writer_over(buffer[0..<30])
    failed = 1
    bits.write_u8(out, 0xfe) else begin return end
    bits.write_i8(out, -2) else begin return end
    bits.write_u16(out, 0xbeef, order) else begin return end
    bits.write_i16(out, -32768, order) else begin return end
    bits.write_u32(out, 0xdeadbeef, order) else begin return end
    bits.write_i32(out, -123456789, order) else begin return end
    bits.write_u64(out, 0x0123456789abcdef, order) else begin return end
    bits.write_i64(out, -9223372036854775807 - 1, order) else begin return end
    failed = 2
    return when bits.written(out) <> 30
    mut source := bits.reader_over(bits.used(out))
    failed = 3
    return when (bits.read_u8(source) else 0) <> 0xfe
    return when (bits.read_i8(source) else 0) <> -2
    return when (bits.read_u16(source, order) else 0) <> 0xbeef
    return when (bits.read_i16(source, order) else 0) <> -32768
    return when (bits.read_u32(source, order) else 0) <> 0xdeadbeef
    return when (bits.read_i32(source, order) else 0) <> -123456789
    return when (bits.read_u64(source, order) else 0) <> 0x0123456789abcdef
    return when (bits.read_i64(source, order) else 0)
      <> -9223372036854775807 - 1
    failed = 4
    return when bits.remaining(source) <> 0
    failed = 0
end round_trips

--  The bytes each order lays down, and the signed reading of each.
layouts: () -> (failed: i32) =
    mut buffer: [8]u8 = zeroed
    mut out := bits.writer_over(buffer[0..<8])
    failed = 5
    bits.write_u32(out, 0x01020304, bits.little) else begin return end
    bits.write_u32(out, 0x01020304, bits.big) else begin return end
    return when not same(bits.used(out), [4, 3, 2, 1, 1, 2, 3, 4])
    bytes: [8]u8 = [0xff, 0xff, 0x80, 0x00, 0x00, 0x00, 0x00, 0x80]
    mut source := bits.reader_over(bytes[0..<8])
    failed = 6
    return when (bits.read_i16(source, bits.little) else 0) <> -1
    return when (bits.read_i16(source, bits.big) else 0) <> -32768
    return when (bits.read_i32(source, bits.little) else 0)
      <> -2147483647 - 1
    failed = 7
    mut again := bits.reader_over(bytes[0..<8])
    return when (bits.read_u64(again, bits.big) else 0) <> 0xffff800000000080
    failed = 8
    mut whole := bits.reader_over(bytes[0..<8])
    bits.skip(whole, 2) else begin return end
    return when bits.position(whole) <> 2
    taken: []u8 = bits.take(whole, 2) else begin return end
    return when not same(taken, [0x80, 0x00])
    failed = 0
end layouts

--  A read with too few bytes and a write with too little room fail with
--  the library's atoms and move nothing.
refusals: () -> (failed: i32) =
    bytes: [7]u8 = [1, 2, 3, 4, 5, 6, 7]
    failed = 9
    for length in usize(0)..<8 do
        mut source := bits.reader_over(bytes[0..<length])
        if length < 2 then
            _ = bits.read_u16(source, bits.big) else (problem)
                return when problem <> mem.out_of_bounds
                0
            end
            return when bits.position(source) <> 0
        end if
        if length < 4 then
            _ = bits.read_i32(source, bits.little) else (problem)
                return when problem <> mem.out_of_bounds
                0
            end
            return when bits.position(source) <> 0
        end if
        _ = bits.read_u64(source, bits.little) else (problem)
            return when problem <> mem.out_of_bounds
            0
        end
        return when bits.position(source) <> 0
        bits.skip(source, length + 1) else (problem)
            return when problem <> mem.out_of_bounds
        end
        return when bits.position(source) <> 0
        _ = bits.take(source, length + 1) else (problem)
            return when problem <> mem.out_of_bounds
            bytes[0..<0]
        end
        return when bits.position(source) <> 0
    end for
    failed = 10
    mut buffer: [7]u8 = zeroed
    mut out := bits.writer_over(buffer[0..<7])
    bits.write_u32(out, 1, bits.big) else begin return end
    bits.write_u32(out, 2, bits.big) else (problem)
        return when problem <> mem.out_of_memory
    end
    return when bits.written(out) <> 4
    bits.write_uleb128(out, 0xffffffff) else (problem)
        return when problem <> mem.out_of_memory
    end
    return when bits.written(out) <> 4
    bits.write_sleb128(out, -0x10000000) else (problem)
        return when problem <> mem.out_of_memory
    end
    return when bits.written(out) <> 4 or buffer[4] <> 0
    failed = 0
end refusals

--  The unsigned encoding of `value` is `expected`, and reads back.
unsigned_known: (value: u64, expected: []u8) -> (yes: bool) =
    mut buffer: [10]u8 = zeroed
    mut out := bits.writer_over(buffer[0..<10])
    yes = false
    bits.write_uleb128(out, value) else begin return end
    return when not same(bits.used(out), expected)
    mut source := bits.reader_over(bits.used(out))
    yes = (bits.read_uleb128(source) else value +% 1) == value
          and bits.remaining(source) == 0
end unsigned_known

--  The signed encoding of `value` is `expected`, and reads back.
signed_known: (value: i64, expected: []u8) -> (yes: bool) =
    mut buffer: [10]u8 = zeroed
    mut out := bits.writer_over(buffer[0..<10])
    yes = false
    bits.write_sleb128(out, value) else begin return end
    return when not same(bits.used(out), expected)
    mut source := bits.reader_over(bits.used(out))
    read: i64 = bits.read_sleb128(source) else (if value == 0 then 1 else 0 end if)
    yes = read == value and bits.remaining(source) == 0
end signed_known

--  Reading `bytes` as an unsigned varint fails `wanted`, and moves nothing.
unsigned_refused: (bytes: []u8, wanted: bits.invalid_varint | mem.out_of_bounds)
                  -> (yes: bool) =
    mut source := bits.reader_over(bytes)
    yes = false
    _ = bits.read_uleb128(source) else (problem)
        yes = problem == wanted and bits.position(source) == 0
        0
    end
end unsigned_refused

signed_refused: (bytes: []u8, wanted: bits.invalid_varint | mem.out_of_bounds)
                -> (yes: bool) =
    mut source := bits.reader_over(bytes)
    yes = false
    _ = bits.read_sleb128(source) else (problem)
        yes = problem == wanted and bits.position(source) == 0
        0
    end
end signed_refused

varints: () -> (failed: i32) =
    failed = 11
    return when not unsigned_known(0, [0x00])
    return when not unsigned_known(127, [0x7f])
    return when not unsigned_known(128, [0x80, 0x01])
    return when not unsigned_known(624485, [0xe5, 0x8e, 0x26])
    return when not unsigned_known(0xffffffffffffffff,
                                   [0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
                                    0xff, 0xff, 0x01])
    failed = 12
    return when not signed_known(0, [0x00])
    return when not signed_known(-1, [0x7f])
    return when not signed_known(63, [0x3f])
    return when not signed_known(64, [0xc0, 0x00])
    return when not signed_known(-64, [0x40])
    return when not signed_known(-65, [0xbf, 0x7f])
    return when not signed_known(-123456, [0xc0, 0xbb, 0x78])
    return when not signed_known(9223372036854775807,
                                 [0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
                                  0xff, 0xff, 0x00])
    return when not signed_known(-9223372036854775807 - 1,
                                 [0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
                                  0x80, 0x80, 0x7f])
    --  Every length from one byte to ten, in both encodings.
    failed = 13
    mut buffer: [700]u8 = zeroed
    mut out := bits.writer_over(buffer[0..<700])
    for shift in u64(0)..<64 do
        bits.write_uleb128(out, u64(1) << shift) else begin return end
        bits.write_sleb128(out, 0 - i64(u64(1) << (shift % 63))) else begin return end
    end for
    mut source := bits.reader_over(bits.used(out))
    for shift in u64(0)..<64 do
        return when (bits.read_uleb128(source) else 0) <> u64(1) << shift
        return when (bits.read_sleb128(source) else 0)
          <> 0 - i64(u64(1) << (shift % 63))
    end for
    return when bits.remaining(source) <> 0
    --  Padding to the ten bytes 64 bits take is accepted, as linkers
    --  write it.
    failed = 14
    padded: [4]u8 = [0x85, 0x80, 0x80, 0x00]
    mut pad := bits.reader_over(padded[0..<4])
    return when (bits.read_uleb128(pad) else 0) <> 5
    mut negative_pad := bits.reader_over([0xff, 0xff, 0x7f])
    return when (bits.read_sleb128(negative_pad) else 0) <> -1
    failed = 15
    return when not unsigned_refused([0x80, 0x80], mem.out_of_bounds)
    return when not unsigned_refused([], mem.out_of_bounds)
    return when not signed_refused([0xff], mem.out_of_bounds)
    --  An eleventh byte, and a tenth byte with bits past the 64th.
    return when not unsigned_refused([0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
                                      0x80, 0x80, 0x80, 0x80, 0x00],
                                     bits.invalid_varint)
    return when not unsigned_refused([0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
                                      0xff, 0xff, 0xff, 0x02],
                                     bits.invalid_varint)
    return when not signed_refused([0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
                                    0x80, 0x80, 0x80, 0x80, 0x00],
                                   bits.invalid_varint)
    return when not signed_refused([0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
                                    0xff, 0xff, 0xff, 0x01],
                                   bits.invalid_varint)
    return when not signed_refused([0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
                                    0x80, 0x80, 0x80, 0x7e],
                                   bits.invalid_varint)
    failed = 0
end varints

public main: () -> (code: i32) =
    code = round_trips(bits.little)
    return when code <> 0
    code = round_trips(bits.big)
    return when code <> 0
    code = layouts()
    return when code <> 0
    code = refusals()
    return when code <> 0
    code = varints()
    return when code <> 0
    code = 42
end main
