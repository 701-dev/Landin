--  core/bits's reads and writes over a caller's bytes: every width
--  written and read back in both byte orders, the bytes each order lays
--  down, short input and a full buffer refused without moving, a view
--  taken that lasts while reading goes on.  LEB128 is
--  runtime/bits-varints, so that each fits a 32 KiB image unoptimized.
--  The program exits 42 when every check holds, and otherwise the number
--  of the first that did not.
import core/bits
import core/mem

--  Whether `bytes` are `expected`.
same: (bytes: []u8, expected: []u8) -> (yes: bool) =
    yes = lenof bytes == lenof expected
    return when not yes
    for byte, index in bytes do
        if byte <> expected[index] then
            yes = false
            return
        end if
    end for
end same

--  Every width in `order`, written then read back.
round_trips: (order: bits.byte_order) -> (failed: i32) =
    mut buffer: [30]u8 = zeroed
    mut at: usize = 0
    failed = 1
    bits.write_u8(buffer, at, 0xfe) else begin return end
    bits.write_i8(buffer, at, -2) else begin return end
    bits.write_u16(buffer, at, 0xbeef, order) else begin return end
    bits.write_i16(buffer, at, -32768, order) else begin return end
    bits.write_u32(buffer, at, 0xdeadbeef, order) else begin return end
    bits.write_i32(buffer, at, -123456789, order) else begin return end
    bits.write_u64(buffer, at, 0x0123456789abcdef, order)
        else begin return end
    bits.write_i64(buffer, at, -9223372036854775807 - 1, order)
        else begin return end
    failed = 2
    return when at <> 30
    bytes: []u8 = buffer[0..<30]
    mut next: usize = 0
    failed = 3
    return when (bits.read_u8(bytes, next) else 0) <> 0xfe
    return when (bits.read_i8(bytes, next) else 0) <> -2
    return when (bits.read_u16(bytes, next, order) else 0) <> 0xbeef
    return when (bits.read_i16(bytes, next, order) else 0) <> -32768
    return when (bits.read_u32(bytes, next, order) else 0) <> 0xdeadbeef
    return when (bits.read_i32(bytes, next, order) else 0) <> -123456789
    return when (bits.read_u64(bytes, next, order) else 0)
      <> 0x0123456789abcdef
    return when (bits.read_i64(bytes, next, order) else 0)
      <> -9223372036854775807 - 1
    failed = 4
    return when next <> 30
    failed = 0
end round_trips

--  The bytes each order lays down, the signed reading of each, and a
--  view taken that outlives the reads after it.
layouts: () -> (failed: i32) =
    mut buffer: [8]u8 = zeroed
    mut at: usize = 0
    failed = 5
    bits.write_u32(buffer, at, 0x01020304, bits.little) else begin return end
    bits.write_u32(buffer, at, 0x01020304, bits.big) else begin return end
    return when not same(buffer[0..<8], [4, 3, 2, 1, 1, 2, 3, 4])
    bytes: [8]u8 = [0xff, 0xff, 0x80, 0x00, 0x00, 0x00, 0x00, 0x80]
    mut next: usize = 0
    failed = 6
    return when (bits.read_i16(bytes, next, bits.little) else 0) <> -1
    return when (bits.read_i16(bytes, next, bits.big) else 0) <> -32768
    return when (bits.read_i32(bytes, next, bits.little) else 0)
      <> -2147483647 - 1
    failed = 7
    next = 0
    return when (bits.read_u64(bytes, next, bits.big) else 0)
      <> 0xffff800000000080
    failed = 8
    next = 0
    bits.skip(bytes, next, 2) else begin return end
    return when next <> 2
    taken: []u8 = bits.take(bytes, next, 2) else begin return end
    last: u32 = bits.read_u32(bytes, next, bits.big) else 0
    return when not same(taken, [0x80, 0x00]) or last <> 0x80 or next <> 8
    failed = 0
end layouts

--  A read with too few bytes and a write with too little room fail with
--  the library's atoms and move nothing, and so does a read from past
--  the end.
refusals: () -> (failed: i32) =
    bytes: [7]u8 = [1, 2, 3, 4, 5, 6, 7]
    failed = 9
    for length in usize(0)..<8 do
        short: []u8 = bytes[0..<length]
        mut at: usize = 0
        if length < 2 then
            _ = bits.read_u16(short, at, bits.big) else (problem)
                return when problem <> mem.out_of_bounds
                0
            end
            return when at <> 0
        end if
        if length < 4 then
            _ = bits.read_i32(short, at, bits.little) else (problem)
                return when problem <> mem.out_of_bounds
                0
            end
            return when at <> 0
        end if
        _ = bits.read_u64(short, at, bits.little) else (problem)
            return when problem <> mem.out_of_bounds
            0
        end
        return when at <> 0
        bits.skip(short, at, length + 1) else (problem)
            return when problem <> mem.out_of_bounds
        end
        return when at <> 0
        _ = bits.take(short, at, length + 1) else (problem)
            return when problem <> mem.out_of_bounds
            short
        end
        return when at <> 0
    end for
    mut beyond: usize = 9
    _ = bits.read_u8(bytes, beyond) else (problem)
        return when problem <> mem.out_of_bounds
        0
    end
    return when beyond <> 9
    failed = 10
    mut buffer: [7]u8 = zeroed
    mut at: usize = 0
    bits.write_u32(buffer, at, 1, bits.big) else begin return end
    bits.write_u32(buffer, at, 2, bits.big) else (problem)
        return when problem <> mem.out_of_memory
    end
    return when at <> 4
    bits.write_uleb128(buffer, at, 0xffffffff) else (problem)
        return when problem <> mem.out_of_memory
    end
    return when at <> 4
    bits.write_sleb128(buffer, at, -0x10000000) else (problem)
        return when problem <> mem.out_of_memory
    end
    return when at <> 4 or buffer[4] <> 0
    failed = 0
end refusals

public main: () -> (code: i32) =
    code = round_trips(bits.little)
    return when code <> 0
    code = round_trips(bits.big)
    return when code <> 0
    code = layouts()
    return when code <> 0
    code = refusals()
    return when code <> 0
    code = 42
end main
