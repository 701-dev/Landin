--  D429: a pointer union compares with its own atom, which asks which
--  case it holds and reads no address: the union holds its atom when its
--  carrier is zero.  The atom may stand on either side.
absent: atom
cell: type = absent | ptr u32

pick: (p: ptr u32, which: u32) -> (r: cell from p) =
    if which == 0 then
        r = absent
    else
        r = p
    end if
end pick

public main: () -> (code: i32) =
    x: u32 = 3
    empty: cell = absent
    full: cell = addr x
    code = 1
    return when empty <> absent or full == absent
    code = 2
    return when not (absent == empty) or absent == full
    code = 3
    first := pick(addr x, 0)
    second := pick(addr x, 1)
    return when first <> absent or absent <> first
    code = 4
    return when second == absent or absent == second
    code = 5
    held := first == absent
    return when not held
    code = 42
end main
