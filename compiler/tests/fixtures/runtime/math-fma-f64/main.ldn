call_1: (x: f64, y: f64, z: f64) -> (result: f64) =
    result = math.fma(x, y, z)
end call_1

run_64_3: (cases: []u64, routine: (x: f64, y: f64, z: f64) -> (result: f64),
           bound: u64) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        x := from_64(cases[at + 0])
        y := from_64(cases[at + 1])
        z := from_64(cases[at + 2])
        if not within_64(routine(x, y, z), cases[at + 3], bound) then
            failures = failures + 1
        end if
        at = at + 4
    end while
end run_64_3

public main: () -> (code: i32) =
    code = 42
    if run_64_3(cases_1, call_1, 0) <> 0 and code == 42 then
        code = 1
    end if
end main
