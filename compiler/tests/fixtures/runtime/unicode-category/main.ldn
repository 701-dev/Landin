--  Generated by scripts/unicode_tables.py from the Unicode Character
--  Database 18.0.0; do not edit it.  Every value from zero
--  to U+10FFFF has the general category the database gives it: the
--  digest of each one's code, its place in the database's order, is
--  the database's.

import core/unicode

expected: u64 = 0x51943f997e8ed433

--  FNV-1a, 64 bits: fold one byte into the digest.
feed: (inout state: u64, value: u8) -> none =
    state = (state ^ u64(value)) *% 0x100000001b3
end feed

code_of: (kind: unicode.general_category) -> (value: u8) =
    match kind
        unicode.uppercase_letter: value = 0
        unicode.lowercase_letter: value = 1
        unicode.titlecase_letter: value = 2
        unicode.modifier_letter: value = 3
        unicode.other_letter: value = 4
        unicode.nonspacing_mark: value = 5
        unicode.spacing_mark: value = 6
        unicode.enclosing_mark: value = 7
        unicode.decimal_number: value = 8
        unicode.letter_number: value = 9
        unicode.other_number: value = 10
        unicode.connector_punctuation: value = 11
        unicode.dash_punctuation: value = 12
        unicode.open_punctuation: value = 13
        unicode.close_punctuation: value = 14
        unicode.initial_punctuation: value = 15
        unicode.final_punctuation: value = 16
        unicode.other_punctuation: value = 17
        unicode.math_symbol: value = 18
        unicode.currency_symbol: value = 19
        unicode.modifier_symbol: value = 20
        unicode.other_symbol: value = 21
        unicode.space_separator: value = 22
        unicode.line_separator: value = 23
        unicode.paragraph_separator: value = 24
        unicode.control: value = 25
        unicode.format: value = 26
        unicode.surrogate: value = 27
        unicode.private_use: value = 28
        unicode.unassigned: value = 29
    end match
end code_of

public main: () -> (code: i32) =
    mut state: u64 = 0xcbf29ce484222325
    mut scalar: u32 = 0
    while scalar <= 0x10ffff do
        feed(state, code_of(unicode.category(scalar)))
        inc scalar
    end while
    code = 1
    if state == expected then
        code = 42
    end if
end main
