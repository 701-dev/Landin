cases_1: [120]u64 = [
    0x0000000000000000, 0x0000000000000000, 0x8000000000000000,
    0x8000000000000000, 0x7ff0000000000000, 0x7ff0000000000000,
    0xfff0000000000000, 0xfff8000000000000, 0x7ff8000000000000,
