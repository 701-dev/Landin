run_1: () -> (failures: u32) =
    --  log1p at f64, within 1 of the correctly rounded result
    failures = 0
    mut at: usize = 0
    while at < lenof cases_1 do
        x := from_64(cases_1[at + 0])
        if not within_64(math.log1p(x), cases_1[at + 1], 1) then
            failures = failures + 1
        end if
        at = at + 2
    end while
end run_1

