--  Generated by scripts/text_fixtures.py; do not edit it.
--  Texts of every escape, control and unseen scalar, and scalars of
--  every width: `text.utf8_append_quoted` writes each one's quoted
--  form as the generator spells it, and that form, pasted here as
--  the source of a literal, reads back as the text.

import core/text

--  Whether `source` quotes to `wanted`, and `read`, the quoted form
--  read back as a literal, is `source`.
quotes: (source: utf8, wanted: utf8, read: utf8) -> (yes: bool) =
    yes = false
    mut storage: [512]u8 = zeroed
    mut into: text.utf8_builder = text.utf8_over(storage)
    text.utf8_append_quoted(into, source) else begin
        return
    end
    yes = text.equal(text.utf8_used(into), wanted) and text.equal(read, source)
end quotes

public main: () -> (code: i32) =
    code = 1
    return when not quotes("",
                           "\"\"",
                           "")
    code = 2
    return when not quotes("plain",
                           "\"plain\"",
