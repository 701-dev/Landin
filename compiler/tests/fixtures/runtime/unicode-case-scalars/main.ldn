--  Generated by scripts/unicode_tables.py from the Unicode Character
--  Database 18.0.0; do not edit it.  Every scalar has the
--  simple and full case mappings the database gives it: the digest of
--  its simple upper, lower, title and folded mappings, each four bytes
--  with the lowest first, and then of its full ones, each of the
--  scalar as a text of its own, is the database's.  A text of one
--  scalar is one word, so its title case is its full title mapping
--  when it is cased, and itself when it is not; a lone capital sigma
--  is no word's final sigma.

import core/text
import core/unicode

expected: u64 = 0x229771c1eb3bd91b

--  FNV-1a, 64 bits: fold one byte into the digest.
feed: (inout state: u64, value: u8) -> none =
    state = (state ^ u64(value)) *% 0x100000001b3
end feed

--  Fold the bytes of `value` into the digest, then a byte no UTF-8 holds.
feed_text: (inout state: u64, value: utf8) -> none =
    for each in text.bytes(value) do
        feed(state, each)
    end for
    feed(state, 0xff)
end feed_text

--  Fold the four bytes of `value`, the lowest first, into the digest.
feed_scalar: (inout state: u64, value: u32) -> none =
    feed(state, u8(value & 0xff))
    feed(state, u8((value >> 8) & 0xff))
    feed(state, u8((value >> 16) & 0xff))
    feed(state, u8(value >> 24))
end feed_scalar

public main: () -> (code: i32) =
    code = 1
    mut state: u64 = 0xcbf29ce484222325
    mut encoded: [4]u8 = zeroed
    mut storage: [64]u8 = zeroed
    mut scalar: u32 = 0
    while scalar <= 0x10ffff do
        if scalar >= 0xd800 and scalar <= 0xdfff then
            scalar = 0xe000
        end if
        feed_scalar(state, unicode.simple_upper(scalar))
        feed_scalar(state, unicode.simple_lower(scalar))
        feed_scalar(state, unicode.simple_title(scalar))
        feed_scalar(state, unicode.simple_fold(scalar))
        count: usize = text.encode(scalar, encoded) else begin return end
        source: utf8 = text.from_bytes(encoded[0..<count]) else begin return end
        mut into: text.utf8_builder = text.utf8_over(storage)
        unicode.append_upper(into, source) else begin return end
        feed_text(state, text.utf8_used(into))
        text.utf8_clear(into)
        unicode.append_lower(into, source) else begin return end
        feed_text(state, text.utf8_used(into))
        text.utf8_clear(into)
        unicode.append_title(into, source) else begin return end
        feed_text(state, text.utf8_used(into))
        text.utf8_clear(into)
        unicode.append_folded(into, source) else begin return end
        feed_text(state, text.utf8_used(into))
        inc scalar
    end while
    if state == expected then
        code = 42
    end if
end main
