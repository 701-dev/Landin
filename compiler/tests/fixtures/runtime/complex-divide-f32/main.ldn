    0x8000a88c, 0xea45d39e, 0xe651257c, 0xf6a25bf5, 0x331bf62e, 0x22c8e7c0,
    0xc6ed2c59, 0x4d898171, 0xbec71ba6, 0xcad5515f, 0xc22504cb, 0xbb8e63b4,
    0xc5a2a9ad, 0x05b744b3, 0x207d0105, 0x000004ce, 0xe4a496ca, 0x3e480a73,
    0x3e1c4037, 0x47e074f6, 0xbad81d5c, 0x38d57239, 0x4a82cc55, 0xcc846fb0]

call_1: (z: complex.number(f32), w: complex.number(f32)) -> (result: complex.number(f32)) =
    result = complex.divide(z, w)
end call_1

run_32_zz_z: (cases: []u32, routine: (z: complex.number(f32), w: complex.number(f32)) -> (result: complex.number(f32)),
              bound: u32) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        z: complex.number(f32) = (real: from_32(cases[at + 0]), imaginary: from_32(cases[at + 1]))
        w: complex.number(f32) = (real: from_32(cases[at + 2]), imaginary: from_32(cases[at + 3]))
        got := routine(z, w)
        if not within_part_32(got.real, cases[at + 4], cases[at + 5], bound)
          or not within_part_32(got.imaginary, cases[at + 5], cases[at + 4], bound) then
            failures = failures + 1
        end if
        at = at + 6
    end while
end run_32_zz_z

public main: () -> (code: i32) =
    code = 42
    if run_32_zz_z(cases_1, call_1, 4) <> 0 and code == 42 then
        code = 1
    end if
end main
