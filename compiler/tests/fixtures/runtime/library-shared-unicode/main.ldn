import core/unicode

--  A little of core/unicode, as small as Cortex-M0 holds: a letter's
--  general category, the grapheme clusters of an accent spelled apart and
--  a flag, and a letter's simple uppercase.
exercise: () -> (ok: bool) =
    ok = false
    return when unicode.unicode_version.major < 18
    return when unicode.category(u32('A')) <> unicode.uppercase_letter
    mut clusters: usize = 0
    for piece in unicode.graphemes("e\u{301}\u{1f1f3}\u{1f1f1}") do
        _ = piece
        inc clusters
    end for
    return when clusters <> 2
    ok = unicode.simple_upper(u32('a')) == u32('A')
         and unicode.simple_upper(0xdf) == 0xdf
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise()
    if ok then
        code = 42
    end if
end main
