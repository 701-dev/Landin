--  The cases of the reference BLAS's level 1 test programs, translated
--  from BLAS/TESTING/dblat1.f (and sblat1.f for the f32 width) of
--  Reference-LAPACK v3.12.1 into core/dense: DROTG and DROTMG (CHECK0),
--  DNRM2, DASUM, DSCAL and IDAMAX (CHECK1, with DB1NRM2, the nrm2 test of
--  special values and its own threshold), DDOT, DAXPY, DCOPY, DSWAP and
--  DROTM (CHECK2) and DROT (CHECK3, with the MWPC/MWPS cases), at f64 and
--  at f32.  The NOTICE in this directory carries LAPACK's licence.  The
--  tables are dblat1's own DATA statements, written as f64 and converted to
--  the element type, which is the same decimal rounded once more at f32;
--  the values the program computes (DTRUE of CHECK0, DBTRUE) are computed
--  here at the element type, as the program does.  The tables of CHECK2
--  and CHECK3 are in Fortran order, the first index fastest.
--
--  Each comparison is dblat1's STEST: a value passes when
--  |SFAC * (computed - true)| <= |size| * epsilon, SFAC = 2^-10, epsilon
--  the machine epsilon of the width, 2^-52 or 2^-23.  A size of 0 asks
--  for equality.  DB1NRM2 passes when its ratio, the relative error in
--  units of N * ulp, is below its own threshold of 10.  The random numbers
--  DB1NRM2 draws are a fixed xorshift sequence, the program's
--  RANDOM_NUMBER being the compiler's.
--
--  The mapping to core/dense: DROTG is dense.rotation, DROTMG
--  dense.modified_rotation, with the BLAS's DPARAM read from the result's
--  `form` (the flag: identity -2, general -1, unit_diagonal 0,
--  unit_antidiagonal 1) and only the entries the flag stores compared, the
--  others as dblat1's zeros; DROTM is dense.rotate_modified with the
--  DPARAM made into the same record; DROT dense.rotate; DNRM2
--  dense.norm_two; DASUM dense.sum_magnitudes; DSCAL dense.scale; DDOT
--  dense.dot; DAXPY dense.add_scaled; DCOPY dense.copy; DSWAP dense.swap.
--  IDAMAX is dense.largest_magnitude, which counts from 0 and gives 0 for an
--  empty vector where the BLAS counts from 1 and gives 0: the result here
--  is 0 when N is 0 and the index plus one otherwise.
--
--  Departures from the program:
--  1. Steps are unsigned.  The cases with a negative INCX or INCY are left
--  out where the program holds their expected values: DDOT, DAXPY, DCOPY,
--  DSWAP and DROT's 12 cases of each in the three increment pairs that
--  have one, DROTM's 48, the 6 of DROT's 11 MWPC/MWPS cases that have one,
--  and the 5 calls of DB1NRM2 with INCX = -2: 119 cases at each width.  Run
--  in their place, with the increments' magnitudes, are the same routines
--  against an index-by-index reference loop written here (the
--  "magnitude" cases), compared by STEST's rule with the reference's
--  results as the true values and their magnitudes as sizes.  DB1NRM2's
--  INCX = 0 is a step of 0, which core/dense accepts; its N = 0 calls
--  return at once in the program and are not made here.
--  2. DSDOT, the program's case 13, is not translated: core/dense leaves
--  extended-precision accumulation out.
--  3. Of the tables of CHECK2 and CHECK3 only the entries for INCX = INCY
--  = 1 are kept, the one pair of steps with none negative: 28 of the 112
--  entries of each, and DROTM's first block of four.  The program tests
--  no error exits in level 1.  The threshold of the program, 10, is kept
--  for DB1NRM2; STEST has none.
--
--  Exit status: 42 when every case passes.  Otherwise the code of the
--  first case that fails, plus 50 at f32:
--    1 DROTG          2 DROTMG         3 DNRM2          4 DASUM
--    5 DSCAL          6 IDAMAX         7 DDOT           8 DAXPY
--    9 DCOPY         10 DCOPY, steps 0                 11 DSWAP
--   12 DROTM         13 DROT          14 DROT's MWPC/MWPS cases
--   15 DB1NRM2
--   16 DDOT, 17 DAXPY, 18 DCOPY, 19 DSWAP, 20 DROT and 21 DROTM, in the
--      magnitude cases.
import core/dense
import core/math

--  The code of the first failed case, 0 while none has, and the amount
--  added to a code at f32.
mut failure: i32 = 0
mut offset: i32 = 0

record_failure: (code: i32) -> none =
    if failure == 0 then
        failure = code + offset
    end if
end record_failure

--  The machine epsilon of the width: the gap above 1.
epsilon: (item: type is math.floating) -> (value: item) =
    one: item = item(1)
    value = if sizeof item == 8 then math.scale(one, -52) else math.scale(one, -23) end if
end epsilon

--  STEST's test of one value: |factor * (got - want)| <= |size| * epsilon.
close: (item: type is math.floating, got: item, want: item, size: item,
        factor: item, code: i32) -> none =
    difference := got - want
    ratio_limit := math.abs(size) * epsilon(item: item)
    if not (math.abs(factor * difference) <= ratio_limit) then
        record_failure(code)
    end if
    --  MEASURE
end close

--  STEST: the first `count` of `got` against `want`, sizes `size`.
agree: (item: type is math.floating, got: []item, want: []item, size: []item,
        count: usize, factor: item, code: i32) -> none =
    for i in 0..<count do
        close(got[i], want[i], size[i], factor, code)
    end for
end agree

--  Copy `count` entries of a table, from entry `at`, as the element type.
fetch: (item: type is math.floating, into: []mut item, table: []f64, at: usize,
        count: usize) -> none =
    for i in 0..<count do
        into[i] = item(table[at + i])
    end for
end fetch

--  Whether two counts agree: ITEST1.
same: (got: usize, want: usize, code: i32) -> none =
    if got <> want then
        record_failure(code)
    end if
end same

--  The BLAS's IDAMAX: from 1, and 0 for no elements.
iamax: (item: type is math.floating, x: dense.vector(item)) -> (place: usize) =
    place = if x.length == 0 then 0 else dense.largest_magnitude(x) + 1 end if
end iamax

--  The factor of every STEST of the program.
sfac_of: (item: type is math.floating) -> (factor: item) =
    factor = item(0.0009765625)
end sfac_of

--  DB1NRM2's model parameters: BIGNUM, SAFMAX, SAFMIN, SMLNUM and ULP of
