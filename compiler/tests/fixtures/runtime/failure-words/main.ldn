--  failure.words gives every library failure atom its own phrase: each one
--  below is the phrase the reference documents, in lower case with no
--  final stop, and no two atoms share one.
import core/cache
import core/cmp
import core/failure
import core/io
import core/line
import core/mem
import core/net
import core/text
import core/tree

reasons: [29]failure.reason = [mem.out_of_bounds, mem.empty,
                               mem.not_empty, mem.out_of_memory, mem.not_found,
                               tree.invalid_children, tree.too_many_nodes,
                               tree.too_many_leaves, io.no_access,
                               io.io_failed, io.is_a_directory,
                               io.already_exists, io.not_a_terminal,
                               net.invalid_address, net.refused,
                               net.unreachable, net.address_in_use,
                               net.address_unavailable, net.timed_out,
                               net.disconnected, text.invalid_text,
                               text.invalid_number, text.number_overflow,
                               text.invalid_format, text.invalid_scalar,
                               cache.misaligned, cache.bad_line,
                               line.unsupported_rate, line.unsupported_format]

phrases: [29][]u8 = ["index out of bounds", "nothing to take",
                     "storage still holds items", "out of memory",
                     "not found", "children outside the tree",
                     "too many nodes", "too many leaves",
                     "permission denied", "input or output failed",
                     "is a directory", "already exists", "not a terminal",
                     "invalid address", "connection refused",
                     "address unreachable", "address in use",
                     "address not available", "timed out",
                     "peer disconnected", "invalid UTF-8", "not a number",
                     "number out of range",
                     "template does not fit its values",
                     "not a Unicode scalar value", "not whole cache lines",
                     "cache line not a power of two",
                     "unsupported line rate", "unsupported frame format"]

--  The phrase in lower case, as it reads after a colon, with no stop.
plain: (phrase: []u8) -> (yes: bool) =
    yes = lenof phrase > 0 and phrase[0] >= u8('a')
          and phrase[0] <= u8('z')
          and phrase[lenof phrase - 1] <> u8('.')
end plain

public main: () -> (code: i32) =
    code = 1
    for at in usize(0)..<usize(29) do
        phrase: []u8 = failure.words(reasons[at])
        return when cmp.compare(phrase, phrases[at]) <> cmp.equal
          or not plain(phrase)
        for other in usize(0)..<at do
            return when cmp.compare(phrase, failure.words(reasons[other]))
              == cmp.equal
        end for
    end for
    code = 42
end main
