seeded: [32]u32 = [
    0x00000002, 0x00000bb8, 0x000000a0, 0x00000097, 0xfeb20016, 0xc2530ea3,
    0x7968fe9d, 0x44405c3c, 0x00000002, 0x00000bb9, 0x00000097, 0x000000a0,
    0x84222325, 0xcbf29ce4, 0x91ac0c99, 0xbedc4192, 0x00000002, 0x00000bba,
    0x00000060, 0x00000032, 0x587f29f9, 0x630b8c0d, 0x1b8fa4a7, 0xad8cebcd,
