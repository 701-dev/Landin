import lib as qualified
import lib
as: i32 = 0
qualified: i32 = 2
answer: i32 = 99
forward: (item: type is lib.marked, value: item) -> (result: item) =
    result = lib.identity(value)
end forward
fallible: (value: lib.number) -> (result: lib.number) ! lib.problems =
    result = try lib.work(value)
end fallible
shadow: (answer: i32) -> (result: i32) = answer end shadow
public main: () -> (code: i32) =
    original: lib.cell(lib.number) = (value: forward(lib.answer))
    selected: lib.choice = lib.choice(kind: lib.full(value: original.value))
    lib.counter = lib.counter + 1
    caught := fallible(-1) else (problem)
        match problem
            lib.absent: 0
            _: 1
        end match
    end
    if qualified.counter <> 2 or qualified <> 2
      or sibling() <> 99 or shadow(3) <> 3 or caught <> 0 then
        code = 1
    else
        code = match selected.kind
            lib.empty: 0
            lib.full: original.value + lib.counter
        end match
    end if
end main
