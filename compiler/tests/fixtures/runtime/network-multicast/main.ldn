--  A multicast exchange on one host through hosted/blocking, over the
--  loopback interface, which a host's firewall lets through where it may
--  drop a datagram looped back from another: a datagram socket joins the
--  group 239.255.43.43 through 127.0.0.1, another sends to the group at
--  its port with one hop out through 127.0.0.1, which it reads back, and
--  the datagram arrives; leaving the group twice is `address_unavailable`
--  the second time, and so is joining an address that is no group.  An
--  IPv6 socket's interface reads back as the system's choice until set.
import core/cmp
import core/io
import core/net
import core/time
import hosted/blocking

--- Something came back other than was sent, or a call did not fail as
--- it should.
wrong: atom

--- Whether leaving or joining `group` is `address_unavailable`.
unavailable: (host: blocking.host, socket: io.file, group: net.address,
              joining: bool) -> (yes: bool) =
    yes = false
    chosen: net.address = net.unspecified(net.ipv4, 0)
    if joining then
        net.join_group(host, socket, group, chosen) else (problem)
            yes = problem == net.address_unavailable
        end
    else
        net.leave_group(host, socket, group, chosen) else (problem)
            yes = problem == net.address_unavailable
        end
    end if
end unavailable

exchange: (host: blocking.host) -> none ! ... =
    receiver: io.file = try net.open_datagram(host, net.unspecified(net.ipv4, 0))
    defer net.close(host, receiver) else none
    bound: net.address = try net.local_address(host, receiver)
    group: net.address = net.ipv4_address(239, 255, 43, 43, bound.port)
    here: net.address = net.loopback(net.ipv4, 0)
    try net.join_group(host, receiver, group, here)
    try net.set_timeouts(host, receiver, time.seconds(5), time.seconds(5))
    sender: io.file = try net.open_datagram(host, net.unspecified(net.ipv4, 0))
    defer net.close(host, sender) else none
    try net.set_number(host, sender, net.multicast_hops, 1)
    fail wrong when not net.is_unspecified(try net.multicast_interface(host,
                                                                       sender))
    try net.set_multicast_interface(host, sender, here)
    fail wrong when not net.same_address(try net.multicast_interface(host,
                                                                     sender),
                                         here)
    try net.send_to(host, sender, "to the group", group)
    mut buffer: [32]u8 = zeroed
    got: net.datagram = try net.receive_from(host, receiver, buffer[0..<32])
    fail wrong when cmp.compare(buffer[0..<got.count], "to the group")
      <> cmp.equal
    sent_from: net.address = try net.local_address(host, sender)
    fail wrong when got.sender.port <> sent_from.port
    try net.leave_group(host, receiver, group, here)
    fail wrong when not unavailable(host, receiver, group, false)
    fail wrong when not unavailable(host, receiver, net.loopback(net.ipv4, 0),
                                    true)
    six: io.file = try net.open_datagram(host, net.unspecified(net.ipv6, 0))
    defer net.close(host, six) else none
    chosen: net.address = try net.multicast_interface(host, six)
    fail wrong when chosen.family <> net.ipv6 or not net.is_unspecified(chosen)
      or net.zone_length(chosen) <> 0
end exchange

public main: () -> (code: i32) =
    code = 1
    host := blocking.new()
    exchange(host) else (problem)
        _ = problem
        return
    end
    code = 42
end main
