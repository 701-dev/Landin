import core/io
import core/io/fake
import core/mem
import core/text

--  An argument is a host string, lent from the world and compared with a
--  literal unconverted; past the last one is `mem.not_found`.
exercise: () -> (ok: bool) ! mem.not_found =
    ok = false
    arguments: [1][]u8 = ["AB"]
    files: []mut io.memory_file = []
    mut output: [1]u8 = zeroed
    mut errors: [1]u8 = zeroed
    mut state: io.memory_space = zeroed
    memory := io.memory_over(state, files, arguments[0..<1], "",
                             output[0..<1], errors[0..<1])
    first := try io.argument(memory, usize(0))
    return when io.arguments_length(memory) <> 1
      or not text.os_string_equal(first, "AB")
    _ = io.argument(memory, usize(1)) else (problem)
        ok = problem == mem.not_found
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
