call_1: (x: f64) -> (result: f64) =
    result = math.log_gamma(x)
end call_1

run_64_1: (cases: []u64, routine: (x: f64) -> (result: f64),
           bound: u64) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        x := from_64(cases[at + 0])
        if not within_64(routine(x), cases[at + 1], bound) then
            failures = failures + 1
        end if
        at = at + 2
    end while
end run_64_1

public main: () -> (code: i32) =
    code = 42
    if run_64_1(cases_1, call_1, 4) <> 0 and code == 42 then
        code = 1
    end if
end main
