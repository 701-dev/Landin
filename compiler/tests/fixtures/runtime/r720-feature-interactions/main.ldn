-- D233-D241's constructs meeting each other: shared names of a pointer
-- union (D233), an inferred array of that union (D241), whole discards
-- (D241), shared union fields (D233) and a labelled block left from inside
-- a loop over the array (D234).  Exit 42 means every step agreed.
none_found: atom
maybe: type = none_found | ptr mut u32

pair: type = struct
    left: maybe
    right: maybe
end pair

classify: (m: maybe) -> (code: i32) =
    match m
        none_found: code = 1
        ptr (p): code = i32(p.val)
    end match
end classify

public main: () -> (code: i32) =
    mut cell: u32 = 40
    first: maybe = none_found
    mut second: maybe = none_found
    second = addr cell
    refused: maybe = none_found
    row := [first, second, refused]
    _ = row[1]
    _ = row
    held: pair = (left: second, right: refused)
    _ = held
    mut total: i32 = 0
    search: begin
        for item in row do
            total = total + classify(item)
            break search when total > 40
        end for
        total = 0
    end search
    code = total + 1
    if classify(first) <> 1 or classify(held.left) <> 40
      or classify(held.right) <> 1 or sizeof maybe <> sizeof usize then
        code = 3
    end if
end main
