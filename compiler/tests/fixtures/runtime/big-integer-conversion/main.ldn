mut backing: [4096]u8 = zeroed

--  Whether two runs of limbs are the same limbs.
same: (left: []u32, right: []u32) -> (yes: bool) =
    yes = lenof left == lenof right
    return when not yes
    for value, at in left do
        if value <> right[at] then
            yes = false
            return
        end if
    end for
end same

