--  A signed number from `table` at `at` into `into`, `at` moved past it.
take: (provider: type is mem.allocator, table: []u32, inout at: usize,
       inout into: big.integer, memory: provider)
      -> none ! mem.out_of_memory =
    header: u32 = table[at]
    count: usize = usize(header & 0x7fffffff)
    inc at
    try big.set_limbs(into, memory, table[at..<at + count], header >> 31 == 1)
    at = at + count
end take

--  Whether `value` is the signed number `want`.
equals: (value: big.integer, want: big.integer) -> (yes: bool) =
    yes = big.compare(value, want) == cmp.equal
          and same(big.limbs_of(value), big.limbs_of(want))
end equals

--  Whether one record, from `at`, agrees.
agrees: (provider: type is mem.allocator, inout at: usize, memory: provider)
        -> (yes: bool) ! mem.out_of_memory =
    yes = false
    op: u32 = cases[at]
    inc at
    mut a := big.new()
    mut b := big.new()
    mut c := big.new()
    try take(cases, at, a, memory)
    try take(cases, at, b, memory)
    try take(cases, at, c, memory)
    p: u64 = u64(cases[at]) | (u64(cases[at + 1]) << 32)
    at = at + 2
    mut want := big.new()
    mut also := big.new()
    try take(cases, at, want, memory)
    try take(cases, at, also, memory)
    word: u32 = cases[at]
    inc at
    mut r := big.new()
    s := big.new()
    mut w: u32 = 0
    if op == 0x17 then
        value: i64 = big.to_i64(a) else (problem)
            _ = problem
            yes = word == 1
            return
        end
        try big.set_i64(r, memory, value)
        bits: u64 = if value < 0 then 0 -% u64(-(value + 1)) -% 1
                    else u64(value) end if
        yes = word == 0 and bits == p and equals(r, a)
        return
    elsif op == 0x18 then
        value: u64 = big.to_u64(a) else (problem)
            _ = problem
            yes = word == 1
            return
        end
        try big.set_u64(r, memory, value)
        yes = word == 0 and value == p and equals(r, a)
        return
    elsif op == 0x19 then
        got: f64 = big.to_f64(a)
        view: ptr u64 = ptr(usize(addr got))
        yes = view.val == p
        return
    elsif op == 0x1a then
        got: f32 = big.to_f32(a)
        view: ptr u32 = ptr(usize(addr got))
        yes = u64(view.val) == p
        return
    elsif op == 0x1b then
        bits: u64 = p
        value: ptr f64 = ptr(usize(addr bits))
        big.set_f64(r, memory, value.val) else (problem)
            match problem
                big.not_finite: w = 1
                mem.out_of_memory: fail mem.out_of_memory
            end match
        end
    elsif op == 0x1c then
        bits: u32 = u32(p)
        value: ptr f32 = ptr(usize(addr bits))
        big.set_f32(r, memory, value.val) else (problem)
            match problem
                big.not_finite: w = 1
                mem.out_of_memory: fail mem.out_of_memory
            end match
        end
    end if
    yes = w == word and equals(r, want) and equals(s, also)
end agrees

--  Whether every record of `cases` agrees, each in an empty arena.
run_cases: () -> (ok: bool) =
    ok = true
    mut at: usize = 0
    while at < lenof cases do
        mut space: arena.space = zeroed
        memory := arena.over_unchecked(space, addr backing[0], 4096)
        agreed := agrees(at, memory) else false
        if not agreed then
            ok = false
            return
        end if
    end while
end run_cases

public main: () -> (code: i32) =
    code = 42
    if not run_cases() then
        code = 1
    end if
end main
