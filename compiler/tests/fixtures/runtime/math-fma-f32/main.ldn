call_1: (x: f32, y: f32, z: f32) -> (result: f32) =
    result = math.fma(x, y, z)
end call_1

run_32_3: (cases: []u32, routine: (x: f32, y: f32, z: f32) -> (result: f32),
           bound: u32) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        x := from_32(cases[at + 0])
        y := from_32(cases[at + 1])
        z := from_32(cases[at + 2])
        if not within_32(routine(x, y, z), cases[at + 3], bound) then
            failures = failures + 1
        end if
        at = at + 4
    end while
end run_32_3

public main: () -> (code: i32) =
    code = 42
    if run_32_3(cases_1, call_1, 0) <> 0 and code == 42 then
        code = 1
    end if
end main
