pair: type = struct
    left: u32
    right: u32
end pair

mut module_row: [2]u32 = [1, 2]
mut module_pair: pair = (left: 1, right: 2)

swap_module: (inout row: [2]u32) -> none =
    row = [module_row[1], module_row[0]]
end swap_module

swap_given: (inout row: [2]u32, given: [2]u32) -> none =
    row = [given[1], given[0]]
end swap_given

turn: (inout held: pair) -> none =
    held = (left: module_pair.right, right: module_pair.left)
end turn

twice: (value: u32) -> (result: u32) = result = value * 2 end twice

first_odd: (values: [3]u32) -> (found: u32) ! none_odd =
    for value in values do
        if value % 2 == 1 then
            found = value
            return
        end if
    end for
    fail none_odd
end first_odd

none_odd: atom

public main: () -> (code: i32) =
    mut local: [2]u32 = [3, 4]
    pointer := addr local
    local = [pointer.val[1], pointer.val[0]]

    swap_module(module_row)

    mut other: [2]u32 = [5, 6]
    swap_given(other, other)

    turn(module_pair)

    mut plain: [2]u32 = [7, 8]
    plain = [twice(plain[1]), twice(plain[0])]

    mut kept: [3]u32 = [9, 10, 11]
    loop do
        kept = [kept[2] + 1, first_odd([2, 4, 6]) else begin break end, 0]
    end loop

    code = 0
    if local[0] == 4 and local[1] == 3 then code = code + 1 end if
    if module_row[0] == 2 and module_row[1] == 1 then code = code + 1 end if
    if other[0] == 6 and other[1] == 5 then code = code + 10 end if
    if module_pair.left == 2 and module_pair.right == 1 then
        code = code + 10
    end if
    if plain[0] == 16 and plain[1] == 14 then code = code + 10 end if
    if kept[0] == 9 and kept[1] == 10 and kept[2] == 11 then
        code = code + 10
    end if
end main
