--  The Benchmark Game's regex-redux patterns over core/regex: the FASTA
--  that benchmark-game-fasta writes for 1000, on standard input, has its
--  header lines and line breaks taken out by `>.*\n|\n`, then each of
--  the nine variants counted and the five IUB replacements applied in
--  turn.  The counts and lengths are what Python's `re` gives on the same
--  input, whose meaning these patterns share; each count is also the
--  Pike VM's alone.

import core/io
import core/mem
import core/regex
import core/text
import hosted/blocking
import hosted/heap

variants: [9]utf8 = [
    "agggtaaa|tttaccct", "[cgt]gggtaaa|tttaccc[acg]",
    "a[act]ggtaaa|tttacc[agt]t", "ag[act]gtaaa|tttac[agt]ct",
    "agg[act]taaa|ttta[agt]cct", "aggg[acg]aaa|ttt[cgt]ccct",
    "agggt[cgt]aa|tt[acg]accct", "agggta[cgt]a|t[acg]taccct",
    "agggtaa[cgt]|[acg]ttaccct"
]
counts: [9]usize = [1, 0, 0, 0, 1, 0, 0, 0, 2]

patterns: [5]utf8 = ["tHa[Nt]", "aND|caN|Ha[DS]|WaS", "a[NSt]|BY", "<[^>]*>",
                     "\\|[^|][^|]*\\|"]
replacements: [5]utf8 = ["<4>", "<3>", "<2>", "|", "-"]

input_length: usize = 10245
clean_length: usize = 10000
final_length: usize = 5262

--  Append all of standard input to `whole`, a read at a time.
read_all: (host: blocking.host, inout whole: text.builder)
          -> none ! io.io_failed | mem.out_of_memory =
    input: io.file = io.input(host)
    mut chunk: [65536]u8 = zeroed
    loop do
        got: usize = try io.read(host, input, chunk)
        break when got == 0
        try text.append(whole, chunk[0..<got])
    end loop
end read_all

--  How many matches of `pattern` `haystack` has, with `which`'s engine.
count_of: (provider: type is mem.allocator, memory: provider, pattern: utf8,
           haystack: utf8, which: regex.engine)
          -> (count: usize) ! regex.compile_failure =
    count = 0
    settings: regex.options = regex.with_engine(regex.defaults(), which)
    mut compiled := try regex.compile_with(memory, pattern, settings)
    defer regex.release(compiled, memory)
    for found in regex.matches(addr compiled, haystack) do
        _ = found
        inc count
    end for
end count_of

--  `source` with every match of `pattern` replaced by `template`, into
--  `into`, cleared first.
replaced: (provider: type is mem.allocator, memory: provider, pattern: utf8,
           source: utf8, template: utf8, inout into: text.builder)
          -> none ! regex.compile_failure =
    mut compiled := try regex.compile(memory, pattern)
    defer regex.release(compiled, memory)
    text.clear(into)
    _ = try regex.replace_all(compiled, source, template, into)
end replaced

redux: (host: blocking.host) -> (ok: bool) ! regex.compile_failure
                                           | io.io_failed
                                           | text.invalid_text =
    ok = false
    memory := heap.new()
    mut whole := text.growing(any(addr memory))
    defer text.release(whole)
    try read_all(host, whole)
    return when text.length(whole) <> input_length
    mut one := text.growing(any(addr memory))
    defer text.release(one)
    mut other := text.growing(any(addr memory))
    defer text.release(other)
    input: utf8 = try text.from_bytes(text.used(whole))
    try replaced(memory, ">.*\\n|\\n", input, "", one)
    return when text.length(one) <> clean_length
    for variant, index in variants do
        sequence: utf8 = try text.from_bytes(text.used(one))
        found: usize = try count_of(memory, variant, sequence, regex.automatic)
        alone: usize = try count_of(memory, variant, sequence, regex.pike_vm)
        return when found <> counts[index] or alone <> found
    end for
    for pattern, index in patterns do
        if index % 2 == 0 then
            sequence: utf8 = try text.from_bytes(text.used(one))
            try replaced(memory, pattern, sequence, replacements[index], other)
        else
            sequence: utf8 = try text.from_bytes(text.used(other))
            try replaced(memory, pattern, sequence, replacements[index], one)
        end if
    end for
    ok = text.length(other) == final_length
end redux

public main: () -> (code: i32) =
    code = 1
    host := blocking.new()
    if redux(host) else false then
        code = 42
    end if
end main
