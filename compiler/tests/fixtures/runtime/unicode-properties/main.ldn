--  Generated by scripts/unicode_tables.py from the Unicode Character
--  Database 18.0.0; do not edit it.  Every value from zero
--  to U+10FFFF has the canonical combining class and the binary
--  properties the database gives it: the digest of the class and of
--  the properties' bits, Alphabetic the lowest, is the database's.

import core/unicode

expected: u64 = 0x2b0aa28c573dbc77

--  FNV-1a, 64 bits: fold one byte into the digest.
feed: (inout state: u64, value: u8) -> none =
    state = (state ^ u64(value)) *% 0x100000001b3
end feed

--  The six binary properties, one bit each, Alphabetic the lowest.
bits_of: (scalar: u32) -> (value: u8) =
    value = 0
    if unicode.is_alphabetic(scalar) then
        value |= 1
    end if
    if unicode.is_white_space(scalar) then
        value |= 2
    end if
    if unicode.is_uppercase(scalar) then
        value |= 4
    end if
    if unicode.is_lowercase(scalar) then
        value |= 8
    end if
    if unicode.is_cased(scalar) then
        value |= 16
    end if
    if unicode.is_case_ignorable(scalar) then
        value |= 32
    end if
end bits_of

public main: () -> (code: i32) =
    mut state: u64 = 0xcbf29ce484222325
    mut scalar: u32 = 0
    while scalar <= 0x10ffff do
        feed(state, unicode.combining_class(scalar))
        feed(state, bits_of(scalar))
        inc scalar
    end while
    code = 1
    if state == expected then
        code = 42
    end if
end main
