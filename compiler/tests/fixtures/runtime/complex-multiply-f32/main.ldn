    0x09ae3707, 0x8000000c, 0x501f8121, 0x9d9c50e3, 0x1a59181b, 0x876f41b2,
    0x858af901, 0x00000030, 0x7735e96e, 0x4b7cd097, 0xbd45818c, 0x2f886f12,
    0x48393d15, 0x80000075, 0x860156ed, 0x729c82c0, 0x2b8f0f83, 0x7b627fa9,
    0x0a49366d, 0xd50c552e, 0x0000001c, 0x290b2703, 0x3e988f45, 0x8cf59510,
    0x31c21c37, 0x00000006, 0x85876f8e, 0x58a4ee99, 0x8f7765e6, 0x4afa1dfb,
    0xc75da406, 0x4d492334, 0xc33562d3, 0x429e1fdf, 0xd0785246, 0xd10e87d0]

call_1: (z: complex.number(f32), w: complex.number(f32)) -> (result: complex.number(f32)) =
    result = complex.multiply(z, w)
end call_1

run_32_zz_z: (cases: []u32, routine: (z: complex.number(f32), w: complex.number(f32)) -> (result: complex.number(f32)),
              bound: u32) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        z: complex.number(f32) = (real: from_32(cases[at + 0]), imaginary: from_32(cases[at + 1]))
        w: complex.number(f32) = (real: from_32(cases[at + 2]), imaginary: from_32(cases[at + 3]))
        got := routine(z, w)
        if not within_part_32(got.real, cases[at + 4], cases[at + 5], bound)
          or not within_part_32(got.imaginary, cases[at + 5], cases[at + 4], bound) then
            failures = failures + 1
        end if
        at = at + 6
    end while
end run_32_zz_z

public main: () -> (code: i32) =
    code = 42
    if run_32_zz_z(cases_1, call_1, 1) <> 0 and code == 42 then
        code = 1
    end if
end main
