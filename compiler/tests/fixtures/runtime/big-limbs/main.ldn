--  A natural from `cases` at `at` into `into`, `at` moved past it.
take: (table: []u32, inout at: usize, into: []mut u32) -> (count: usize) =
    count = usize(table[at])
    inc at
    for slot, index in into[0..<count] do
        slot = table[at + index]
    end for
    at = at + count
end take

--  Whether the operation `op` on `a`, `b` and `p` gives the limbs `want`
--  and the word `word`.
agrees: (op: u32, a: []u32, b: []u32, p: u32, want: []u32, word: u32)
        -> (yes: bool) =
    la: usize = lenof a
    lb: usize = lenof b
    long: usize = if la > lb then la else lb end if
    mut got: u32 = 0
    count: usize = lenof want
    out: []mut u32 = result[0..<640]
    if op == 1 then
        got = limbs.add(out[0..<long], a, b)
    elsif op == 2 then
        got = limbs.subtract(out[0..<la], a, b)
    elsif op == 3 then
        got = limbs.add_limb(out[0..<la], a, p)
    elsif op == 4 then
        got = limbs.subtract_limb(out[0..<la], a, p)
    elsif op == 5 then
        got = limbs.multiply_limb(out[0..<la], a, p)
    elsif op == 6 then
        limbs.copy(out, b)
        got = limbs.add_multiply_limb(out[0..<la], a, p)
    elsif op == 7 then
        limbs.copy(out, b)
        got = limbs.subtract_multiply_limb(out[0..<la], a, p)
    elsif op == 8 then
        got = limbs.shift_left(out[0..<la], a, p)
    elsif op == 9 then
        got = limbs.shift_right(out[0..<la], a, p)
    elsif op == 10 then
        got = limbs.divide_limb(out[0..<la], a, p)
    elsif op == 11 then
        got = limbs.remainder_limb(a, p)
    elsif op == 12 then
        order := limbs.compare(a, b)
        got = if order == cmp.less then 0 elsif order == cmp.equal then 1 else 2 end if
    elsif op == 13 then
        got = u32(limbs.significant(a))
    elsif op == 14 then
        got = limbs.leading_zeros(p)
    elsif op == 15 then
        got = limbs.trailing_zeros(p)
    elsif op == 16 then
        limbs.multiply(out[0..<la + lb], a, b, room[0..<1079])
    elsif op == 17 then
        limbs.divide(out[0..<la - lb + 1], out[la - lb + 1..<la + 1], a, b,
                     room[0..<1079])
    elsif op == 18 or op == 19 then
        written: usize = if op == 18 then
                             limbs.write_decimal(digits[0..<401], a, room[0..<1079])
                         else limbs.write_hex(digits[0..<401], a) end if
        got = digest_text(digits[0..<written])
        back: usize = if op == 18 then
            (limbs.read_decimal(out, digits[0..<written]) else 9999)
                      else (limbs.read_hex(out, digits[0..<written]) else 9999) end if
        yes = back == limbs.significant(a)
              and same(out[0..<back], a[0..<back]) and got == word
        return
    else
        --  The same operations with the result written over the first
        --  operand's own limbs.
        limbs.copy(out, a)
        view: []mut u32 = out[0..<la]
        if op == 21 then
            got = limbs.add(view, view, b)
        elsif op == 22 then
            got = limbs.subtract(view, view, b)
        elsif op == 23 then
            got = limbs.shift_left(view, view, p)
        elsif op == 24 then
            got = limbs.shift_right(view, view, p)
        elsif op == 25 then
            got = limbs.divide_limb(view, view, p)
        elsif op == 26 then
            got = limbs.multiply_limb(view, view, p)
        end if
    end if
    yes = got == word and same(out[0..<count], want)
end agrees

--  Whether every record of `cases` agrees.
run_cases: () -> (ok: bool) =
    ok = true
    mut at: usize = 0
    while at < lenof cases do
        op: u32 = cases[at]
        inc at
        la: usize = take(cases, at, left[0..<320])
        lb: usize = take(cases, at, right[0..<320])
        p: u32 = cases[at]
        inc at
        lr: usize = take(cases, at, expected[0..<80])
        word: u32 = cases[at]
        inc at
        if not agrees(op, left[0..<la], right[0..<lb], p, expected[0..<lr], word) then
            ok = false
        end if
    end while
end run_cases

--  Draw `count` limbs from `source` into `into`, or all ones.
draw: (inout source: random.generator, into: []mut u32, ones: bool) -> none =
    for slot in into do
        slot = random.next_u32(source)
        if ones then slot = 0xffffffff end if
    end for
end draw

--  Whether every record of `seeded` agrees.
run_seeded: () -> (ok: bool) =
    ok = true
    mut at: usize = 0
    while at < lenof seeded do
        op: u32 = seeded[at]
        mut source := random.new(u64(seeded[at + 1]))
        la: usize = usize(seeded[at + 2])
        lb: usize = usize(seeded[at + 3])
        pattern: u32 = seeded[at + 4]
        first: u64 = u64(seeded[at + 5]) | (u64(seeded[at + 6]) << 32)
        second: u64 = u64(seeded[at + 7]) | (u64(seeded[at + 8]) << 32)
        at = at + 9
        draw(source, left[0..<la], pattern & 1 == 1)
        draw(source, right[0..<lb], pattern & 2 == 2)
        if op == 1 then
            limbs.multiply(result[0..<la + lb], left[0..<la], right[0..<lb],
                           room[0..<1079])
            if digest(result[0..<la + lb]) <> first then ok = false end if
        else
            if right[lb - 1] == 0 then right[lb - 1] = 1 end if
            count: usize = la - lb + 1
            limbs.divide(result[0..<count], result[count..<count + lb],
                         left[0..<la], right[0..<lb], room[0..<1079])
            if digest(result[0..<count]) <> first
              or digest(result[count..<count + lb]) <> second then
                ok = false
            end if
        end if
    end while
end run_seeded

--  Whether `source` is refused as decimal, or as hexadecimal.
refused: (source: []u8, decimal: bool) -> (yes: bool) =
    yes = false
    out: []mut u32 = result[0..<8]
    if decimal then
        count: usize = limbs.read_decimal(out, source) else (problem)
            yes = problem == text.invalid_number
            return
        end
        _ = count
    else
        count: usize = limbs.read_hex(out, source) else (problem)
            yes = problem == text.invalid_number
            return
        end
        _ = count
    end if
end refused

--  Text that is not digits is refused.
refusals: () -> (ok: bool) =
    ok = refused("", true) and refused("-1", true) and refused("1 2", true)
         and refused("9a", true) and refused("", false) and refused("0x1", false)
         and refused("fg", false)
end refusals

public main: () -> (code: i32) =
    code = 42
    if not run_cases() then
        code = 1
    elsif not run_seeded() then
        code = 2
    elsif not refusals() then
        code = 3
    end if
end main
