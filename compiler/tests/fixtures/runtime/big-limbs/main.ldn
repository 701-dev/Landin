--  A natural from `table` at `at` into `into`, `at` moved past it.
take: (table: []u32, inout at: usize, into: []mut u32) -> (count: usize) =
    count = usize(table[at])
    inc at
    for slot, index in into[0..<count] do
        slot = table[at + index]
    end for
    at = at + count
end take

--  Whether the operation `op` on `a`, `b` and `p` gives the limbs `want`
--  and the word `word`.
agrees: (op: u32, a: []u32, b: []u32, p: u32, want: []u32, word: u32)
        -> (yes: bool) =
    yes = false
    la: usize = lenof a
    lb: usize = lenof b
    long: usize = if la > lb then la else lb end if
    mut got: u32 = 0
    out: []mut u32 = result[0..<48]
    if op == 0x1 then
        got = limbs.add(out[0..<long], a, b)
    elsif op == 0x2 then
        got = limbs.subtract(out[0..<la], a, b)
    elsif op == 0x3 then
        got = limbs.add_limb(out[0..<la], a, p)
    elsif op == 0x4 then
        got = limbs.subtract_limb(out[0..<la], a, p)
    elsif op == 0x5 then
        got = limbs.multiply_limb(out[0..<la], a, p)
    elsif op == 0x6 then
        limbs.copy(out, b)
        got = limbs.add_multiply_limb(out[0..<la], a, p)
    elsif op == 0x7 then
        limbs.copy(out, b)
        got = limbs.subtract_multiply_limb(out[0..<la], a, p)
    elsif op == 0x8 then
        got = limbs.shift_left(out[0..<la], a, p)
    elsif op == 0x9 then
        got = limbs.shift_right(out[0..<la], a, p)
    elsif op == 0xa then
        got = limbs.divide_limb(out[0..<la], a, p)
    elsif op == 0xb then
        got = limbs.remainder_limb(a, p)
    elsif op == 0xc then
        order := limbs.compare(a, b)
        got = if order == cmp.less then 0 elsif order == cmp.equal then 1 else 2 end if
    elsif op == 0xd then
        got = u32(limbs.significant(a))
    elsif op == 0xe then
        got = limbs.leading_zeros(p)
    elsif op == 0xf then
        got = limbs.trailing_zeros(p)
    elsif op == 0x10 then
        limbs.multiply(out[0..<la + lb], a, b, room[0..<64])
    elsif op == 0x11 then
        limbs.divide(out[0..<la - lb + 1], out[la - lb + 1..<la + 1], a, b,
                     room[0..<64])
    elsif op == 0x12 then
        written: usize = limbs.write_decimal(digits[0..<121], a, room[0..<64])
        back: usize = (limbs.read_decimal(out, digits[0..<written]) else 9999)
        yes = back == limbs.significant(a) and same(out[0..<back], a[0..<back])
              and digest_text(digits[0..<written]) == word
        return
    elsif op == 0x13 then
        written: usize = limbs.write_hex(digits[0..<121], a)
        back: usize = (limbs.read_hex(out, digits[0..<written]) else 9999)
        yes = back == limbs.significant(a) and same(out[0..<back], a[0..<back])
              and digest_text(digits[0..<written]) == word
        return
    elsif op == 0x15 then
        limbs.copy(out, a)
        got = limbs.add(out[0..<la], out[0..<la], b)
    elsif op == 0x16 then
        limbs.copy(out, a)
        got = limbs.subtract(out[0..<la], out[0..<la], b)
    elsif op == 0x17 then
        limbs.copy(out, a)
        got = limbs.shift_left(out[0..<la], out[0..<la], p)
    elsif op == 0x18 then
        limbs.copy(out, a)
        got = limbs.shift_right(out[0..<la], out[0..<la], p)
    elsif op == 0x19 then
        limbs.copy(out, a)
        got = limbs.divide_limb(out[0..<la], out[0..<la], p)
    elsif op == 0x1a then
        limbs.copy(out, a)
        got = limbs.multiply_limb(out[0..<la], out[0..<la], p)
    end if
    yes = got == word and same(out[0..<lenof want], want)
end agrees

--  Whether every record of `cases` agrees.
run_cases: () -> (ok: bool) =
    ok = true
    mut at: usize = 0
    while at < lenof cases do
        op: u32 = cases[at]
        inc at
        la: usize = take(cases, at, left[0..<16])
        lb: usize = take(cases, at, right[0..<16])
        p: u32 = cases[at]
        inc at
        lr: usize = take(cases, at, expected[0..<48])
        word: u32 = cases[at]
        inc at
        if not agrees(op, left[0..<la], right[0..<lb], p, expected[0..<lr], word) then
            ok = false
        end if
    end while
end run_cases

--  Whether `source` is refused as decimal, or as hexadecimal.
refused: (source: []u8, decimal: bool) -> (yes: bool) =
    yes = false
    out: []mut u32 = result[0..<8]
    if decimal then
        count: usize = limbs.read_decimal(out, source) else (problem)
            yes = problem == text.invalid_number
            return
        end
        _ = count
    else
        count: usize = limbs.read_hex(out, source) else (problem)
            yes = problem == text.invalid_number
            return
        end
        _ = count
    end if
end refused

--  Text that is not digits is refused.
refusals: () -> (ok: bool) =
    ok = refused("", true) and refused("-1", true) and refused("1 2", true)
         and refused("9a", true) and refused("", false) and refused("0x1", false)
         and refused("fg", false)
end refusals

public main: () -> (code: i32) =
    code = 42
    if not run_cases() then
        code = 1
    elsif not refusals() then
        code = 2
    end if
end main
