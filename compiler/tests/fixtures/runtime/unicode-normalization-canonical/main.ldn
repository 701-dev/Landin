--  Generated by scripts/unicode_tables.py from the Unicode Character
--  Database 18.0.0; do not edit it.  Every scalar, as a
--  text of its own, has the NFC and NFD forms NormalizationTest.txt's
--  part 1 gives it, and a scalar the part does not list is its own
--  form, as the file's second invariant says: the digest of the
--  forms is the file's.  Each form of a form is what the file's
--  first invariants require of its columns.

import core/mem
import core/text
import core/unicode

expected: u64 = 0xb731ad285aac74b3

--  FNV-1a, 64 bits: fold one byte into the digest.
feed: (inout state: u64, value: u8) -> none =
    state = (state ^ u64(value)) *% 0x100000001b3
end feed

--  Fold the bytes of `value` into the digest, then a byte no UTF-8 holds.
feed_text: (inout state: u64, value: utf8) -> none =
    for each in text.bytes(value) do
        feed(state, each)
    end for
    feed(state, 0xff)
end feed_text

--  Form `form` of `source`, NFC or NFD from zero, written over `storage`.
form_of: (form: u8, source: utf8, storage: []mut u8)
         -> (result: utf8 from storage) ! mem.out_of_memory =
    mut into: text.utf8_builder = text.utf8_over(storage)
    if form == 0 then
        try unicode.append_nfc(into, source)
    else
        try unicode.append_nfd(into, source)
    end if
    result = text.utf8_used(into)
end form_of

--  Whether form `form` of `source` is `wanted`.
gives: (form: u8, source: utf8, wanted: utf8, storage: []mut u8)
       -> (yes: bool) =
    found: utf8 = form_of(form, source, storage) else begin
        yes = false
        return
    end
    yes = text.equal(found, wanted)
end gives

public main: () -> (code: i32) =
    code = 1
    mut state: u64 = 0xcbf29ce484222325
    mut encoded: [4]u8 = zeroed
    mut composed_storage: [96]u8 = zeroed
    mut decomposed_storage: [96]u8 = zeroed
    mut again: [96]u8 = zeroed
    mut scalar: u32 = 0
    while scalar <= 0x10ffff do
        if scalar >= 0xd800 and scalar <= 0xdfff then
            scalar = 0xe000
        end if
        count: usize = text.encode(scalar, encoded) else begin return end
        source: utf8 = text.from_bytes(encoded[0..<count]) else begin return end
        once: utf8 = form_of(0, source, composed_storage) else begin
            return
        end
        apart: utf8 = form_of(1, source, decomposed_storage) else begin
            return
        end
        feed_text(state, once)
        feed_text(state, apart)
        if not text.equal(once, source) or not text.equal(apart, source)
        then
            return when not gives(0, once, once, again)
            return when not gives(0, apart, once, again)
            return when not gives(1, once, apart, again)
            return when not gives(1, apart, apart, again)
        end if
        inc scalar
    end while
    if state == expected then
        code = 42
    end if
end main
