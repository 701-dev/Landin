    0x00000001, 0x00000001, 0x00000000, 0x00000001, 0x00000001, 0x00000000,
    0x00000000, 0x00000003, 0x610718ca, 0xc160393d, 0x0000002e, 0x00000001,
    0x00000001, 0x00000000, 0x00000006, 0x00000003, 0x610718ca, 0xc160393d,
    0x0000002e, 0x00000001, 0x00000001, 0x00000000, 0x00000001, 0x00000001,
    0x00000000, 0x00000000, 0x00000001, 0x00000001, 0x00000001, 0x00000001,
    0x00000000, 0x00000006, 0x00000003, 0x610718ca, 0xc160393d, 0x0000002e,
    0x00000001, 0x00000001, 0x00000000, 0x00000001, 0x00000001, 0x00000001,
    0x00000000, 0x00000003, 0x610718ca, 0xc160393d, 0x0000002e, 0x00000001,
    0x00000001, 0x00000000, 0x00000006, 0x00000003, 0x610718ca, 0xc160393d,
    0x0000002e, 0x00000001, 0x00000001, 0x00000000, 0x00000001, 0x00000001,
    0x00000003, 0x00000000, 0x00000007, 0xa005e4e8, 0x9aed71ec, 0x80c71765,
    0xfb3e15e7, 0x7568c5ef, 0x4a358919, 0x00018f42, 0x00000001, 0x00000001,
    0x00000000, 0x00000006, 0x00000003, 0x610718ca, 0xc160393d, 0x0000002e,
    0x00000001, 0x00000001, 0x00000000, 0x00000001, 0x00000001, 0xffffffff,
    0xffffffff, 0x00000001, 0x00000001, 0x00000003, 0x610718ca, 0xc160393d,
    0x0000002e, 0x00000000, 0x00000006, 0x00000003, 0x610718ca, 0xc160393d,
    0x0000002e, 0x00000001, 0x00000001, 0x00000000, 0x00000001, 0x00000001,
    0xfffffffe, 0xffffffff, 0x00000001, 0x00000001, 0x00000005, 0x71727f64,
    0xb6b2253f, 0x65aec537, 0x10a6cc88, 0x0000088a, 0x00000000]

--  A signed number from `cases` at `at` into `into`, `at` moved past it.
take: (provider: type is mem.allocator, inout at: usize,
       inout into: big.integer, memory: provider)
      -> none ! mem.out_of_memory =
    header: u32 = cases[at]
    count: usize = usize(header & 0x7fffffff)
    inc at
    try big.set_limbs(into, memory, cases[at..<at + count], header >> 31 == 1)
    at = at + count
end take

--  A rational from `cases` at `at`, put in lowest terms.
take_rational: (provider: type is mem.allocator, inout at: usize,
                inout into: big.rational, memory: provider)
               -> none ! mem.out_of_memory =
    mut top := big.new()
    mut bottom := big.new()
    try take(at, top, memory)
    try take(at, bottom, memory)
    try big.rational_set_ratio(into, memory, top, bottom)
end take_rational

--  Whether `value` is `want`, part for part.
equals: (provider: type is mem.allocator, value: big.rational,
         want: big.rational, memory: provider)
        -> (yes: bool) ! mem.out_of_memory =
    mut top := big.new()
    mut bottom := big.new()
    mut other_top := big.new()
    mut other_bottom := big.new()
    try big.rational_numerator(top, memory, value)
    try big.rational_denominator(bottom, memory, value)
    try big.rational_numerator(other_top, memory, want)
    try big.rational_denominator(other_bottom, memory, want)
    order := try big.rational_compare(value, memory, want)
    yes = big.compare(top, other_top) == cmp.equal
          and big.compare(bottom, other_bottom) == cmp.equal
          and order == cmp.equal
end equals

--  Whether one record, from `at`, agrees.
agrees: (provider: type is mem.allocator, inout at: usize, memory: provider)
        -> (yes: bool) ! mem.out_of_memory =
    yes = false
    op: u32 = cases[at]
    inc at
    mut x := big.rational_new()
    mut y := big.rational_new()
    mut want := big.rational_new()
    mut r := big.rational_new()
    mut whole := big.new()
    if op == 1 then
        --  The parts as written, not yet in lowest terms.
        mut top := big.new()
        mut bottom := big.new()
        try take(at, top, memory)
        try take(at, bottom, memory)
        try big.rational_set_ratio(x, memory, top, bottom)
    else
        try take_rational(at, x, memory)
    end if
    try take_rational(at, y, memory)
    p: u64 = u64(cases[at]) | (u64(cases[at + 1]) << 32)
    at = at + 2
    try take_rational(at, want, memory)
    word: u32 = cases[at]
    inc at
    w: u32 = 0
    if op == 0x4 then
        try big.rational_multiply(r, memory, x, y)
    elsif op == 0x5 then
        try big.rational_divide(r, memory, x, y)
    elsif op == 0x6 then
        exponent: i64 = if p >> 63 == 1 then -i64(0 -% p) else i64(p) end if
        try big.rational_power(r, memory, x, exponent)
    elsif op == 0x8 then
        try big.rational_floor(whole, memory, x)
        try big.rational_set_integer(r, memory, whole)
    elsif op == 0x9 then
        try big.rational_truncate(whole, memory, x)
        try big.rational_set_integer(r, memory, whole)
    elsif op == 0x104 then
        try big.rational_set(r, memory, x)
        try big.rational_multiply(r, memory, r, y)
    elsif op == 0x105 then
        try big.rational_set(r, memory, x)
        try big.rational_divide(r, memory, r, y)
    end if
    matches := try equals(r, want, memory)
    yes = w == word and matches
end agrees

--  Whether every record agrees, each in an empty arena.
run_cases: () -> (ok: bool) =
    ok = true
    mut at: usize = 0
    while at < lenof cases do
        mut space: arena.space = zeroed
        memory := arena.over_unchecked(space, addr backing[0], 4096)
        agreed := agrees(at, memory) else false
        if not agreed then
            ok = false
            return
        end if
    end while
end run_cases

public main: () -> (code: i32) =
    code = 42
    if not run_cases() then
        code = 1
    end if
end main
