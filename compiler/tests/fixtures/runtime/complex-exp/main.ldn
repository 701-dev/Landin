--  Generated by scripts/math_oracle.py from compiler/tests/math/cases/complex-exponential.json: edit that and run
--  `python3 scripts/math_oracle.py fixtures complex-exp`, never this file.
--  Each table holds inputs and MPC's correctly rounded result for them;
--  the program exits 42 when each part of every result core/complex
--  gives is within the table's bound of that part, counted in floats,
--  and otherwise with the number of the first table that was not, from 1.
import core/complex
import core/math

--  Reading and comparing bits, written here rather than taken from
--  core/math, so that the check does not lean on what it checks.
bits_64: (x: f64) -> (bits: u64) =
    view: ptr u64 = ptr(usize(addr x))
    bits = view.val
end bits_64

from_64: (bits: u64) -> (x: f64) =
    view: ptr f64 = ptr(usize(addr bits))
    x = view.val
end from_64

bits_32: (x: f32) -> (bits: u32) =
    view: ptr u32 = ptr(usize(addr x))
    bits = view.val
end bits_32

from_32: (bits: u32) -> (x: f32) =
    view: ptr f32 = ptr(usize(addr bits))
    x = view.val
end from_32

--  A float's place in the order of all floats: the next float up is one
--  more, and both zeros are one place.
place_64: (bits: u64) -> (key: u64) =
    key = if bits >> 63 == 1 then 0x8000000000000000 - (bits & 0x7fffffffffffffff)
          else 0x8000000000000000 + bits end if
end place_64

place_32: (bits: u32) -> (key: u32) =
    key = if bits >> 31 == 1 then 0x80000000 - (bits & 0x7fffffff)
          else 0x80000000 + bits end if
end place_32

--  Whether `got` is within `bound` floats of the correctly rounded
--  `want`: NaN only for NaN, an infinity only for itself, and a zero's
--  sign kept.
within_64: (got: f64, want: u64, bound: u64) -> (yes: bool) =
    expected := from_64(want)
    have := bits_64(got)
    if expected <> expected or got <> got then
        yes = expected <> expected and got <> got
    elsif want & 0x7fffffffffffffff == 0x7ff0000000000000
      or have & 0x7fffffffffffffff == 0x7ff0000000000000 then
        yes = have == want
    elsif (expected == 0.0 or got == 0.0) and have >> 63 <> want >> 63 then
        yes = false
    else
        a := place_64(have)
        b := place_64(want)
        yes = (if a > b then a - b else b - a end if) <= bound
    end if
end within_64

within_32: (got: f32, want: u32, bound: u32) -> (yes: bool) =
    expected := from_32(want)
    have := bits_32(got)
    if expected <> expected or got <> got then
        yes = expected <> expected and got <> got
    elsif want & 0x7fffffff == 0x7f800000 or have & 0x7fffffff == 0x7f800000 then
        yes = have == want
    elsif (expected == 0.0 or got == 0.0) and have >> 31 <> want >> 31 then
        yes = false
    else
        a := place_32(have)
        b := place_32(want)
        yes = (if a > b then a - b else b - a end if) <= bound
    end if
end within_32

--  Whether a part `got` of a complex result is within `bound` floats of
--  `want`, as `within` has it, save that beside a NaN part, the result's
--  `other`, it is compared by magnitude: Annex G leaves the sign of
--  nearly every zero or infinity beside a NaN unspecified.
within_part_64: (got: f64, want: u64, other: u64, bound: u64) -> (yes: bool) =
    if other & 0x7fffffffffffffff > 0x7ff0000000000000 then
        yes = within_64(from_64(bits_64(got) & 0x7fffffffffffffff), want & 0x7fffffffffffffff,
                        bound)
    else
        yes = within_64(got, want, bound)
    end if
end within_part_64

within_part_32: (got: f32, want: u32, other: u32, bound: u32) -> (yes: bool) =
    if other & 0x7fffffff > 0x7f800000 then
        yes = within_32(from_32(bits_32(got) & 0x7fffffff), want & 0x7fffffff, bound)
    else
        yes = within_32(got, want, bound)
    end if
end within_part_32

