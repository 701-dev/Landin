call_2: (z: complex.number(f32)) -> (result: complex.number(f32)) =
    result = complex.exp(z)
end call_2

run_32_z_z: (cases: []u32, routine: (z: complex.number(f32)) -> (result: complex.number(f32)),
             bound: u32) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        z: complex.number(f32) = (real: from_32(cases[at + 0]), imaginary: from_32(cases[at + 1]))
        got := routine(z)
        if not within_part_32(got.real, cases[at + 2], cases[at + 3], bound)
          or not within_part_32(got.imaginary, cases[at + 3], cases[at + 2], bound) then
            failures = failures + 1
        end if
        at = at + 4
    end while
end run_32_z_z

run_64_z_z: (cases: []u64, routine: (z: complex.number(f64)) -> (result: complex.number(f64)),
             bound: u64) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        z: complex.number(f64) = (real: from_64(cases[at + 0]), imaginary: from_64(cases[at + 1]))
        got := routine(z)
        if not within_part_64(got.real, cases[at + 2], cases[at + 3], bound)
          or not within_part_64(got.imaginary, cases[at + 3], cases[at + 2], bound) then
            failures = failures + 1
        end if
        at = at + 4
    end while
end run_64_z_z

public main: () -> (code: i32) =
    code = 42
    if run_64_z_z(cases_1, call_1, 3) <> 0 and code == 42 then
        code = 1
    end if
    if run_32_z_z(cases_2, call_2, 3) <> 0 and code == 42 then
        code = 2
    end if
end main
