--  Count the lines of the file named by the first argument, as `wc -l`
--  does, and a last line without a newline too.  A failure is said in words on standard error, and the program
--  then returns 1.
import core/args
import core/failure
import core/io
import core/mem
import core/text
import hosted/blocking
import hosted/heap

--- How many lines the file at `path` holds.  A last line without its
--- newline counts, and so does a line too long for the buffer.
count_lines: (host: blocking.host, path: text.os_string)
             -> (lines: u64) ! ... =
    lines = 0
    opened: io.file = try io.open_read(host, path)
    defer io.close(host, opened) else none
    mut buffer: [4096]u8 = zeroed
    mut reader := io.lines_over(host, opened, buffer)
    loop do
        item: io.line = io.read_line(reader) else (problem)
            fail problem when problem <> mem.out_of_memory
            inc lines
            continue
        end
        break when item.at_end
        inc lines
    end loop
end count_lines

--- Say on standard error what failed and why: `count: notes.log: not
--- found`.
complain: (host: blocking.host, subject: []u8, problem: failure.reason)
          -> none =
    words: []u8 = failure.words(problem)
    io.write_format(host, io.err(host), "count: {}: {}\n",
                    [any(addr subject), any(addr words)]) else none
end complain

public main: () -> (code: i32) =
    host := blocking.new()
    memory := heap.new()
    table: [1]args.argument = [args.positional("FILE", "the file to count")]
    program := args.command_of("count", "Count the lines of a file.",
                               table[0..<1])
    mut parsed := args.new()
    defer args.release(parsed, memory)
    args.parse_process(memory, host, program, parsed) else begin
        code = args.reply(memory, host, parsed)
        return
    end
    code = 1
    file := args.value_of(parsed, "FILE")
    lines := count_lines(host, file.bytes) else (problem)
        complain(host, text.os_string_bytes(file.bytes), problem)
        return
    end
    io.write_format(host, io.out(host), "{} lines\n", [any(addr lines)])
        else (problem)
        complain(host, "standard output", problem)
        return
    end
    code = 0
end main
