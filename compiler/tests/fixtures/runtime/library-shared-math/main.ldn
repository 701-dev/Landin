import core/math

--  A few routines at both widths, each result exact: the constants'
--  f32 conversions are the f32 values nearest the real numbers, and a
--  square root, a floor, a fused multiply-add and a split give what the
--  arithmetic says.
exercise: () -> (ok: bool) =
    ok = false
    two: f64 = 2.0
    return when f32(math.pi) <> 0x1.921fb6p1 or f32(math.e) <> 0x1.5bf0a8p1
      or f32(math.ln_2) <> 0x1.62e430p-1 or f32(math.sqrt_2) <> 0x1.6a09e6p0
    return when math.sqrt(two) <> math.sqrt_2 or math.sqrt(f32(two)) <> 0x1.6a09e6p0
    return when math.floor(-two / 3.0) <> -1.0 or math.round(f32(2.5)) <> 3.0
      or math.round_even(f32(2.5)) <> 2.0
    return when math.fma(0.1 * two / 2.0, 10.0, -1.0) <> 0x1.0p-54
    (fraction: fraction, power: power) := math.split(two * 3.0)
    return when fraction <> 0.75 or power <> 3
    ok = math.classify(math.scale(two, -1050)) == math.subnormal
         and math.is_nan(math.remainder(two, 0.0))
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise()
    if ok then
        code = 42
    end if
end main
