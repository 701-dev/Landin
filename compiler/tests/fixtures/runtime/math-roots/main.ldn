run_8: () -> (failures: u32) =
    --  fma at f32, within 0 of the correctly rounded result
    failures = 0
    mut at: usize = 0
    while at < lenof cases_8 do
        x := from_32(cases_8[at + 0])
        y := from_32(cases_8[at + 1])
        z := from_32(cases_8[at + 2])
        if not within_32(math.fma(x, y, z), cases_8[at + 3], 0) then
            failures = failures + 1
        end if
        at = at + 4
    end while
end run_8

public main: () -> (code: i32) =
    code = 42
    if run_1() <> 0 and code == 42 then
        code = 1
    end if
    if run_2() <> 0 and code == 42 then
        code = 2
    end if
    if run_3() <> 0 and code == 42 then
        code = 3
    end if
    if run_4() <> 0 and code == 42 then
        code = 4
    end if
    if run_5() <> 0 and code == 42 then
        code = 5
    end if
    if run_6() <> 0 and code == 42 then
        code = 6
    end if
    if run_7() <> 0 and code == 42 then
        code = 7
    end if
    if run_8() <> 0 and code == 42 then
        code = 8
    end if
end main
