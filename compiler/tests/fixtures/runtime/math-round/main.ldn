run_32_1: (cases: []u32, routine: (x: f32) -> (result: f32),
           bound: u32) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        x := from_32(cases[at + 0])
        if not within_32(routine(x), cases[at + 1], bound) then
            failures = failures + 1
        end if
        at = at + 2
    end while
end run_32_1

run_64_1: (cases: []u64, routine: (x: f64) -> (result: f64),
           bound: u64) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        x := from_64(cases[at + 0])
        if not within_64(routine(x), cases[at + 1], bound) then
            failures = failures + 1
        end if
        at = at + 2
    end while
end run_64_1

public main: () -> (code: i32) =
    code = 42
    if run_64_1(cases_1, call_1, 0) <> 0 and code == 42 then
        code = 1
    end if
    if run_32_1(cases_2, call_2, 0) <> 0 and code == 42 then
        code = 2
    end if
    if run_64_1(cases_3, call_3, 0) <> 0 and code == 42 then
        code = 3
    end if
    if run_32_1(cases_4, call_4, 0) <> 0 and code == 42 then
        code = 4
    end if
end main
