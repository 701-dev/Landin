    0xffffffff, 0xffffffff, 0x00000000, 0x00000000, 0x00000010, 0x00000003,
    0xffffffff, 0xffffffff, 0xffffffff, 0x00000000, 0x00000000, 0x00000000,
    0x00000000, 0x00000003, 0xffffffff, 0xffffffff, 0xffffffff, 0x00000000,
    0x00000000, 0x00000011, 0x00000003, 0xffffffff, 0xffffffff, 0xffffffff,
    0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000,
    0x00000001, 0x0000000f, 0x00000003, 0xffffffff, 0xffffffff, 0xffffffff,
    0x00000000, 0x00000000, 0x00000021, 0x00000000, 0x00000005, 0x00000000,
    0xfffffffe, 0xffffffff, 0xffffffff, 0x00000001, 0x00000000, 0x00000000,
    0x00000010, 0x00000003, 0xffffffff, 0xffffffff, 0xffffffff, 0x00000000,
    0x00000000, 0x00000021, 0x00000000, 0x00000002, 0xffffffff, 0x7fffffff,
    0x00000000, 0x00000000, 0x00000011, 0x00000003, 0xffffffff, 0xffffffff,
    0xffffffff, 0x00000000, 0x00000000, 0x00000021, 0x00000000, 0x00000000,
    0x00000000, 0x00000001, 0x0000000f, 0x00000003, 0xffffffff, 0xffffffff,
    0xffffffff, 0x00000000, 0x00000000, 0x0000002e, 0x00000000, 0x00000005,
    0x00000000, 0xffffc000, 0xffffffff, 0xffffffff, 0x00003fff, 0x00000000,
    0x00000000, 0x00000010, 0x00000003, 0xffffffff, 0xffffffff, 0xffffffff,
    0x00000000, 0x00000000, 0x0000002e, 0x00000000, 0x00000002, 0xffffffff,
    0x0003ffff, 0x00000000, 0x00000000, 0x00000011, 0x00000003, 0xffffffff,
    0xffffffff, 0xffffffff, 0x00000000, 0x00000000, 0x0000002e, 0x00000000,
    0x00000000, 0x00000000, 0x00000001, 0x0000010f, 0x00000003, 0xffffffff,
    0xffffffff, 0xffffffff, 0x00000000, 0x00000000, 0x00000018, 0x00000000,
    0x00000004, 0xff000000, 0xffffffff, 0xffffffff, 0x00ffffff, 0x00000000,
    0x00000000, 0x00000110, 0x00000003, 0xffffffff, 0xffffffff, 0xffffffff,
    0x00000000, 0x00000000, 0x00000018, 0x00000000, 0x00000003, 0xffffffff,
    0xffffffff, 0x000000ff, 0x00000000, 0x00000000, 0x00000012, 0x00000003,
    0xffffffff, 0xffffffff, 0xffffffff, 0x00000000, 0x00000000, 0x00000000,
    0x00000000, 0x00000000, 0x00000000, 0x00000060]

--  A signed number from `table` at `at` into `into`, `at` moved past it.
take: (provider: type is mem.allocator, table: []u32, inout at: usize,
       inout into: big.integer, memory: provider)
      -> none ! mem.out_of_memory =
    header: u32 = table[at]
    count: usize = usize(header & 0x7fffffff)
    inc at
    try big.set_limbs(into, memory, table[at..<at + count], header >> 31 == 1)
    at = at + count
end take

--  Whether `value` is the signed number `want`.
equals: (value: big.integer, want: big.integer) -> (yes: bool) =
    yes = big.compare(value, want) == cmp.equal
          and same(big.limbs_of(value), big.limbs_of(want))
end equals

--  Whether one record, from `at`, agrees.
agrees: (provider: type is mem.allocator, inout at: usize, memory: provider)
        -> (yes: bool) ! mem.out_of_memory =
    yes = false
    op: u32 = cases[at]
    inc at
    mut a := big.new()
    mut b := big.new()
    mut c := big.new()
    try take(cases, at, a, memory)
    try take(cases, at, b, memory)
    try take(cases, at, c, memory)
    p: u64 = u64(cases[at]) | (u64(cases[at + 1]) << 32)
    at = at + 2
    mut want := big.new()
    mut also := big.new()
    try take(cases, at, want, memory)
    try take(cases, at, also, memory)
    word: u32 = cases[at]
    inc at
    mut r := big.new()
    s := big.new()
    mut w: u32 = 0
    if op == 0xb then
        try big.and_bits(r, memory, a, b)
    elsif op == 0xc then
        try big.or_bits(r, memory, a, b)
    elsif op == 0xd then
        try big.xor_bits(r, memory, a, b)
    elsif op == 0xe then
        try big.complement(r, memory, a)
    elsif op == 0xf then
        try big.shift_left(r, memory, a, usize(p))
    elsif op == 0x10 then
        try big.shift_right(r, memory, a, usize(p))
    elsif op == 0x11 then
        w = if big.bit(a, usize(p)) then 1 else 0 end if
    elsif op == 0x12 then
        w = u32(big.bit_length(a))
    elsif op == 0x10b then
        try big.set(r, memory, a)
        try big.and_bits(r, memory, r, b)
    elsif op == 0x10d then
        try big.set(r, memory, a)
        try big.xor_bits(r, memory, r, b)
    elsif op == 0x10f then
        try big.set(r, memory, a)
        try big.shift_left(r, memory, r, usize(p))
    elsif op == 0x110 then
        try big.set(r, memory, a)
        try big.shift_right(r, memory, r, usize(p))
    end if
    yes = w == word and equals(r, want) and equals(s, also)
end agrees

--  Whether every record of `cases` agrees, each in an empty arena.
run_cases: () -> (ok: bool) =
    ok = true
    mut at: usize = 0
    while at < lenof cases do
        mut space: arena.space = zeroed
        memory := arena.over_unchecked(space, addr backing[0], 4096)
        agreed := agrees(at, memory) else false
        if not agreed then
            ok = false
            return
        end if
    end while
end run_cases

public main: () -> (code: i32) =
    code = 42
    if not run_cases() then
        code = 1
    end if
end main
