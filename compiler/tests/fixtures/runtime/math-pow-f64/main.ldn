call_1: (x: f64, y: f64) -> (result: f64) =
    result = math.pow(x, y)
end call_1

run_64_2: (cases: []u64, routine: (x: f64, y: f64) -> (result: f64),
           bound: u64) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        x := from_64(cases[at + 0])
        y := from_64(cases[at + 1])
        if not within_64(routine(x, y), cases[at + 2], bound) then
            failures = failures + 1
        end if
        at = at + 3
    end while
end run_64_2

public main: () -> (code: i32) =
    code = 42
    if run_64_2(cases_1, call_1, 1) <> 0 and code == 42 then
        code = 1
    end if
end main
