--  Generated by scripts/big_oracle.py: edit that and run
--  `python3 scripts/big_oracle.py fixtures`, never this file.
--  core/big's integers against Python's: decimal and hexadecimal text written and read back, and text that is no number refused.
--  Each record of `cases` holds an operation, three signed operands, a
--  parameter and the results Python's integers give; an operation numbered
--  from 0x100 writes its result over its first operand's own value.  Every
--  record runs in an arena that starts empty, and the program exits 42
--  when every result agrees, 1 when a record does not and 3 when text that is no number is not refused.
import core/arena
import core/big
import core/cmp
import core/mem
import core/text

mut backing: [4096]u8 = zeroed
mut buffer: [512]u8 = zeroed

--  FNV-1a over bytes, 32 bits.
digest_text: (values: []u8) -> (hash: u32) =
    hash = 0x811c9dc5
    for value in values do
        hash = (hash ^ u32(value)) *% 0x01000193
    end for
end digest_text

--  Whether two runs of limbs are the same limbs.
same: (left: []u32, right: []u32) -> (yes: bool) =
    yes = lenof left == lenof right
    return when not yes
    for value, at in left do
        if value <> right[at] then
            yes = false
            return
        end if
    end for
end same

cases: [168]u32 = [
    0x0000001d, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000,
    0x00000000, 0x00000000, 0x350ca8af, 0x0000001e, 0x00000000, 0x00000000,
    0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x350ca8af,
    0x0000001d, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000,
    0x00000000, 0x00000000, 0x350ca8af, 0x0000001e, 0x00000000, 0x00000000,
    0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x350ca8af,
    0x0000001d, 0x80000001, 0xffffffff, 0x00000000, 0x00000000, 0x00000000,
    0x00000000, 0x00000000, 0x00000000, 0xc9e98acf, 0x0000001e, 0x80000001,
    0xffffffff, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000,
    0x00000000, 0x97662668, 0x0000001d, 0x00000001, 0x9d74ae73, 0x00000000,
    0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0xd68ccc33,
    0x0000001e, 0x00000001, 0x9d74ae73, 0x00000000, 0x00000000, 0x00000000,
    0x00000000, 0x00000000, 0x00000000, 0xac12cffb, 0x0000001d, 0x80000002,
    0x24a4ff25, 0x613c3fe2, 0x00000000, 0x00000000, 0x00000000, 0x00000000,
    0x00000000, 0x00000000, 0x28c44232, 0x0000001e, 0x80000002, 0x24a4ff25,
    0x613c3fe2, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000,
    0x00000000, 0xb957a213, 0x0000001d, 0x00000002, 0x2ef304e5, 0x7c2c4761,
    0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000,
    0x3228dafc, 0x0000001e, 0x00000002, 0x2ef304e5, 0x7c2c4761, 0x00000000,
    0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0xa07b8b9c,
    0x0000001d, 0x00000003, 0x5c0e4661, 0x23d10d37, 0x03218a4e, 0x00000000,
    0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0xdae4d35f,
    0x0000001e, 0x00000003, 0x5c0e4661, 0x23d10d37, 0x03218a4e, 0x00000000,
    0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0xb2f0e28d,
