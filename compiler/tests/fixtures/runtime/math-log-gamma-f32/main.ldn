--  Generated by scripts/math_oracle.py from compiler/tests/math/cases/special.json: edit that and run
--  `python3 scripts/math_oracle.py fixtures math-log-gamma-f32`, never this file.
--  Each table holds inputs and MPFR's correctly rounded result for them;
--  the program exits 42 when every result core/math gives is within the
--  table's bound of it, counted in floats, and otherwise with the number
--  of the first table that was not, from 1.
import core/math

--  Reading and comparing bits, written here rather than taken from
--  core/math, so that the check does not lean on what it checks.
bits_64: (x: f64) -> (bits: u64) =
    view: ptr u64 = ptr(usize(addr x))
    bits = view.val
end bits_64

from_64: (bits: u64) -> (x: f64) =
    view: ptr f64 = ptr(usize(addr bits))
    x = view.val
end from_64

bits_32: (x: f32) -> (bits: u32) =
    view: ptr u32 = ptr(usize(addr x))
    bits = view.val
end bits_32

from_32: (bits: u32) -> (x: f32) =
    view: ptr f32 = ptr(usize(addr bits))
    x = view.val
end from_32

--  A float's place in the order of all floats: the next float up is one
--  more, and both zeros are one place.
place_64: (bits: u64) -> (key: u64) =
    key = if bits >> 63 == 1 then 0x8000000000000000 - (bits & 0x7fffffffffffffff)
          else 0x8000000000000000 + bits end if
end place_64

place_32: (bits: u32) -> (key: u32) =
    key = if bits >> 31 == 1 then 0x80000000 - (bits & 0x7fffffff)
          else 0x80000000 + bits end if
end place_32

--  Whether `got` is within `bound` floats of the correctly rounded
--  `want`: NaN only for NaN, an infinity only for itself, and a zero's
--  sign kept.
within_64: (got: f64, want: u64, bound: u64) -> (yes: bool) =
    expected := from_64(want)
    have := bits_64(got)
    if expected <> expected or got <> got then
        yes = expected <> expected and got <> got
    elsif want & 0x7fffffffffffffff == 0x7ff0000000000000
      or have & 0x7fffffffffffffff == 0x7ff0000000000000 then
        yes = have == want
    elsif (expected == 0.0 or got == 0.0) and have >> 63 <> want >> 63 then
        yes = false
    else
        a := place_64(have)
        b := place_64(want)
        yes = (if a > b then a - b else b - a end if) <= bound
    end if
end within_64

within_32: (got: f32, want: u32, bound: u32) -> (yes: bool) =
    expected := from_32(want)
    have := bits_32(got)
    if expected <> expected or got <> got then
        yes = expected <> expected and got <> got
    elsif want & 0x7fffffff == 0x7f800000 or have & 0x7fffffff == 0x7f800000 then
        yes = have == want
    elsif (expected == 0.0 or got == 0.0) and have >> 31 <> want >> 31 then
        yes = false
    else
        a := place_32(have)
        b := place_32(want)
        yes = (if a > b then a - b else b - a end if) <= bound
    end if
end within_32

--  log_gamma at f32: the specials, 24 random inputs and the 12 hardest to round of 20000

cases_1: [118]u32 = [
    0x00000000, 0x7f800000, 0x80000000, 0x7f800000, 0x7f800000, 0x7f800000,
    0xff800000, 0x7f800000, 0x7fc00000, 0xffc00000, 0x00000001, 0x42ce8ed0,
    0x80000001, 0x42ce8ed0, 0x00800000, 0x42aeac50, 0x7f7fffff, 0x7f800000,
    0xff7fffff, 0x7f800000, 0x3f800000, 0x00000000, 0x40000000, 0x00000000,
    0x40400000, 0x3f317218, 0x3f000000, 0x3f128682, 0xbf000000, 0x3fa1fc4d,
    0xbf800000, 0x7f800000, 0xc0000000, 0x7f800000, 0xbfc00000, 0x3f5c2c0b,
    0x41000000, 0x41086710, 0x3fbb16c3, 0xbdf8cdce, 0x32000000, 0x4195b844,
    0x4d000000, 0x4f0db844, 0xcb000000, 0x7f800000, 0x40e0ef5b, 0x40d44a06,
    0x3d497c4c, 0x403f140d, 0xbf9bd1e4, 0x3fbfd72d, 0x40df18db, 0x40d0d8d8,
    0x08891802, 0x42985ae8, 0xbf9e6ab2, 0x3fb4fa01, 0x410abe91, 0x411e86ab,
    0x41775e89, 0x41d37111, 0xbdaf3c01, 0x4020e82e, 0x41153e5f, 0x4134ff83,
    0x51ccca9e, 0x541c4d67, 0xbe602b5f, 0x3fd84b59, 0x3f4df79c, 0x3e173a5e,
    0x3905dd6f, 0x410f74e5, 0xbfefac7c, 0x3fc0f410, 0x40943bd1, 0x4028efdd,
    0x39ce2e70, 0x40fae7f1, 0xbfa675b5, 0x3f99bea8, 0x40816bcc, 0x3fec8565,
    0x1231996f, 0x427afede, 0xbe950ff9, 0x3fbdf7cf, 0x40f05da4, 0x40f1cfe2,
    0x7d0167db, 0x7f800000, 0xbe73350d, 0x3fd050ef, 0x7a52de06, 0x7d84c6b8,
    0x410eaa89, 0x4126d32d, 0xbf885f12, 0x402d22c5, 0xbff1754b, 0x3fcd7e8c,
    0x1da8fb9d, 0x423b6ccb, 0x72ee65b5, 0x7602f996, 0x3f3f3f7c, 0x3e536ff1,
    0xbf274ee8, 0x3faf6d33, 0x1678ce6c, 0x4263775e, 0x407e0c0e, 0x3fe074bc,
    0x410741df, 0x41173ede, 0xbfeceb95, 0x3fb0a8c6]

call_1: (x: f32) -> (result: f32) =
    result = math.log_gamma(x)
end call_1

run_32_1: (cases: []u32, routine: (x: f32) -> (result: f32),
           bound: u32) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        x := from_32(cases[at + 0])
        if not within_32(routine(x), cases[at + 1], bound) then
            failures = failures + 1
        end if
        at = at + 2
    end while
end run_32_1

public main: () -> (code: i32) =
    code = 42
    if run_32_1(cases_1, call_1, 4) <> 0 and code == 42 then
        code = 1
    end if
end main
