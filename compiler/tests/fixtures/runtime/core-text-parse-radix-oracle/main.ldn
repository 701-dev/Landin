--  Generated by scripts/text_fixtures.py; do not edit it.
--  Every width from u8 to i64 and every radix from 2 to 36
--  parses edge magnitudes the program writes in the radix, bare,
--  with the prefix that names the radix in either case, or `0x` where
--  none does, signed where the width is, and with one more digit or a
--  digit the radix lacks after them; the digest of every outcome is
--  the one Python's `int` and each width's range give.

import core/text

--  Firmware parses every 7th radix, within the emulator's
--  session; a hosted target parses them all.
fixed if compiler.os == freestanding then
    stride: u32 = 7
    expected: u32 = 0x464032a6
else
    stride: u32 = 1
    expected: u32 = 0x0d22da70
end if

magnitudes: [20]u64 = [
    0x0, 0x1, 0x9, 0x7f, 0x80, 0xff, 0x100, 0x7fff, 0x8000, 0xffff, 0x10000,
    0x7fffffff, 0x80000000, 0xffffffff, 0x100000000, 0x7fffffffffffffff,
    0x8000000000000000, 0xffffffffffffffff, 0x123456789abcdef0, 0x12d687
]
digits: []u8 = "0123456789abcdefghijklmnopqrstuvwxyz"

--  FNV-1a, 32 bits: fold one byte into the digest.
feed: (inout state: u32, value: u8) -> none =
    state = (state ^ u32(value)) *% 0x01000193
end feed

--  Fold an outcome into the digest: its code, then its value's eight
--  bytes, the lowest first.
feed_outcome: (inout state: u32, code: u8, value: u64) -> none =
    feed(state, code)
    mut shift: u64 = 0
    while shift < 64 do
        feed(state, u8((value >> shift) & 0xff))
        shift += 8
    end while
end feed_outcome

--  Write the text a case parses into `storage`: the sign, the prefix
--  variant, `magnitude`'s digits in `radix` and the suffix variant, and
--  say how many bytes it took.
case_text: (storage: []mut u8, negative: bool, prefix: u8, magnitude: u64,
            radix: u32, suffix: u8) -> (count: usize) =
    count = 0
    if negative then
        storage[count] = u8('-')
        inc count
    end if
    if prefix > 0 then
        mark: u8 = if radix == 16 then
                       u8('x')
                   elsif radix == 8 then
                       u8('o')
                   elsif radix == 2 then
                       u8('b')
                   else
                       u8('x')
                   end if
        storage[count] = u8('0')
        storage[count + 1] = if prefix == 1 then mark else mark - 32 end if
        count += 2
    end if
    mut reversed: [64]u8 = zeroed
    mut length: usize = 0
    mut left: u64 = magnitude
    loop do
        reversed[length] = digits[usize(left % u64(radix))]
        inc length
        left /= u64(radix)
        break when left == 0
    end loop
    while length > 0 do
        dec length
        storage[count] = reversed[length]
        inc count
    end while
    if suffix == 1 then
        storage[count] = u8('0')
        inc count
    elsif suffix == 2 then
        storage[count] = if radix < 36 then digits[usize(radix)] else u8('_') end if
        inc count
    end if
end case_text

--  Parse `source` in `radix` at width `width`, the order of the
--  generator's list, and fold the outcome into the digest.
parse: (inout state: u32, width: u32, source: []u8, radix: u32) -> none =
    mut code: u8 = 0
    mut value: u64 = 0
    if width == 0 then
        found := text.parse_radix_u8(source, radix) else (problem)
            code = if problem == text.invalid_number then 1 else 2 end if
            feed_outcome(state, code, 0)
            return
        end
        value = u64(found)
    elsif width == 1 then
        found := text.parse_radix_u16(source, radix) else (problem)
            code = if problem == text.invalid_number then 1 else 2 end if
            feed_outcome(state, code, 0)
            return
        end
        value = u64(found)
    elsif width == 2 then
        found := text.parse_radix_u32(source, radix) else (problem)
            code = if problem == text.invalid_number then 1 else 2 end if
            feed_outcome(state, code, 0)
            return
        end
        value = u64(found)
    elsif width == 3 then
        found := text.parse_radix_u64(source, radix) else (problem)
            code = if problem == text.invalid_number then 1 else 2 end if
            feed_outcome(state, code, 0)
            return
        end
        value = found
    elsif width == 4 then
        found := text.parse_radix_i8(source, radix) else (problem)
            code = if problem == text.invalid_number then 1 else 2 end if
            feed_outcome(state, code, 0)
            return
        end
        value = bits_of(i64(found))
    elsif width == 5 then
        found := text.parse_radix_i16(source, radix) else (problem)
            code = if problem == text.invalid_number then 1 else 2 end if
            feed_outcome(state, code, 0)
            return
        end
        value = bits_of(i64(found))
    elsif width == 6 then
        found := text.parse_radix_i32(source, radix) else (problem)
            code = if problem == text.invalid_number then 1 else 2 end if
            feed_outcome(state, code, 0)
            return
        end
        value = bits_of(i64(found))
    else
        found := text.parse_radix_i64(source, radix) else (problem)
            code = if problem == text.invalid_number then 1 else 2 end if
            feed_outcome(state, code, 0)
            return
        end
        value = bits_of(found)
    end if
    feed_outcome(state, 0, value)
end parse

--  The two's complement bits of `value`.
bits_of: (value: i64) -> (bits: u64) =
    bits = if value >= 0 then
               u64(value)
           else
               u64(0 -% 1) - u64(0 - (value + 1))
           end if
end bits_of

public main: () -> (code: i32) =
    code = 1
    mut state: u32 = 0x811c9dc5
    mut storage: [80]u8 = zeroed
    mut width: u32 = 0
    while width < 8 do
        signs: u8 = if width >= 4 then 2 else 1 end if
        mut radix: u32 = 2
        while radix <= 36 do
            for magnitude in magnitudes do
                mut sign: u8 = 0
                while sign < signs do
                    mut prefix: u8 = 0
                    while prefix < 3 do
                        mut suffix: u8 = 0
                        while suffix < 3 do
                            count: usize = case_text(storage, sign == 1,
                                                     prefix, magnitude, radix,
                                                     suffix)
                            parse(state, width, storage[0..<count], radix)
                            inc suffix
                        end while
                        inc prefix
                    end while
                    inc sign
                end while
            end for
            radix += stride
        end while
        inc width
    end while
    if state == expected then
        code = 42
    end if
end main
