--  FNV-1a over 32-bit words, the digest the generator computes alike.
digest: (values: []u32) -> (hash: u64) =
    hash = 0xcbf29ce484222325
    for value in values do
        hash = (hash ^ u64(value)) *% 0x100000001b3
    end for
end digest

