import core/mem
import core/tree

exercise: () -> (ok: bool) ! mem.not_found =
    ok = false
    value := tree.new()
    return when tree.length(value) <> 0 or tree.ordinal(tree.id(usize(42))) <> 42
    _ = tree.get(value, tree.id(usize(0))) else (problem)
        ok = problem == mem.not_found
        return
    end
end exercise

public main: () -> (code: i32) =
    code = 1
    ok := exercise() else false
    if ok then
        code = 42
    end if
end main
