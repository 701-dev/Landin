--  Generated by scripts/unicode_tables.py from the Unicode Character
--  Database 18.0.0; do not edit it.  Every scalar, as a
--  text of its own, compares without case as the database's full case
--  folding says: the digest of whether it equals its full upper, lower
--  and folded mappings, whether those equal each other and the next
--  scalar, whether its upper mapping begins and its lower mapping ends
--  with it, and whether it begins with the next scalar, is the
--  database's.

import core/text
import core/unicode

--  Firmware walks every 61st scalar, within the emulator's
--  session; a hosted target walks them all.
fixed if compiler.os == freestanding then
    stride: u32 = 61
    expected: u32 = 0x3b9dccca
else
    stride: u32 = 1
    expected: u32 = 0xb417e4c2
end if

--  FNV-1a, 32 bits: fold one byte into the digest.
feed: (inout state: u32, value: u8) -> none =
    state = (state ^ u32(value)) *% 0x01000193
end feed

--  The text of `scalar` alone, encoded over `storage`.
alone: (scalar: u32, storage: []mut u8) -> (result: utf8 from storage) =
    count: usize = text.encode(scalar, storage) else begin
        compiler.unreachable()
    end
    result = text.from_bytes(storage[0..<count]) else begin
        compiler.unreachable()
    end
end alone

--  The scalar after `scalar`, past the surrogates, and zero after the
--  last.
neighbour: (scalar: u32) -> (next: u32) =
    next = if scalar == 0xd7ff then
               0xe000
           elsif scalar == 0x10ffff then
               0
           else
               scalar + 1
           end if
end neighbour

--  One bit for each answer that holds, the first the lowest.
bit: (answer: bool, place: u8) -> (value: u8) =
    value = if answer then u8(1) << place else 0 end if
end bit

public main: () -> (code: i32) =
    code = 1
    mut state: u32 = 0x811c9dc5
    mut encoded: [4]u8 = zeroed
    mut beside: [4]u8 = zeroed
    mut upper_storage: [64]u8 = zeroed
    mut lower_storage: [64]u8 = zeroed
    mut fold_storage: [64]u8 = zeroed
    mut scalar: u32 = 0
    while scalar <= 0x10ffff do
        if scalar >= 0xd800 and scalar <= 0xdfff then
            scalar = 0xe000
        end if
        source: utf8 = alone(scalar, encoded)
        partner: utf8 = alone(neighbour(scalar), beside)
        mut into_upper: text.utf8_builder = text.utf8_over(upper_storage)
        unicode.append_upper(into_upper, source) else begin return end
        upper: utf8 = text.utf8_used(into_upper)
        mut into_lower: text.utf8_builder = text.utf8_over(lower_storage)
        unicode.append_lower(into_lower, source) else begin return end
        lower: utf8 = text.utf8_used(into_lower)
        mut into_fold: text.utf8_builder = text.utf8_over(fold_storage)
        unicode.append_folded(into_fold, source) else begin return end
        fold: utf8 = text.utf8_used(into_fold)
        feed(state, bit(unicode.equal_caseless(source, upper), 0)
                    | bit(unicode.equal_caseless(source, lower), 1)
                    | bit(unicode.equal_caseless(source, fold), 2)
                    | bit(unicode.equal_caseless(upper, lower), 3)
                    | bit(unicode.equal_caseless(source, partner), 4)
                    | bit(unicode.starts_with_caseless(upper, source), 5)
                    | bit(unicode.ends_with_caseless(lower, source), 6)
                    | bit(unicode.starts_with_caseless(source, partner), 7))
        scalar += stride
    end while
    if state == expected then
        code = 42
    end if
end main
