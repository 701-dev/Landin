call_2: (z: complex.number(f32), w: complex.number(f32)) -> (result: complex.number(f32)) =
    result = complex.pow(z, w)
end call_2

run_32_zz_z_norm: (cases: []u32, routine: (z: complex.number(f32), w: complex.number(f32)) -> (result: complex.number(f32)),
                   bound: u32) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        z: complex.number(f32) = (real: from_32(cases[at + 0]), imaginary: from_32(cases[at + 1]))
        w: complex.number(f32) = (real: from_32(cases[at + 2]), imaginary: from_32(cases[at + 3]))
        larger := larger_32(cases[at + 4], cases[at + 5])
        got := routine(z, w)
        if not within_norm_32(got.real, cases[at + 4], cases[at + 5], larger, bound)
          or not within_norm_32(got.imaginary, cases[at + 5], cases[at + 4], larger, bound) then
            failures = failures + 1
        end if
        at = at + 6
    end while
end run_32_zz_z_norm

run_64_zz_z_norm: (cases: []u64, routine: (z: complex.number(f64), w: complex.number(f64)) -> (result: complex.number(f64)),
                   bound: u64) -> (failures: u32) =
    failures = 0
    mut at: usize = 0
    while at < lenof cases do
        z: complex.number(f64) = (real: from_64(cases[at + 0]), imaginary: from_64(cases[at + 1]))
        w: complex.number(f64) = (real: from_64(cases[at + 2]), imaginary: from_64(cases[at + 3]))
        larger := larger_64(cases[at + 4], cases[at + 5])
        got := routine(z, w)
        if not within_norm_64(got.real, cases[at + 4], cases[at + 5], larger, bound)
          or not within_norm_64(got.imaginary, cases[at + 5], cases[at + 4], larger, bound) then
            failures = failures + 1
        end if
        at = at + 6
    end while
end run_64_zz_z_norm

public main: () -> (code: i32) =
    code = 42
    if run_64_zz_z_norm(cases_1, call_1, 15) <> 0 and code == 42 then
        code = 1
    end if
    if run_32_zz_z_norm(cases_2, call_2, 15) <> 0 and code == 42 then
        code = 2
    end if
end main
