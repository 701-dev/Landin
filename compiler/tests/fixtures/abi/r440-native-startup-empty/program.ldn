import core/io
import core/mem
import core/text
import hosted/blocking

-- C initialized the root with only the program name: the world exists, its
-- sequence is empty, and asking for an argument refuses rather than traps.
public extern(c) l_root: () -> (ok: bool) =
    state: blocking.host = blocking.new()
    ok = false
    return when io.arguments_length(state) <> 0
    value: text.os_string = io.argument(state, usize(0)) else (problem)
        ok = problem == mem.not_found
        return
    end
    _ = text.os_string_bytes(value)
end l_root
