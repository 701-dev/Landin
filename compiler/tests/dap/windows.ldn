--  main.ldn's program for Windows, which compiler/tests/dap/session.py
--  debugs through refine dap there.  It is main.ldn without its first
--  line of output, which needs an Io provider that Windows does not have
--  yet; its stops, frames, values and exit status are main.ldn's.  Each
--  `-- @NAME` comment marks the line the session stops on.
import core/panic

--  Windows' own end of a process, which kernel32 gives; platform/windows,
--  linked into every Windows program, names kernel32.
link(symbol: "ExitProcess") extern(c) stop: (status: i32) -> noreturn

point: type = struct
    x: i32
    y: i32
end point

public panic_handler: (kind: panic.panic_kind, site: u32) -> noreturn =
    if kind <> panic.overflow then stop(1) end if  -- @handler
    stop(42)
end panic_handler

add: (a: i32, b: i32) -> (sum: i32) =
    total: i32 = a + b  -- @add
    sum = total  -- @after-add
end add

crash: (value: u8) -> (result: u8) =
    mut high: u8 = 250
    high += value  -- @crash
    result = high
end crash

public main: () -> (code: i32) =
    p: point = (x: 3, y: 4)
    sum: i32 = add(p.x, p.y)  -- @call
    code = sum + p.x + i32(crash(9))
end main
