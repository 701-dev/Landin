--  A Cortex-M0 size probe, compiler/tests/float-text/README.md: format-u32.
import core/cmp
import core/text

public main: () -> (code: i32) =
    code = 1
    mut storage: [64]u8 = zeroed
    mut line := text.over(storage[0..<64])
    value: u32 = 7
    text.format(line, "{}", [any(addr value)]) else begin return end
    return when text.length(line) <> 1
    code = 42
end main
