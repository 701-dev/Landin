--  A million f64s drawn from core/random's xoshiro256** seeded with 7,
--  shaped as the float-text fixtures shape them, each written as its
--  shortest text, rounded to a drawn number of places both ways, and each
--  of those read back: `drawn` prints one line a value, its bits, the
--  three texts and the three readings' bits, an unread text's as -1.0's,
--  and scripts/float_text.py checks every line against Python's repr,
--  C's printf and Python's exact fractions.
import core/io
import core/random
import core/text
import hosted/blocking

shaped: (raw: u64) -> (bits: u64) =
    kind: u64 = raw & 3
    bits = if kind == 0 then raw
           elsif kind == 1 then (raw & 0x800fffffffffffff) | ((953 + (raw >> 2) % 141) << 52)
           elsif kind == 2 then raw & 0x801fffffffffffff
           else raw & 0xfffff00000000000 end if
end shaped

argument_number: (host: blocking.host, index: usize) -> (value: u64) =
    value = 1000000
    given := io.argument(host, index) else begin return end
    value = text.parse_u64(text.os_string_bytes(given)) else 1000000
end argument_number

public main: () -> (code: i32) =
    host := blocking.new()
    mut storage: [65536]u8 = zeroed
    mut out := io.buffered_over(host, io.out(host), storage)
    defer io.flush(out) else none
    mut source := random.new(7)
    count: u64 = argument_number(host, 0)
    for n in u64(0)..<count do
        _ = n
        bits: u64 = shaped(random.next(source))
        view: ptr f64 = ptr(usize(addr bits))
        v: f64 = view.val
        places: u64 = random.next(source) % 20
        mut space: [1400]u8 = zeroed
        mut line := text.over(space[0..<1400])
        text.append_hex_u64(line, bits) else none
        text.append_byte(line, u8(' ')) else none
        a: usize = text.length(line)
        text.append_f64(line, v) else none
        b: usize = text.length(line)
        text.append_byte(line, u8(' ')) else none
        text.append_f64_fixed(line, v, usize(places)) else none
        c: usize = text.length(line)
        text.append_byte(line, u8(' ')) else none
        text.append_f64_exponent(line, v, usize(places)) else none
        d: usize = text.length(line)
        mut copy: [1400]u8 = zeroed
        held: []u8 = text.used(line)
        for byte, at in held do
            copy[at] = byte
        end for
        first: f64 = text.parse_f64(copy[a..<b]) else 0.0
        second: f64 = text.parse_f64(copy[b + 1..<c]) else -1.0
        third: f64 = text.parse_f64(copy[c + 1..<d]) else -1.0
        results: [3]f64 = [first, second, third]
        for value in results do
            mut each: f64 = value
            view_each: ptr u64 = ptr(usize(addr each))
            text.append_byte(line, u8(' ')) else none
            text.append_hex_u64(line, view_each.val) else none
        end for
        text.append_byte(line, u8('\n')) else none
        bytes: []u8 = text.used(line)
        io.put(out, bytes) else none
    end for
    code = 0
end main
