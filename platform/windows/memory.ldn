--  The address space: what `virtual_query` says of a region, beside
--  windows.ldn's `virtual_alloc` and `virtual_free`, which the entry uses
--  too.  Windows reserves address space in units of its allocation
--  granularity, 64 KiB, and commits it in pages, 4 KiB on x86-64.

fixed if compiler.os == windows then
    --- The page `virtual_alloc` commits in.
    public page_bytes: usize = 4096

    --- The unit `virtual_alloc` reserves address space in.
    public allocation_granularity: usize = 65536

    --- `MEMORY_BASIC_INFORMATION`: the run of pages from `base` alike in
    --- state and protection, `size` bytes long, and the reservation
    --- `allocation_base` that holds them.
    public memory_information: type = struct
        base: usize
        allocation_base: usize
        allocation_protection: u32
        partition: u16
        reserved_1: u16
        size: usize
        state: u32
        protection: u32
        kind: u32
        reserved_2: u32
    end memory_information

    --- `MEM_RESERVE`, the state of pages reserved and not committed.
    public state_reserved: u32 = 0x2000

    --- Describe the pages at `address`, `VirtualQuery`, into `into`: the
    --- bytes written, or zero with the reason in `last_error`.
    public extern(c) link(symbol: "VirtualQuery") virtual_query:
        (address: usize, into: ptr mut memory_information, bytes: usize)
        -> (written: usize)

    --- `PROCESS_MEMORY_COUNTERS`: `size` is the structure's own, which the
    --- caller sets, and `peak_working_set` the most bytes the process has
    --- held resident at once.
    public memory_counters: type = struct
        size: u32
        page_faults: u32
        peak_working_set: usize
        working_set: usize
        quota_peak_paged_pool: usize
        quota_paged_pool: usize
        quota_peak_nonpaged_pool: usize
        quota_nonpaged_pool: usize
        page_file: usize
        peak_page_file: usize
    end memory_counters

    --- Describe the memory of `process`, `K32GetProcessMemoryInfo`, which
    --- kernel32 exports, into `into`, whose `size` the caller sets to
    --- `bytes`: nonzero, or zero with the reason in `last_error`.
    public extern(c) link(symbol: "K32GetProcessMemoryInfo") process_memory:
        (process: handle, into: ptr mut memory_counters, bytes: u32)
        -> (succeeded: i32)
end if
