--  Files, directories and the console: kernel32's calls on a path or an
--  open file's handle, raw.  A path is a terminated wide string, which
--  wide.ldn's `terminate` makes from a host string.

fixed if compiler.os == windows then
    --- `CreateFileW`'s access rights, `GENERIC_READ` and `GENERIC_WRITE`, and
    --- `FILE_READ_ATTRIBUTES`, which opens a file only to ask about it.
    public generic_read: u32 = 0x80000000
    public generic_write: u32 = 0x40000000
    public file_read_attributes: u32 = 0x80
    public file_write_attributes: u32 = 0x100
    public delete_access: u32 = 0x10000

    --- `FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE`: other opens
    --- may read, write, rename and delete the file while this one is open,
    --- as on a POSIX system.
    public share_all: u32 = 7

    --- `CreateFileW`'s dispositions.
    public create_new: u32 = 1
    public create_always: u32 = 2
    public open_existing: u32 = 3
    public open_always: u32 = 4
    public truncate_existing: u32 = 5

    --- `CreateFileW`'s attributes and flags: a plain file,
    --- `FILE_FLAG_BACKUP_SEMANTICS`, which a directory is opened with,
    --- `FILE_FLAG_OVERLAPPED`, `FILE_FLAG_WRITE_THROUGH`, and
    --- `FILE_FLAG_OPEN_REPARSE_POINT`, which opens a link rather than what it
    --- names.
    public attribute_normal: u32 = 0x80
    public flag_backup_semantics: u32 = 0x02000000
    public flag_overlapped: u32 = 0x40000000
    public flag_write_through: u32 = 0x80000000
    public flag_open_reparse_point: u32 = 0x00200000
    public flag_delete_on_close: u32 = 0x04000000

    --- A file's attribute bits: read-only, a directory and a reparse point,
    --- which a symbolic link is; and what `get_file_attributes` gives when it
    --- fails, all ones.
    public attribute_read_only: u32 = 0x1
    public attribute_directory: u32 = 0x10
    public attribute_reparse_point: u32 = 0x400
    public invalid_attributes: u32 = 0xFFFFFFFF

    --- Open or make the file `name` names, `CreateFileW`: its handle, or
    --- `invalid_handle` with the reason in `last_error`.  `security` is zero,
    --- so the handle is not inherited by a child, and `template` is zero.
    public extern(c) link(symbol: "CreateFileW") create_file:
        (name: ptr u16, access: u32, share: u32, security: usize,
         disposition: u32, flags: u32, template: usize) -> (result: handle)

    --- `FILE_TYPE_*`: what `get_file_type` says a handle is.
    public file_type_unknown: u32 = 0
    public file_type_disk: u32 = 1
    public file_type_char: u32 = 2
    public file_type_pipe: u32 = 3

    --- What kind of file `opened` is, `GetFileType`.
    public extern(c) link(symbol: "GetFileType") get_file_type:
        (opened: handle) -> (kind: u32)

    --- A time as Windows keeps it: hundreds of nanoseconds since 1601,
    --- `FILETIME`'s two halves.
    public file_time: type = struct
        low: u32
        high: u32
    end file_time

    --- What `get_file_information` fills: `BY_HANDLE_FILE_INFORMATION`.
    public file_information: type = struct
        attributes: u32
        created: file_time
        accessed: file_time
        written: file_time
        volume: u32
        size_high: u32
        size_low: u32
        links: u32
        index_high: u32
        index_low: u32
    end file_information

    --- Fill `found` with what the system keeps of `opened`,
    --- `GetFileInformationByHandle`: nonzero, or zero with the reason in
    --- `last_error`.
    public extern(c) link(symbol: "GetFileInformationByHandle")
        get_file_information:
        (opened: handle, found: ptr mut file_information) -> (done: i32)

    --- A path's attribute bits, `GetFileAttributesW`, or `invalid_attributes`
    --- with the reason in `last_error`.
    public extern(c) link(symbol: "GetFileAttributesW") get_file_attributes:
        (name: ptr u16) -> (attributes: u32)

    --- Set a path's attribute bits, `SetFileAttributesW`: nonzero, or zero
    --- with the reason in `last_error`.
    public extern(c) link(symbol: "SetFileAttributesW") set_file_attributes:
        (name: ptr u16, attributes: u32) -> (done: i32)

    --- Make the directory `name` names, `CreateDirectoryW`, with the
    --- default security: nonzero, or zero with the reason in `last_error`.
    public extern(c) link(symbol: "CreateDirectoryW") create_directory:
        (name: ptr u16, security: usize) -> (done: i32)

    --- Remove the empty directory `name` names, `RemoveDirectoryW`.
    public extern(c) link(symbol: "RemoveDirectoryW") remove_directory:
        (name: ptr u16) -> (done: i32)

    --- Remove the file `name` names, `DeleteFileW`.  A file another handle
    --- holds open with `share_all` is removed when the last is closed.
    public extern(c) link(symbol: "DeleteFileW") delete_file:
        (name: ptr u16) -> (done: i32)

    --- `MoveFileExW`'s flags: replace a file the new name holds, and do not
    --- return before the move is on the disk.
    public move_replace_existing: u32 = 1
    public move_write_through: u32 = 8

    --- Rename `old` to `new`, `MoveFileExW`: nonzero, or zero with the
    --- reason in `last_error`.
    public extern(c) link(symbol: "MoveFileExW") move_file:
        (old: ptr u16, new: ptr u16, flags: u32) -> (done: i32)

    --- The working directory into `into`'s `size` units with a NUL,
    --- `GetCurrentDirectoryW`: the units written, the NUL not counted; the
    --- units it needs, the NUL counted, when they do not fit; or zero with
    --- the reason in `last_error`.
    public extern(c) link(symbol: "GetCurrentDirectoryW") current_directory:
        (size: u32, into: ptr mut u16) -> (count: u32)

    --- Move `opened`'s position, `SetFilePointerEx`, from the start, the
    --- current position or the end, by `distance`; the new position goes to
    --- `moved` when it is not zero.
    public file_begin: u32 = 0
    public file_current: u32 = 1
    public file_end: u32 = 2
    public extern(c) link(symbol: "SetFilePointerEx") set_file_pointer:
        (opened: handle, distance: i64, moved: usize, method: u32)
        -> (done: i32)

    --- End `opened` at its position, `SetEndOfFile`.
    public extern(c) link(symbol: "SetEndOfFile") set_end_of_file:
        (opened: handle) -> (done: i32)

    --- Write what the system holds of `opened` to its disk,
    --- `FlushFileBuffers`.
    public extern(c) link(symbol: "FlushFileBuffers") flush_file_buffers:
        (opened: handle) -> (done: i32)

    --- The record an overlapped call takes: its offset, and the event that
    --- is set when it ends, or zero.  `OVERLAPPED`.
    public overlapped: type = struct
        internal: usize
        internal_high: usize
        offset_low: u32
        offset_high: u32
        event: handle
    end overlapped

    --- How an overlapped call on `opened` ended, `GetOverlappedResult`: the
    --- bytes it moved in `moved`, waiting for it when `wait` is nonzero.
    public extern(c) link(symbol: "GetOverlappedResult") overlapped_result:
        (opened: handle, record: ptr mut overlapped, moved: ptr mut u32,
         wait: i32) -> (done: i32)

    --- What `find_first_file` fills for each entry: `WIN32_FIND_DATAW`.
    public find_data: type = struct
        attributes: u32
        created: file_time
        accessed: file_time
        written: file_time
        size_high: u32
        size_low: u32
        reserved_0: u32
        reserved_1: u32
        name: [260]u16
        alternate: [14]u16
    end find_data

    --- Begin a directory's listing, `FindFirstFileW`, with `pattern` such as
    --- `dir\*`: the search's handle, its first entry in `found`, or
    --- `invalid_handle` with the reason in `last_error`, `error_file_not_found`
    --- for an empty match.
    public extern(c) link(symbol: "FindFirstFileW") find_first_file:
        (pattern: ptr u16, found: ptr mut find_data) -> (search: handle)

    --- The search's next entry, `FindNextFileW`: nonzero, or zero with
    --- `error_no_more_files` at the end.
    public extern(c) link(symbol: "FindNextFileW") find_next_file:
        (search: handle, found: ptr mut find_data) -> (done: i32)

    --- End a search, `FindClose`.
    public extern(c) link(symbol: "FindClose") find_close:
        (search: handle) -> (done: i32)

    --- The mode of a console handle, `GetConsoleMode`: nonzero for a
    --- console, zero with the reason in `last_error` for anything else.
    public extern(c) link(symbol: "GetConsoleMode") get_console_mode:
        (console: handle, mode: ptr mut u32) -> (done: i32)

    --- A console's screen buffer, `CONSOLE_SCREEN_BUFFER_INFO`: its size,
    --- the cursor, the attributes, the window's corners and its largest
    --- size, each coordinate 16 bits.
    public console_screen: type = struct
        size_x: i16
        size_y: i16
        cursor_x: i16
        cursor_y: i16
        attributes: u16
        left: i16
        top: i16
        right: i16
        bottom: i16
        largest_x: i16
        largest_y: i16
    end console_screen

    --- Fill `found` for the console screen buffer `console`,
    --- `GetConsoleScreenBufferInfo`.
    public extern(c) link(symbol: "GetConsoleScreenBufferInfo")
        console_screen_info:
        (console: handle, found: ptr mut console_screen) -> (done: i32)
end if
