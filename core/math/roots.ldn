--  Square and cube roots, the hypotenuse and the fused multiply-add.
--
--  IEEE 754 makes the square root and the fused multiply-add exact
--  operations, correctly rounded, so the float unit's instruction gives
--  the same bits as the routines here.  Each is taken from the float unit
--  in an assembly block where the target has one, and computed from the
--  bits elsewhere: on Cortex-M0, RV32 and Xtensa, on a Cortex-M without
--  double precision for f64, and for the fused multiply-add on x86-64
--  below x86-64-v3.  cbrt and hypot are msun's s_cbrt.c, s_cbrtf.c,
--  e_hypot.c and e_hypotf.c, under Sun's notice in math.ldn.

--  The correctly rounded square root of a significand, digit by digit:
--  each step takes the next two bits of the radicand and decides one bit
--  of the root, so the root is exact and its remainder says whether
--  anything was left over.  A root never lies halfway between two floats,
--  so rounding needs only the bit below the last.

sqrt_soft_f64: (x: f64) -> (result: f64) =
    bits := bits_f64(x)
    if x <> x or bits << 1 == 0 or bits == 0x7ff0000000000000 then
        result = x
        return
    end if
    if bits >> 63 == 1 then
        result = (x - x) / (x - x)
        return
    end if
    mut exponent: i64 = i64((bits >> 52) & 0x7ff)
    mut significand: u64 = bits & 0xfffffffffffff
    if exponent == 0 then
        exponent = 1
        while significand & 0x10000000000000 == 0 do
            significand = significand << 1
            exponent = exponent - 1
        end while
    else
        significand = significand | 0x10000000000000
    end if
    --  x = significand * 2^(exponent - 1075); make the power even.
    mut power: i64 = exponent - 1075
    if power & 1 <> 0 then
        significand = significand << 1
        power = power - 1
    end if
    --  The root of significand * 2^54, in [2^53, 2^54): 53 bits and the
    --  rounding bit.
    mut root: u64 = 0
    mut rest: u64 = 0
    mut pair: i64 = 53
    while pair >= 0 do
        shift := 2 * pair - 54
        next: u64 = if shift >= 0 then (significand >> u64(shift)) & 3 else 0 end if
        rest = (rest << 2) | next
        trial := (root << 2) | 1
        if rest >= trial then
            rest = rest - trial
            root = (root << 1) | 1
        else
            root = root << 1
        end if
        pair = pair - 1
    end while
    rounded := (root >> 1) + (root & 1)
    --  The result is rounded * 2^((power - 54) / 2), its exponent field
    --  the power of its leading bit; a carry out of the significand
    --  passes into the exponent.
    field := (power - 54) / 2 + 52 + 1023
    result = from_bits_f64((u64(field) << 52) + (rounded - 0x10000000000000))
end sqrt_soft_f64

sqrt_soft_f32: (x: f32) -> (result: f32) =
    bits := bits_f32(x)
    if x <> x or bits << 1 == 0 or bits == 0x7f800000 then
        result = x
        return
    end if
    if bits >> 31 == 1 then
        result = (x - x) / (x - x)
        return
    end if
    mut exponent: i32 = i32((bits >> 23) & 0xff)
    mut significand: u64 = u64(bits & 0x7fffff)
    if exponent == 0 then
        exponent = 1
        while significand & 0x800000 == 0 do
            significand = significand << 1
            exponent = exponent - 1
        end while
    else
        significand = significand | 0x800000
    end if
    mut power: i32 = exponent - 150
    if power & 1 <> 0 then
        significand = significand << 1
        power = power - 1
    end if
    mut root: u64 = 0
    mut rest: u64 = 0
    mut pair: i32 = 24
    while pair >= 0 do
        shift := 2 * pair - 25
        next: u64 = if shift >= 0 then (significand >> u64(shift)) & 3 else 0 end if
        rest = (rest << 2) | next
        trial := (root << 2) | 1
        if rest >= trial then
            rest = rest - trial
            root = (root << 1) | 1
        else
            root = root << 1
        end if
        pair = pair - 1
    end while
    rounded := u32((root >> 1) + (root & 1))
    field := (power - 25) / 2 + 23 + 127
    result = from_bits_f32((u32(field) << 23) + (rounded - 0x800000))
end sqrt_soft_f32

fixed if compiler.arch == x86_64 then
    sqrt_f64: (x: f64) -> (result: f64) =
        result = assembler.block("sqrtsd {x}, {result}", in x: f64 at float = x,
                                 out result: f64 at float)
    end sqrt_f64
    sqrt_f32: (x: f32) -> (result: f32) =
        result = assembler.block("sqrtss {x}, {result}", in x: f32 at float = x,
                                 out result: f32 at float)
    end sqrt_f32
elsif compiler.arch == arm64 then
    sqrt_f64: (x: f64) -> (result: f64) =
        result = assembler.block("fsqrt {result}, {x}", in x: f64 at float = x,
                                 out result: f64 at float)
    end sqrt_f64
    sqrt_f32: (x: f32) -> (result: f32) =
        result = assembler.block("fsqrt {result}, {x}", in x: f32 at float = x,
                                 out result: f32 at float)
    end sqrt_f32
elsif compiler.arch == rv64 then
    sqrt_f64: (x: f64) -> (result: f64) =
        result = assembler.block("fsqrt.d {result}, {x}", in x: f64 at float = x,
                                 out result: f64 at float)
    end sqrt_f64
    sqrt_f32: (x: f32) -> (result: f32) =
        result = assembler.block("fsqrt.s {result}, {x}", in x: f32 at float = x,
                                 out result: f32 at float)
    end sqrt_f32
elsif compiler.feature.fp_dp then
    sqrt_f64: (x: f64) -> (result: f64) =
        result = assembler.block("vsqrt.f64 {result}, {x}", in x: f64 at float = x,
                                 out result: f64 at float)
    end sqrt_f64
    sqrt_f32: (x: f32) -> (result: f32) =
        result = assembler.block("vsqrt.f32 {result}, {x}", in x: f32 at float = x,
                                 out result: f32 at float)
    end sqrt_f32
elsif compiler.feature.fp then
    sqrt_f64: (x: f64) -> (result: f64) =
        result = sqrt_soft_f64(x)
    end sqrt_f64
    sqrt_f32: (x: f32) -> (result: f32) =
        result = assembler.block("vsqrt.f32 {result}, {x}", in x: f32 at float = x,
                                 out result: f32 at float)
    end sqrt_f32
else
    sqrt_f64: (x: f64) -> (result: f64) =
        result = sqrt_soft_f64(x)
    end sqrt_f64
    sqrt_f32: (x: f32) -> (result: f32) =
        result = sqrt_soft_f32(x)
    end sqrt_f32
end if

--  A 128-bit unsigned integer, for the exact sum inside the fused
--  multiply-add.
wide: type = struct
    high: u64
    low: u64
end wide

wide_shift_left: (value: wide, count: u64) -> (result: wide) =
    if count == 0 then
        result = value
    elsif count >= 64 then
        result = (high: value.low << (count - 64), low: 0)
    else
        result = (high: (value.high << count) | (value.low >> (64 - count)),
                  low: value.low << count)
    end if
end wide_shift_left

--  Shift right, keeping in the lowest bit whether any bit shifted out
--  was set.
wide_shift_right_sticky: (value: wide, count: u64) -> (result: wide) =
    if count == 0 then
        result = value
    elsif count >= 128 then
        sticky: u64 = if (value.high | value.low) <> 0 then 1 else 0 end if
        result = (high: 0, low: sticky)
    elsif count >= 64 then
        lost := value.low | (if count > 64 then value.high << (128 - count) else 0 end if)
        sticky: u64 = if lost <> 0 then 1 else 0 end if
        result = (high: 0, low: (value.high >> (count - 64)) | sticky)
    else
        lost := value.low << (64 - count)
        sticky: u64 = if lost <> 0 then 1 else 0 end if
        result = (high: value.high >> count,
                  low: (value.low >> count) | (value.high << (64 - count)) | sticky)
    end if
end wide_shift_right_sticky

wide_less: (left: wide, right: wide) -> (yes: bool) =
    yes = left.high < right.high or (left.high == right.high and left.low < right.low)
end wide_less

wide_add: (left: wide, right: wide) -> (result: wide) =
    low := left.low +% right.low
    carry: u64 = if low < left.low then 1 else 0 end if
    result = (high: left.high +% right.high +% carry, low: low)
end wide_add

wide_subtract: (left: wide, right: wide) -> (result: wide) =
    borrow: u64 = if left.low < right.low then 1 else 0 end if
    result = (high: left.high -% right.high -% borrow, low: left.low -% right.low)
end wide_subtract

--  The index of the highest set bit of a nonzero value.
wide_top: (value: wide) -> (index: u64) =
    mut word: u64 = value.low
    index = 0
    if value.high <> 0 then
        word = value.high
        index = 64
    end if
    while word >> 1 <> 0 do
        word = word >> 1
        index = index + 1
    end while
end wide_top

--  A finite nonzero f64 as an integer significand and a power of two:
--  x = significand * 2^power, the significand's leading bit at bit 52.
unpack_f64: (x: f64) -> (significand: u64, power: i64) =
    bits := bits_f64(x)
    exponent := i64((bits >> 52) & 0x7ff)
    significand = bits & 0xfffffffffffff
    if exponent == 0 then
        power = 1 - 1075
        while significand & 0x10000000000000 == 0 do
            significand = significand << 1
            power = power - 1
        end while
    else
        significand = significand | 0x10000000000000
        power = exponent - 1075
    end if
end unpack_f64

--  x * y + z, its product and sum exact in 128 bits and rounded once.
fma_soft_f64: (x: f64, y: f64, z: f64) -> (result: f64) =
    xb := bits_f64(x)
    yb := bits_f64(y)
    zb := bits_f64(z)
    if (xb >> 52) & 0x7ff == 0x7ff or (yb >> 52) & 0x7ff == 0x7ff then
        result = x * y + z
        return
    end if
    if (zb >> 52) & 0x7ff == 0x7ff then
        result = z + z
        return
    end if
    if xb << 1 == 0 or yb << 1 == 0 then
        result = x * y + z
        return
    end if
    (significand: mx, power: ex) := unpack_f64(x)
    (significand: my, power: ey) := unpack_f64(y)
    product_negative := (xb ^ yb) >> 63 == 1
    --  The 106-bit product from 32-bit halves.
    x0 := mx & 0xffffffff
    x1 := mx >> 32
    y0 := my & 0xffffffff
    y1 := my >> 32
    middle := x1 * y0 + x0 * y1
    low_part := x0 * y0
    mut product: wide = wide_add((high: x1 * y1, low: low_part),
                                 (high: middle >> 32, low: middle << 32))
    mut power: i64 = ex + ey
    --  Both operands with their leading bit at bit 125.
    product_top := i64(wide_top(product))
    product = wide_shift_left(product, u64(125 - product_top))
    power = power - (125 - product_top)
    mut sum: wide = product
    mut negative: bool = product_negative
    if zb << 1 <> 0 then
        (significand: mz, power: ez0) := unpack_f64(z)
        mut addend: wide = wide_shift_left((high: 0, low: mz), 73)
        ez := ez0 - 73
        if power >= ez then
            addend = wide_shift_right_sticky(addend, u64(power - ez))
        else
            product = wide_shift_right_sticky(product, u64(ez - power))
            power = ez
        end if
        addend_negative := zb >> 63 == 1
        if addend_negative == product_negative then
            sum = wide_add(product, addend)
        elsif wide_less(product, addend) then
            sum = wide_subtract(addend, product)
            negative = addend_negative
        else
            sum = wide_subtract(product, addend)
        end if
        if sum.high == 0 and sum.low == 0 then
            result = 0.0
            return
        end if
    end if
    --  Round sum * 2^power to 53 bits, or to the subnormals' fixed point.
    top := i64(wide_top(sum))
    mut drop: i64 = top - 52
    if -1074 - power > drop then
        drop = -1074 - power
    end if
    sign: u64 = if negative then 0x8000000000000000 else 0 end if
    mut kept: u64 = 0
    if drop <= 0 then
        widened := wide_shift_left(sum, u64(0 - drop))
        kept = widened.low
    elsif drop > 128 then
        --  Below half the least subnormal: zero.
        kept = 0
    else
        kept_wide := wide_shift_right_plain(sum, u64(drop))
        kept = kept_wide.low
        remainder := wide_subtract(sum, wide_shift_left(kept_wide, u64(drop)))
        half := wide_shift_left((high: 0, low: 1), u64(drop - 1))
        if wide_less(half, remainder)
          or (remainder.high == half.high and remainder.low == half.low and kept & 1 == 1) then
            kept = kept + 1
        end if
    end if
    field := power + drop + 52 + 1023
    if kept >= 0x10000000000000 then
        if field >= 0x7ff or (kept >= 0x20000000000000 and field + 1 >= 0x7ff) then
            result = from_bits_f64(sign | 0x7ff0000000000000)
        else
            result = from_bits_f64(sign | ((u64(field) << 52) + (kept - 0x10000000000000)))
        end if
    else
        result = from_bits_f64(sign | kept)
    end if
end fma_soft_f64

wide_shift_right_plain: (value: wide, count: u64) -> (result: wide) =
    if count == 0 then
        result = value
    elsif count >= 128 then
        result = (high: 0, low: 0)
    elsif count >= 64 then
        result = (high: 0, low: value.high >> (count - 64))
    else
        result = (high: value.high >> count,
                  low: (value.low >> count) | (value.high << (64 - count)))
    end if
end wide_shift_right_plain

--  For f32 the product is exact in f64, and the sum's rounding error in
--  f64 is exact too (Knuth's two-sum), so the f32 result is the f64 sum
--  rounded once, except where that sum lies exactly halfway between two
--  f32 values: then the error decides the direction.
fma_soft_f32: (x: f32, y: f32, z: f32) -> (result: f32) =
    product := f64(x) * f64(y)
    addend := f64(z)
    if product <> product or abs_f64(product) == f64.infinity then
        result = x * y + z
        return
    end if
    if addend <> addend or abs_f64(addend) == f64.infinity then
        result = z + z
        return
    end if
    sum := product + addend
    virtual := sum - product
    error := (product - (sum - virtual)) + (addend - virtual)
    magnitude := abs_f64(sum)
    if magnitude >= 0x1.ffffffp127 then
        toward_zero := error <> 0.0 and (error < 0.0) <> (sum < 0.0)
        result = if magnitude == 0x1.ffffffp127 and toward_zero
                 then copy_sign_f32(0x1.fffffep127, f32(copy_sign_f64(1.0, sum)))
                 else copy_sign_f32(f32.infinity, f32(copy_sign_f64(1.0, sum))) end if
        return
    end if
    rounded := f32(sum)
    if error == 0.0 or f64(rounded) == sum then
        result = rounded
        return
    end if
    toward: f32 = if sum > f64(rounded) then f32.infinity else -f32.infinity end if
    other := next_after_f32(rounded, toward)
    if (f64(rounded) + f64(other)) * 0.5 == sum then
        result = if (error > 0.0) == (f64(other) > f64(rounded)) then other else rounded end if
    else
        result = rounded
    end if
end fma_soft_f32

fixed if compiler.arch == x86_64 and compiler.feature.fma then
    fma_f64: (x: f64, y: f64, z: f64) -> (result: f64) =
        result = assembler.block("vfmadd231sd {y}, {x}, {result}",
                                 in x: f64 at float = x, in y: f64 at float = y,
                                 inout result: f64 at float = z)
    end fma_f64
    fma_f32: (x: f32, y: f32, z: f32) -> (result: f32) =
        result = assembler.block("vfmadd231ss {y}, {x}, {result}",
                                 in x: f32 at float = x, in y: f32 at float = y,
                                 inout result: f32 at float = z)
    end fma_f32
elsif compiler.arch == arm64 then
    fma_f64: (x: f64, y: f64, z: f64) -> (result: f64) =
        result = assembler.block("fmadd {result}, {x}, {y}, {z}",
                                 in x: f64 at float = x, in y: f64 at float = y,
                                 in z: f64 at float = z, out result: f64 at float)
    end fma_f64
    fma_f32: (x: f32, y: f32, z: f32) -> (result: f32) =
        result = assembler.block("fmadd {result}, {x}, {y}, {z}",
                                 in x: f32 at float = x, in y: f32 at float = y,
                                 in z: f32 at float = z, out result: f32 at float)
    end fma_f32
elsif compiler.arch == rv64 then
    fma_f64: (x: f64, y: f64, z: f64) -> (result: f64) =
        result = assembler.block("fmadd.d {result}, {x}, {y}, {z}",
                                 in x: f64 at float = x, in y: f64 at float = y,
                                 in z: f64 at float = z, out result: f64 at float)
    end fma_f64
    fma_f32: (x: f32, y: f32, z: f32) -> (result: f32) =
        result = assembler.block("fmadd.s {result}, {x}, {y}, {z}",
                                 in x: f32 at float = x, in y: f32 at float = y,
                                 in z: f32 at float = z, out result: f32 at float)
    end fma_f32
elsif compiler.feature.fp_dp then
    fma_f64: (x: f64, y: f64, z: f64) -> (result: f64) =
        result = assembler.block("vfma.f64 {result}, {x}, {y}",
                                 in x: f64 at float = x, in y: f64 at float = y,
                                 inout result: f64 at float = z)
    end fma_f64
    fma_f32: (x: f32, y: f32, z: f32) -> (result: f32) =
        result = assembler.block("vfma.f32 {result}, {x}, {y}",
                                 in x: f32 at float = x, in y: f32 at float = y,
                                 inout result: f32 at float = z)
    end fma_f32
elsif compiler.feature.fp then
    fma_f64: (x: f64, y: f64, z: f64) -> (result: f64) =
        result = fma_soft_f64(x, y, z)
    end fma_f64
    fma_f32: (x: f32, y: f32, z: f32) -> (result: f32) =
        result = assembler.block("vfma.f32 {result}, {x}, {y}",
                                 in x: f32 at float = x, in y: f32 at float = y,
                                 inout result: f32 at float = z)
    end fma_f32
else
    fma_f64: (x: f64, y: f64, z: f64) -> (result: f64) =
        result = fma_soft_f64(x, y, z)
    end fma_f64
    fma_f32: (x: f32, y: f32, z: f32) -> (result: f32) =
        result = fma_soft_f32(x, y, z)
    end fma_f32
end if

cbrt_f64: (x: f64) -> (result: f64) =
    hx := high_word(x)
    sign := hx & 0x80000000
    magnitude := hx ^ sign
    if magnitude >= 0x7ff00000 then
        result = x + x
        return
    end if
    --  Rough cbrt to 5 bits, from the exponent divided by 3.
    mut t: f64 = 0.0
    if magnitude < 0x00100000 then
        if (magnitude | low_word(x)) == 0 then
            result = x
            return
        end if
        t = 0x1.0p54 * x
        high := high_word(t)
        t = from_words(sign | ((high & 0x7fffffff) / 3 + 696219795), 0)
    else
        t = from_words(sign | (magnitude / 3 + 715094163), 0)
    end if
    --  New cbrt to 23 bits: cbrt(x) = t*cbrt(x/t**3) ~= t*P(t**3/x).
    mut r: f64 = (t * t) * (t / x)
    t = t * ((1.87595182427177009643 + r * (-1.88497979543377169875
                                            + r * 1.621429720105354466140))
             + ((r * r) * r) * (-0.758397934778766047437
                                + r * 0.145996192886612446982))
    --  Round t away from zero to 23 bits.
    t = from_bits_f64((bits_f64(t) + 0x80000000) & 0xffffffffc0000000)
    --  One step of Halley's iteration to 53 bits, error < 0.667 ulps.
    s := t * t
    r = x / s
    w := t + t
    r = (r - t) / (w + r)
    result = t + t * r
end cbrt_f64

cbrt_f32: (x: f32) -> (result: f32) =
    hx := bits_f32(x)
    sign := hx & 0x80000000
    magnitude := hx ^ sign
    if magnitude >= 0x7f800000 then
        result = x + x
        return
    end if
    mut t: f32 = 0.0
    if magnitude < 0x00800000 then
        if magnitude == 0 then
            result = x
            return
        end if
        t = 0x1.0p24 * x
        high := bits_f32(t)
        t = from_bits_f32(sign | ((high & 0x7fffffff) / 3 + 642849266))
    else
        t = from_bits_f32(sign | (magnitude / 3 + 709958130))
    end if
    --  Two steps of Halley's iteration in f64, to 47 bits; rounding to
    --  24 bits is then exact to nearest.
    mut wide_t: f64 = f64(t)
    wx := f64(x)
    mut r: f64 = wide_t * wide_t * wide_t
    wide_t = wide_t * (wx + wx + r) / (wx + r + r)
    r = wide_t * wide_t * wide_t
    wide_t = wide_t * (wx + wx + r) / (wx + r + r)
    result = f32(wide_t)
end cbrt_f32

hypot_f64: (x: f64, y: f64) -> (result: f64) =
    mut ha: u32 = high_word(x) & 0x7fffffff
    mut hb: u32 = high_word(y) & 0x7fffffff
    mut a: f64 = x
    mut b: f64 = y
    if hb > ha then
        a = y
        b = x
        swap := ha
        ha = hb
        hb = swap
    end if
    a = abs_f64(a)
    b = abs_f64(b)
    if ha - hb > 0x3c00000 then
        result = a + b
        return
    end if
    mut k: i32 = 0
    if ha > 0x5f300000 then
        if ha >= 0x7ff00000 then
            --  An infinity wins over NaN.
            mut w: f64 = abs_f64(x + 0.0) - abs_f64(y + 0.0)
            if ((ha & 0xfffff) | low_word(a)) == 0 then
                w = a
            end if
            if ((hb ^ 0x7ff00000) | low_word(b)) == 0 then
                w = b
            end if
            result = w
            return
        end if
        ha = ha - 0x25800000
        hb = hb - 0x25800000
        k = k + 600
        a = with_high_word(a, ha)
        b = with_high_word(b, hb)
    end if
    if hb < 0x20b00000 then
        if hb <= 0x000fffff then
            if (hb | low_word(b)) == 0 then
                result = a
                return
            end if
            b = b * 0x1.0p1022
            a = a * 0x1.0p1022
            k = k - 1022
        else
            ha = ha + 0x25800000
            hb = hb + 0x25800000
            k = k - 600
            a = with_high_word(a, ha)
            b = with_high_word(b, hb)
        end if
    end if
    mut w: f64 = a - b
    if w > b then
        t1 := from_words(ha, 0)
        t2 := a - t1
        w = sqrt_f64(t1 * t1 - (b * (-b) - t2 * (a + t1)))
    else
        a = a + a
        y1 := from_words(hb, 0)
        y2 := b - y1
        t1 := from_words(ha + 0x00100000, 0)
        t2 := a - t1
        w = sqrt_f64(t1 * y1 - (w * (-w) - (t1 * y2 + t2 * b)))
    end if
    if k <> 0 then
        result = from_words(u32(1023 + k) << 20, 0) * w
    else
        result = w
    end if
end hypot_f64

hypot_f32: (x: f32, y: f32) -> (result: f32) =
    mut ha: u32 = bits_f32(x) & 0x7fffffff
    mut hb: u32 = bits_f32(y) & 0x7fffffff
    mut a: f32 = x
    mut b: f32 = y
    if hb > ha then
        a = y
        b = x
        swap := ha
        ha = hb
        hb = swap
    end if
    a = abs_f32(a)
    b = abs_f32(b)
    if ha - hb > 0xf000000 then
        result = a + b
        return
    end if
    mut k: i32 = 0
    if ha > 0x58800000 then
        if ha >= 0x7f800000 then
            mut w: f32 = abs_f32(x + 0.0) - abs_f32(y + 0.0)
            if ha == 0x7f800000 then
                w = a
            end if
            if hb == 0x7f800000 then
                w = b
            end if
            result = w
            return
        end if
        ha = ha - 0x22000000
        hb = hb - 0x22000000
        k = k + 68
        a = from_bits_f32(ha)
        b = from_bits_f32(hb)
    end if
    if hb < 0x26800000 then
        if hb <= 0x007fffff then
            if hb == 0 then
                result = a
                return
            end if
            b = b * 0x1.0p126
            a = a * 0x1.0p126
            k = k - 126
        else
            ha = ha + 0x22000000
            hb = hb + 0x22000000
            k = k - 68
            a = from_bits_f32(ha)
            b = from_bits_f32(hb)
        end if
    end if
    mut w: f32 = a - b
    if w > b then
        t1 := from_bits_f32(ha & 0xfffff000)
        t2 := a - t1
        w = sqrt_f32(t1 * t1 - (b * (-b) - t2 * (a + t1)))
    else
        a = a + a
        y1 := from_bits_f32(hb & 0xfffff000)
        y2 := b - y1
        t1 := from_bits_f32((ha + 0x00800000) & 0xfffff000)
        t2 := a - t1
        w = sqrt_f32(t1 * y1 - (w * (-w) - (t1 * y2 + t2 * b)))
    end if
    if k <> 0 then
        result = from_bits_f32(u32(127 + k) << 23) * w
    else
        result = w
    end if
end hypot_f32
