erf_f64: (x: f64) -> (result: f64) =
    hx := high_word(x)
    ix := hx & 0x7fffffff
    negative := hx >= 0x80000000
    if ix >= 0x7ff00000 then
        --  erf(NaN) is NaN, erf(±inf) is ±1.
        one_signed: f64 = if negative then -1.0 else 1.0 end if
        result = one_signed + 1.0 / x
        return
    end if
    if ix < 0x3feb0000 then
        --  |x| < 0.84375: erf(x) = x + x*R(x^2).
        if ix < 0x3e300000 then
            --  |x| < 2^-28: the first term of the series.
            if ix < 0x00800000 then
                result = (8.0 * x + erf_efx8 * x) / 8.0
                return
            end if
            result = x + erf_efx * x
            return
        end if
        z := x * x
        r := erf_pp0 + z * (erf_pp1 + z * (erf_pp2 + z * (erf_pp3 + z * erf_pp4)))
        s := 1.0 + z * (erf_qq1 + z * (erf_qq2 + z * (erf_qq3 + z * (erf_qq4 + z * erf_qq5))))
        y := r / s
        result = x + x * y
        return
    end if
    if ix < 0x3ff40000 then
        --  0.84375 <= |x| < 1.25: erf(1+s) = erx + P1(s)/Q1(s).
        s := abs_f64(x) - 1.0
        p := erf_pa0 + s * (erf_pa1 + s * (erf_pa2 + s * (erf_pa3 + s * (erf_pa4
                                                                         + s * (erf_pa5 + s * erf_pa6)))))
        q := 1.0 + s * (erf_qa1 + s * (erf_qa2 + s * (erf_qa3 + s * (erf_qa4
                                                                     + s * (erf_qa5 + s * erf_qa6)))))
        result = if negative then -erf_erx - p / q else erf_erx + p / q end if
        return
    end if
    if ix >= 0x40180000 then
        --  |x| >= 6: ±(1 - tiny).
        result = if negative then erf_tiny - 1.0 else 1.0 - erf_tiny end if
        return
    end if
    a := abs_f64(x)
    (r: big_r, s: big_s) := erfc_ratio_f64(a, ix < 0x4006db6e)
    result = if negative then erfc_tail_f64(a, big_r, big_s) / a - 1.0
             else 1.0 - erfc_tail_f64(a, big_r, big_s) / a end if
end erf_f64

--  For 1.25 <= |x| < 28, erfc(x) = (1/x)*exp(-x*x - 0.5625 + R/S), with
--  R/S approximating log(x*erfc(x)) + x*x + 0.5625 in 1/x^2: R1/S1 below
--  1/0.35, R2/S2 above.
erfc_ratio_f64: (a: f64, near: bool) -> (r: f64, s: f64) =
    w := 1.0 / (a * a)
    if near then
        r = erf_ra0 + w * (erf_ra1 + w * (erf_ra2 + w * (erf_ra3 + w * (erf_ra4
                                                                        + w * (erf_ra5 + w * (erf_ra6 + w * erf_ra7))))))
        s = 1.0 + w * (erf_sa1 + w * (erf_sa2 + w * (erf_sa3 + w * (erf_sa4
                                                                    + w * (erf_sa5 + w * (erf_sa6 + w * (erf_sa7 + w * erf_sa8)))))))
    else
        r = erf_rb0 + w * (erf_rb1 + w * (erf_rb2 + w * (erf_rb3 + w * (erf_rb4
                                                                        + w * (erf_rb5 + w * erf_rb6)))))
        s = 1.0 + w * (erf_sb1 + w * (erf_sb2 + w * (erf_sb3 + w * (erf_sb4
                                                                    + w * (erf_sb5 + w * (erf_sb6 + w * erf_sb7))))))
    end if
end erfc_ratio_f64

--  exp(-x*x - 0.5625 + R/S) for x = a > 0, with z = a cut to its high
--  word so that -x*x = -z*z + (z-x)*(z+x) loses nothing.
erfc_tail_f64: (a: f64, r: f64, s: f64) -> (result: f64) =
    z := with_low_word(a, 0)
    result = exp_f64(-z * z - 0.5625) * exp_f64((z - a) * (z + a) + r / s)
end erfc_tail_f64

erfc_f64: (x: f64) -> (result: f64) =
    hx := high_word(x)
    ix := hx & 0x7fffffff
    negative := hx >= 0x80000000
    if ix >= 0x7ff00000 then
        --  erfc(NaN) is NaN, erfc(+inf) 0 and erfc(-inf) 2.
        two_or_zero: f64 = if negative then 2.0 else 0.0 end if
        result = two_or_zero + 1.0 / x
        return
    end if
    if ix < 0x3feb0000 then
        --  |x| < 0.84375.
        if ix < 0x3c700000 then
            result = 1.0 - x
            return
        end if
        z := x * x
        r := erf_pp0 + z * (erf_pp1 + z * (erf_pp2 + z * (erf_pp3 + z * erf_pp4)))
        s := 1.0 + z * (erf_qq1 + z * (erf_qq2 + z * (erf_qq3 + z * (erf_qq4 + z * erf_qq5))))
        y := r / s
        if signed_word(hx) < 0x3fd00000 then
            --  x < 1/4.
            result = 1.0 - (x + x * y)
        else
            mut t: f64 = x * y
            t = t + (x - 0.5)
            result = 0.5 - t
        end if
        return
    end if
    if ix < 0x3ff40000 then
        --  0.84375 <= |x| < 1.25.
        s := abs_f64(x) - 1.0
        p := erf_pa0 + s * (erf_pa1 + s * (erf_pa2 + s * (erf_pa3 + s * (erf_pa4
                                                                         + s * (erf_pa5 + s * erf_pa6)))))
        q := 1.0 + s * (erf_qa1 + s * (erf_qa2 + s * (erf_qa3 + s * (erf_qa4
                                                                     + s * (erf_qa5 + s * erf_qa6)))))
        if negative then
            z := erf_erx + p / q
            result = 1.0 + z
        else
            z := 1.0 - erf_erx
            result = z - p / q
        end if
        return
    end if
    if ix < 0x403c0000 then
        --  |x| < 28.
        if negative and ix >= 0x40180000 then
            --  x < -6.
            result = 2.0 - erf_tiny
            return
        end if
        a := abs_f64(x)
        (r: big_r, s: big_s) := erfc_ratio_f64(a, ix < 0x4006db6d)
        t := erfc_tail_f64(a, big_r, big_s)
        result = if negative then 2.0 - t / a else t / a end if
        return
    end if
    result = if negative then 2.0 - erf_tiny else erf_tiny * erf_tiny end if
end erfc_f64

erf_f32: (x: f32) -> (result: f32) =
    hx := bits_f32(x)
    ix := hx & 0x7fffffff
    negative := hx >= 0x80000000
    if ix >= 0x7f800000 then
        one_signed: f32 = if negative then -1.0 else 1.0 end if
        result = one_signed + 1.0 / x
        return
    end if
    if ix < 0x3f580000 then
        --  |x| < 0.84375.
        if ix < 0x38800000 then
            --  |x| < 2^-14.
            if ix < 0x04000000 then
                result = (8.0 * x + erff_efx8 * x) / 8.0
                return
            end if
            result = x + erff_efx * x
            return
        end if
        z := x * x
        r := erff_pp0 + z * (erff_pp1 + z * erff_pp2)
        s := 1.0 + z * (erff_qq1 + z * (erff_qq2 + z * erff_qq3))
        y := r / s
        result = x + x * y
        return
    end if
    if ix < 0x3fa00000 then
        --  0.84375 <= |x| < 1.25.
        s := abs_f32(x) - 1.0
        p := erff_pa0 + s * (erff_pa1 + s * (erff_pa2 + s * erff_pa3))
        q := 1.0 + s * (erff_qa1 + s * (erff_qa2 + s * erff_qa3))
        result = if negative then -erff_erx - p / q else erff_erx + p / q end if
        return
    end if
    if ix >= 0x40800000 then
        --  |x| >= 4.
        result = if negative then erff_tiny - 1.0 else 1.0 - erff_tiny end if
        return
    end if
    a := abs_f32(x)
    t := erfc_tail_f32(a, hx, ix < 0x4036db8c)
    result = if negative then t / a - 1.0 else 1.0 - t / a end if
end erf_f32

--  For 1.25 <= |x| < 11, x*erfc(|x|) as exp(-z*z - 0.5625)*exp((z-x)*(z+x)
--  + R/S), z being x with its low 13 bits cleared.  msun clears them from
--  x's own bits, its sign included, which leaves (z-x)*(z+x) the same.
erfc_tail_f32: (a: f32, hx: u32, near: bool) -> (result: f32) =
    w := 1.0 / (a * a)
    mut r: f32 = 0.0
    mut s: f32 = 0.0
    if near then
        r = erff_ra0 + w * (erff_ra1 + w * (erff_ra2 + w * erff_ra3))
        s = 1.0 + w * (erff_sa1 + w * (erff_sa2 + w * erff_sa3))
    else
        r = erff_rb0 + w * (erff_rb1 + w * erff_rb2)
        s = 1.0 + w * (erff_sb1 + w * (erff_sb2 + w * erff_sb3))
    end if
    z := from_bits_f32(hx & 0xffffe000)
    result = exp_f32(-z * z - 0.5625) * exp_f32((z - a) * (z + a) + r / s)
end erfc_tail_f32

erfc_f32: (x: f32) -> (result: f32) =
    hx := bits_f32(x)
    ix := hx & 0x7fffffff
    negative := hx >= 0x80000000
    if ix >= 0x7f800000 then
        two_or_zero: f32 = if negative then 2.0 else 0.0 end if
        result = two_or_zero + 1.0 / x
        return
    end if
    if ix < 0x3f580000 then
        --  |x| < 0.84375.
        if ix < 0x33800000 then
            result = 1.0 - x
            return
        end if
        z := x * x
        r := erff_pp0 + z * (erff_pp1 + z * erff_pp2)
        s := 1.0 + z * (erff_qq1 + z * (erff_qq2 + z * erff_qq3))
        y := r / s
        if signed_word(hx) < 0x3e800000 then
            result = 1.0 - (x + x * y)
        else
            mut t: f32 = x * y
            t = t + (x - 0.5)
            result = 0.5 - t
        end if
        return
    end if
    if ix < 0x3fa00000 then
        s := abs_f32(x) - 1.0
        p := erff_pa0 + s * (erff_pa1 + s * (erff_pa2 + s * erff_pa3))
        q := 1.0 + s * (erff_qa1 + s * (erff_qa2 + s * erff_qa3))
        if negative then
            z := erff_erx + p / q
            result = 1.0 + z
        else
            z := 1.0 - erff_erx
            result = z - p / q
        end if
        return
    end if
    if ix < 0x41300000 then
        --  |x| < 11.
        if negative and ix >= 0x40a00000 then
            --  x < -5.
            result = 2.0 - erff_tiny
            return
        end if
        a := abs_f32(x)
        t := erfc_tail_f32(a, hx, ix < 0x4036db8c)
        result = if negative then 2.0 - t / a else t / a end if
        return
    end if
    result = if negative then 2.0 - erff_tiny else erff_tiny * erff_tiny end if
end erfc_f32

--  sin(πx) for x < 0 and |x| < 2^52, without forming π*x: x is reduced
--  mod 2 exactly and the octant picks msun's sine or cosine kernel.
sin_pi_f64: (x: f64) -> (result: f64) =
    mut y: f64 = -x
    mut vz: f64 = y + 0x1.0p52
    mut z: f64 = vz - 0x1.0p52
    if z == y then
        result = 0.0
        return
    end if
    vz = y + 0x1.0p50
    --  The low bits of the rounded y, in units of 0.25.
    mut n: u32 = low_word(vz)
    z = vz - 0x1.0p50
    if z > y then
        z = z - 0.25
        n = n -% 1
    end if
    n = n & 7
    y = y - z + f64(n) * 0.25
    if n == 0 then
        y = sin_pi_kernel_sin_f64(pi * y)
    elsif n <= 2 then
        y = sin_pi_kernel_cos_f64(pi * (0.5 - y))
    elsif n <= 4 then
        y = sin_pi_kernel_sin_f64(pi * (1.0 - y))
    elsif n <= 6 then
        y = -sin_pi_kernel_cos_f64(pi * (y - 1.5))
    else
        y = sin_pi_kernel_sin_f64(pi * (y - 2.0))
    end if
    result = -y
end sin_pi_f64

--  msun's k_sin.c and k_cos.c for an exact argument |x| <= π/4.
sin_pi_kernel_sin_f64: (x: f64) -> (result: f64) =
    z := x * x
    w := z * z
    r := sin_pi_s2 + z * (sin_pi_s3 + z * sin_pi_s4) + z * w * (sin_pi_s5 + z * sin_pi_s6)
    v := z * x
    result = x + v * (sin_pi_s1 + z * r)
end sin_pi_kernel_sin_f64

sin_pi_kernel_cos_f64: (x: f64) -> (result: f64) =
    z := x * x
    mut w: f64 = z * z
    r := z * (cos_pi_c1 + z * (cos_pi_c2 + z * cos_pi_c3))
         + w * w * (cos_pi_c4 + z * (cos_pi_c5 + z * cos_pi_c6))
    hz := 0.5 * z
    w = 1.0 - hz
    result = w + (((1.0 - w) - hz) + z * r)
end sin_pi_kernel_cos_f64

sin_pi_f32: (x: f32) -> (result: f32) =
    mut y: f32 = -x
    mut vz: f32 = y + 0x1.0p23
    mut z: f32 = vz - 0x1.0p23
    if z == y then
        result = 0.0
        return
    end if
    vz = y + 0x1.0p21
    mut n: u32 = bits_f32(vz)
    z = vz - 0x1.0p21
    if z > y then
        z = z - 0.25
        n = n -% 1
    end if
    n = n & 7
    y = y - z + f32(n) * 0.25
    if n == 0 then
        y = sin_pi_kernel_sin_f32(f64(lgammaf_pi * y))
    elsif n <= 2 then
        y = sin_pi_kernel_cos_f32(f64(lgammaf_pi * (0.5 - y)))
    elsif n <= 4 then
        y = sin_pi_kernel_sin_f32(f64(lgammaf_pi * (1.0 - y)))
    elsif n <= 6 then
        y = -sin_pi_kernel_cos_f32(f64(lgammaf_pi * (y - 1.5)))
    else
        y = sin_pi_kernel_sin_f32(f64(lgammaf_pi * (y - 2.0)))
    end if
    result = -y
end sin_pi_f32

--  msun's k_sinf.c and k_cosf.c: f64 kernels with an f32 result.
sin_pi_kernel_sin_f32: (x: f64) -> (result: f32) =
    z := x * x
    w := z * z
    r := sin_pif_s3 + z * sin_pif_s4
    s := z * x
    result = f32((x + s * (sin_pif_s1 + z * sin_pif_s2)) + s * w * r)
end sin_pi_kernel_sin_f32

sin_pi_kernel_cos_f32: (x: f64) -> (result: f32) =
    z := x * x
    w := z * z
    r := cos_pif_c2 + z * cos_pif_c3
    result = f32(((1.0 + z * cos_pif_c0) + w * cos_pif_c1) + (w * z) * r)
end sin_pi_kernel_cos_f32

log_gamma_f64: (x: f64) -> (result: f64) =
    hx := high_word(x)
    lx := low_word(x)
    ix := hx & 0x7fffffff
    negative := hx >= 0x80000000
    if ix >= 0x7ff00000 then
        result = x * x
        return
    end if
    if ix < 0x3c700000 then
        --  |x| < 2^-56: -log|x|.
        if (ix | lx) == 0 then
            result = f64.infinity
            return
        end if
        result = -log_f64(abs_f64(x))
        return
    end if
    mut a: f64 = x
    mut nadj: f64 = 0.0
    if negative then
        if ix >= 0x43300000 then
            --  |x| >= 2^52: a negative integer.
            result = f64.infinity
            return
        end if
        t := sin_pi_f64(x)
        if t == 0.0 then
            result = f64.infinity
            return
        end if
        --  Γ(x)Γ(-x)(-x) = π/sin(πx).
        nadj = log_f64(pi / abs_f64(t * x))
        a = -x
    end if
    mut r: f64 = 0.0
    if ((ix -% 0x3ff00000) | lx) == 0 or ((ix -% 0x40000000) | lx) == 0 then
        --  lgamma(1) = lgamma(2) = 0.
        r = 0.0
    elsif ix < 0x40000000 then
        --  a < 2: reduced to [ymin - 0.23, ymin + 0.27] or near 1 or 2.
        mut y: f64 = 0.0
        mut i: i32 = 0
        if ix <= 0x3feccccc then
            --  lgamma(a) = lgamma(a+1) - log(a).
            r = -log_f64(a)
            if ix >= 0x3fe76944 then
                y = 1.0 - a
                i = 0
            elsif ix >= 0x3fcda661 then
                y = a - (lgamma_tc - 1.0)
                i = 1
            else
                y = a
                i = 2
            end if
        else
            r = 0.0
            if ix >= 0x3ffbb4c3 then
                y = 2.0 - a
                i = 0
            elsif ix >= 0x3ff3b4c4 then
                y = a - lgamma_tc
                i = 1
            else
                y = a - 1.0
                i = 2
            end if
        end if
        if i == 0 then
            z := y * y
            p1 := lgamma_a0 + z * (lgamma_a2 + z * (lgamma_a4 + z * (lgamma_a6
                                                                     + z * (lgamma_a8 + z * lgamma_a10))))
            p2 := z * (lgamma_a1 + z * (lgamma_a3 + z * (lgamma_a5 + z * (lgamma_a7
                                                                          + z * (lgamma_a9 + z * lgamma_a11)))))
            p := y * p1 + p2
            r = r + (p - y / 2.0)
        elsif i == 1 then
            z := y * y
            w := z * y
            p1 := lgamma_t0 + w * (lgamma_t3 + w * (lgamma_t6 + w * (lgamma_t9 + w * lgamma_t12)))
            p2 := lgamma_t1 + w * (lgamma_t4 + w * (lgamma_t7 + w * (lgamma_t10 + w * lgamma_t13)))
            p3 := lgamma_t2 + w * (lgamma_t5 + w * (lgamma_t8 + w * (lgamma_t11 + w * lgamma_t14)))
            p := z * p1 - (lgamma_tt - w * (p2 + y * p3))
            r = r + (lgamma_tf + p)
        else
            p1 := y * (lgamma_u0 + y * (lgamma_u1 + y * (lgamma_u2 + y * (lgamma_u3
                                                                          + y * (lgamma_u4 + y * lgamma_u5)))))
            p2 := 1.0 + y * (lgamma_v1 + y * (lgamma_v2 + y * (lgamma_v3
                                                               + y * (lgamma_v4 + y * lgamma_v5))))
            r = r + (p1 / p2 - y / 2.0)
        end if
    elsif ix < 0x40200000 then
        --  2 <= a < 8: lgamma(1+s) = log(s) + lgamma(s), down to [2, 3).
        i := trunc_f64(a)
        y := a - i
        p := y * (lgamma_s0 + y * (lgamma_s1 + y * (lgamma_s2 + y * (lgamma_s3
                                                                     + y * (lgamma_s4 + y * (lgamma_s5 + y * lgamma_s6))))))
        q := 1.0 + y * (lgamma_r1 + y * (lgamma_r2 + y * (lgamma_r3 + y * (lgamma_r4
                                                                           + y * (lgamma_r5 + y * lgamma_r6)))))
        r = y / 2.0 + p / q
        if i >= 3.0 then
            mut z: f64 = 1.0
            mut k: f64 = i - 1.0
            while k >= 2.0 do
                z = z * (y + k)
                k = k - 1.0
            end while
            r = r + log_f64(z)
        end if
    elsif ix < 0x43700000 then
        --  8 <= a < 2^56: Stirling's series in 1/a.
        t := log_f64(a)
        z := 1.0 / a
        y := z * z
        w := lgamma_w0 + z * (lgamma_w1 + y * (lgamma_w2 + y * (lgamma_w3 + y * (lgamma_w4
                                                                                 + y * (lgamma_w5 + y * lgamma_w6)))))
        r = (a - 0.5) * (t - 1.0) + w
    else
        --  2^56 <= a.
        r = a * (log_f64(a) - 1.0)
    end if
    result = if negative then nadj - r else r end if
end log_gamma_f64

log_gamma_f32: (x: f32) -> (result: f32) =
    hx := bits_f32(x)
    ix := hx & 0x7fffffff
    negative := hx >= 0x80000000
    if ix >= 0x7f800000 then
        result = x * x
        return
    end if
    if ix < 0x32000000 then
        --  |x| < 2^-27: -log|x|.
        if ix == 0 then
            result = f32.infinity
            return
        end if
        result = -log_f32(abs_f32(x))
        return
    end if
    mut a: f32 = x
    mut nadj: f32 = 0.0
    if negative then
        if ix >= 0x4b000000 then
            --  |x| >= 2^23: a negative integer.
            result = f32.infinity
            return
        end if
        t := sin_pi_f32(x)
        if t == 0.0 then
            result = f32.infinity
            return
        end if
        nadj = log_f32(lgammaf_pi / abs_f32(t * x))
        a = -x
    end if
    mut r: f32 = 0.0
    if ix == 0x3f800000 or ix == 0x40000000 then
        r = 0.0
    elsif ix < 0x40000000 then
        mut y: f32 = 0.0
        mut i: i32 = 0
        if ix <= 0x3f666666 then
            r = -log_f32(a)
            if ix >= 0x3f3b4a20 then
                y = 1.0 - a
                i = 0
            elsif ix >= 0x3e6d3308 then
                y = a - (lgammaf_tc - 1.0)
                i = 1
            else
                y = a
                i = 2
            end if
        else
            r = 0.0
            if ix >= 0x3fdda618 then
                y = 2.0 - a
                i = 0
            elsif ix >= 0x3f9da620 then
                y = a - lgammaf_tc
                i = 1
            else
                y = a - 1.0
                i = 2
            end if
        end if
        if i == 0 then
            z := y * y
            p1 := lgammaf_a0 + z * (lgammaf_a2 + z * lgammaf_a4)
            p2 := z * (lgammaf_a1 + z * (lgammaf_a3 + z * lgammaf_a5))
            p := y * p1 + p2
            r = r + (p - y / 2.0)
        elsif i == 1 then
            p := lgammaf_t0 + y * lgammaf_t1 + y * y * (lgammaf_t2 + y * (lgammaf_t3
                                                                          + y * (lgammaf_t4 + y * (lgammaf_t5 + y * (lgammaf_t6 + y * lgammaf_t7)))))
            r = r + (lgammaf_tf + p)
        else
            p1 := y * (lgammaf_u0 + y * (lgammaf_u1 + y * lgammaf_u2))
            p2 := 1.0 + y * (lgammaf_v1 + y * (lgammaf_v2 + y * lgammaf_v3))
            r = r + (p1 / p2 - y / 2.0)
        end if
    elsif ix < 0x41000000 then
        --  2 <= a < 8.
        i := trunc_f32(a)
        y := a - i
        p := y * (lgammaf_s0 + y * (lgammaf_s1 + y * (lgammaf_s2 + y * lgammaf_s3)))
        q := 1.0 + y * (lgammaf_r1 + y * (lgammaf_r2 + y * lgammaf_r3))
        r = y / 2.0 + p / q
        if i >= 3.0 then
            mut z: f32 = 1.0
            mut k: f32 = i - 1.0
            while k >= 2.0 do
                z = z * (y + k)
                k = k - 1.0
            end while
            r = r + log_f32(z)
        end if
    elsif ix < 0x4d000000 then
        --  8 <= a < 2^27.
        t := log_f32(a)
        z := 1.0 / a
        y := z * z
        w := lgammaf_w0 + z * (lgammaf_w1 + y * lgammaf_w2)
        r = (a - 0.5) * (t - 1.0) + w
    else
        r = a * (log_f32(a) - 1.0)
    end if
    result = if negative then nadj - r else r end if
end log_gamma_f32

--  The gamma function is not msun's, whose tgamma is under another
--  licence, but this module's own.  Γ(x+1) = xΓ(x) carries any x to y in
--  [1, 2]: for x >= 2 Γ(x) = Γ(y)(y)(y+1)...(x-1), each factor exact,
--  and for x < 1 Γ(x) = Γ(y)/(x(x+1)...(y-1)).  On [1, 2], Γ(1.5 + t) is
--  a polynomial in t, Chebyshev's interpolant of degree 23 (13 for f32)
--  at its nodes in [-0.5, 0.5], of relative error below 2^-56 (2^-34).
--  For f64 the product is kept as an unevaluated sum of two f64 values,
--  rescaled by powers of two, so its rounding errors stay below 2^-100
--  and only the polynomial and the final rounding count: under 2 ulps.
--  For f32 it runs in f64.

--  A value hi + lo, |lo| <= half an ulp of hi.
pair: type = struct
    high: f64
    low: f64
end pair

--  a + b exactly, as a pair (Knuth's two-sum).
two_sum_f64: (a: f64, b: f64) -> (sum: pair) =
    s := a + b
    v := s - a
    e := (a - (s - v)) + (b - v)
    sum = (high: s, low: e)
end two_sum_f64

--  a * b exactly, as a pair (Dekker's product, splitting each operand
--  into halves of 26 bits), for |a|, |b| below 2^995.
two_product_f64: (a: f64, b: f64) -> (product: pair) =
    split: f64 = 0x1.0p27 + 1.0
    ca := split * a
    ah := ca - (ca - a)
    al := a - ah
    cb := split * b
    bh := cb - (cb - b)
    bl := b - bh
    p := a * b
    e := ((ah * bh - p) + ah * bl + al * bh) + al * bl
    product = (high: p, low: e)
end two_product_f64

pair_multiply: (a: pair, b: pair) -> (product: pair) =
    p := two_product_f64(a.high, b.high)
    low := p.low + (a.high * b.low + a.low * b.high)
    s := p.high + low
    product = (high: s, low: low - (s - p.high))
end pair_multiply

--  Γ(1.5 + t) for |t| <= 0.5, as a pair, with the first-order effect of
--  an error e in t added.
gamma_base_f64: (t: f64, e: f64) -> (value: pair) =
    if e == 0.0 and (t == 0.5 or t == -0.5) then
        --  Γ(1) = Γ(2) = 1 exactly, so the factorials come out exact.
        value = (high: 1.0, low: 0.0)
        return
    end if
    p := gamma_c1 + t * (gamma_c2 + t * (gamma_c3 + t * (gamma_c4 + t * (gamma_c5
                                                                         + t * (gamma_c6 + t * (gamma_c7 + t * (gamma_c8 + t * (gamma_c9 + t * (gamma_c10
                                                                                                                                                + t * (gamma_c11 + t * (gamma_c12 + t * (gamma_c13 + t * (gamma_c14 + t * (gamma_c15
                                                                                                                                                                                                                           + t * (gamma_c16 + t * (gamma_c17 + t * (gamma_c18 + t * (gamma_c19 + t * (gamma_c20
                                                                                                                                                                                                                                                                                                      + t * (gamma_c21 + t * (gamma_c22 + t * gamma_c23)))))))))))))))))))))
    --  Γ'(1.5 + t), roughly: enough for the correction, itself below an ulp.
    slope := gamma_c1 + t * (2.0 * gamma_c2 + t * (3.0 * gamma_c3 + t * (4.0 * gamma_c4
                                                                         + t * (5.0 * gamma_c5 + t * 6.0 * gamma_c6))))
    s := gamma_c0_low + t * p + e * slope
    high := gamma_c0_high + s
    value = (high: high, low: (gamma_c0_high - high) + s)
end gamma_base_f64

gamma_f64: (x: f64) -> (result: f64) =
    if x <> x then
        result = x + x
        return
    end if
    if x == 0.0 then
        --  ±inf with zero's sign.
        result = 1.0 / x
        return
    end if
    if x >= 172.0 then
        --  Above 171.62..., Γ overflows.
        result = x * 0x1.0p1023
        return
    end if
    if x < 0.0 and floor_f64(x) == x then
        --  A negative integer, -inf included.
        result = (x - x) / (x - x)
        return
    end if
    if x < -190.0 then
        --  |Γ(x)| < 2^-1100: zero, with the sign of Γ, negative where
        --  floor(x) is odd.  Beyond 2^53 every value is an even integer.
        whole := floor_f64(x)
        odd := whole > -0x1.0p53 and floor_f64(whole * 0.5) * 2.0 <> whole
        result = if odd then -0x1.0p-1074 * 0x1.0p-1074 else 0x1.0p-1074 * 0x1.0p-1074 end if
        return
    end if
    --  The product, held as product * 2^power.
    mut product: pair = (high: 1.0, low: 0.0)
    mut power: i32 = 0
    mut t: f64 = 0.0
    mut e: f64 = 0.0
    above := x >= 2.0
    if above then
        n := floor_f64(x) - 1.0
        y := x - n
        t = y - 1.5
        mut k: f64 = 1.0
        while k <= n do
            product = pair_multiply(product, (high: x - k, low: 0.0))
            if product.high > 0x1.0p500 then
                product = (high: product.high * 0x1.0p-500, low: product.low * 0x1.0p-500)
                power = power + 500
            end if
            k = k + 1.0
        end while
    else
        n := floor_f64(2.0 - x)
        y := two_sum_f64(x, n)
        t = y.high - 1.5
        e = y.low
        mut k: f64 = 0.0
        while k < n do
            product = pair_multiply(product, two_sum_f64(x, k))
            if abs_f64(product.high) < 0x1.0p-500 then
                product = (high: product.high * 0x1.0p500, low: product.low * 0x1.0p500)
                power = power - 500
            elsif abs_f64(product.high) > 0x1.0p500 then
                product = (high: product.high * 0x1.0p-500, low: product.low * 0x1.0p-500)
                power = power + 500
            end if
            k = k + 1.0
        end while
    end if
    base := gamma_base_f64(t, e)
    if above then
        r := pair_multiply(base, product)
        result = scale_f64(r.high + r.low, power)
    else
        --  base / product, the quotient corrected by its remainder.
        q := base.high / product.high
        qp := two_product_f64(q, product.high)
        remainder := ((base.high - qp.high) - qp.low + base.low) - q * product.low
        result = scale_f64(q + remainder / product.high, -power)
    end if
end gamma_f64

gamma_f32: (x: f32) -> (result: f32) =
    if x <> x then
        result = x + x
        return
    end if
    if x == 0.0 then
        result = 1.0 / x
        return
    end if
    if x >= 36.0 then
        result = x * 0x1.0p127
        return
    end if
    if x < 0.0 and floor_f32(x) == x then
        result = (x - x) / (x - x)
        return
    end if
    if x < -50.0 then
        whole := floor_f32(x)
        odd := whole > -0x1.0p24 and floor_f32(whole * 0.5) * 2.0 <> whole
        result = if odd then -0x1.0p-149 * 0x1.0p-149 else 0x1.0p-149 * 0x1.0p-149 end if
        return
    end if
    wx := f64(x)
    mut product: f64 = 1.0
    mut y: f64 = wx
    above := wx >= 2.0
    if above then
        while y >= 2.0 do
            y = y - 1.0
            product = product * y
        end while
    else
        while y < 1.0 do
            product = product * y
            y = y + 1.0
        end while
    end if
    t := y - 1.5
    base := gammaf_c0_high + t * (gammaf_c1 + t * (gammaf_c2 + t * (gammaf_c3
                                                                    + t * (gammaf_c4 + t * (gammaf_c5 + t * (gammaf_c6 + t * (gammaf_c7
                                                                                                                              + t * (gammaf_c8 + t * (gammaf_c9 + t * (gammaf_c10 + t * (gammaf_c11
                                                                                                                                                                                         + t * (gammaf_c12 + t * gammaf_c13))))))))))))
    wide := if above then base * product else base / product end if
    if abs_f64(wide) >= 0x1.ffffffp127 then
        --  Too large for f32: overflow in f32 arithmetic.
        huge: f32 = 0x1.0p127
        result = if wide > 0.0 then huge * huge else -huge * huge end if
        return
    end if
    result = f32(wide)
end gamma_f32
