--  Parsing every integer width, the mirror of the builder's appends, and
--  the one home of parsing in the library (D355): what an append writes,
--  the matching parse reads back.  Each scans from the
--  left and checks its bound before it multiplies, so a refusal is the
--  first one the scan meets and no byte past it is read.  A signed value
--  is an optional `-` and digits, since no append writes a `+`.

--  Decimal digits into a `u32` no greater than `limit`.
scan_u32: (source: []u8, limit: u32)
          -> (result: u32) ! invalid_number | number_overflow =
    fail invalid_number when lenof source == 0
    mut value: u32 = 0
    for byte in source do
        fail invalid_number when byte < u8('0') or byte > u8('9')
        digit: u32 = u32(byte - u8('0'))
        fail number_overflow when value > (limit - digit) / 10
        value = value * 10 + digit
    end for
    result = value
end scan_u32

--  Decimal digits into a `u64` no greater than `limit`.
scan_u64: (source: []u8, limit: u64)
          -> (result: u64) ! invalid_number | number_overflow =
    fail invalid_number when lenof source == 0
    mut value: u64 = 0
    for byte in source do
        fail invalid_number when byte < u8('0') or byte > u8('9')
        digit: u64 = u64(byte - u8('0'))
        fail number_overflow when value > (limit - digit) / 10
        value = value * 10 + digit
    end for
    result = value
end scan_u64

--  Decimal digits into a `usize` no greater than `limit`.
scan_usize: (source: []u8, limit: usize)
            -> (result: usize) ! invalid_number | number_overflow =
    fail invalid_number when lenof source == 0
    mut value: usize = 0
    for byte in source do
        fail invalid_number when byte < u8('0') or byte > u8('9')
        digit: usize = usize(byte - u8('0'))
        fail number_overflow when value > (limit - digit) / 10
        value = value * 10 + digit
    end for
    result = value
end scan_usize

--- Parse nonempty ASCII decimal digits from bytes into `u32`. Rejects an
--- empty slice, signs, whitespace and any other byte with `invalid_number`,
--- and a value above `u32`'s maximum with `number_overflow`, whichever the
--- scan meets first. The bytes need not be UTF-8: a digit is one byte.
--- Leading zeros are accepted, and a refusal reads no byte past the one
--- that caused it.
public parse_u32: (source: []u8)
                  -> (result: u32) ! invalid_number | number_overflow =
    result = try scan_u32(source, 0 -% 1)
end parse_u32

--- Parse nonempty ASCII decimal digits from bytes into `u64`. Refuses as
--- `parse_u32` does, with `number_overflow` above `u64`'s maximum.
public parse_u64: (source: []u8)
                  -> (result: u64) ! invalid_number | number_overflow =
    result = try scan_u64(source, 0 -% 1)
end parse_u64

--- Parse nonempty ASCII decimal digits from bytes into `usize`. Refuses as
--- `parse_u32` does, with `number_overflow` above the target's `usize`
--- maximum, so the same digits can parse on a 64-bit target and overflow on
--- a 32-bit one.
public parse_usize: (source: []u8)
                    -> (result: usize) ! invalid_number | number_overflow =
    result = try scan_usize(source, 0 -% 1)
end parse_usize

--- Parse the decimal digits of UTF-8 text into `u32`, as `parse_u32` parses
--- its bytes.
public to_u32: (source: utf8)
               -> (result: u32) ! invalid_number | number_overflow =
    result = try parse_u32(bytes(source))
end to_u32

--  The digits after a leading `-`, or all of `source` without one.
unsigned_part: (source: []u8) -> (digits: []u8 from source) =
    digits = source
    if lenof source > 0 and source[0] == u8('-') then
        digits = source[1..<lenof source]
    end if
end unsigned_part

--  Whether `source` begins with a `-`.
negative: (source: []u8) -> (yes: bool) =
    yes = lenof source > 0 and source[0] == u8('-')
end negative

--- Parse nonempty ASCII decimal digits from bytes into `u8`, refusing as
--- `parse_u32` does, with `number_overflow` above 255.
public parse_u8: (source: []u8)
                 -> (result: u8) ! invalid_number | number_overflow =
    result = u8(try scan_u32(source, 255))
end parse_u8

--- Parse nonempty ASCII decimal digits from bytes into `u16`, refusing as
--- `parse_u32` does, with `number_overflow` above 65,535.
public parse_u16: (source: []u8)
                  -> (result: u16) ! invalid_number | number_overflow =
    result = u16(try scan_u32(source, 65535))
end parse_u16

--- Parse an `i8` from bytes: an optional `-` and nonempty ASCII decimal
--- digits.  Refuses an empty slice, a lone `-`, a `+`, whitespace and any
--- other byte with `invalid_number`, and a value outside -128 to 127 with
--- `number_overflow`, whichever the scan meets first.
public parse_i8: (source: []u8)
                 -> (result: i8) ! invalid_number | number_overflow =
    if negative(source) then
        magnitude: u32 = try scan_u32(unsigned_part(source), 128)
        result = i8(0 - i32(magnitude))
    else
        result = i8(try scan_u32(source, 127))
    end if
end parse_i8

--- Parse an `i16` from bytes, as `parse_i8` does, within -32,768 to
--- 32,767.
public parse_i16: (source: []u8)
                  -> (result: i16) ! invalid_number | number_overflow =
    if negative(source) then
        magnitude: u32 = try scan_u32(unsigned_part(source), 32768)
        result = i16(0 - i32(magnitude))
    else
        result = i16(try scan_u32(source, 32767))
    end if
end parse_i16

--- Parse an `i32` from bytes, as `parse_i8` does, within `i32`'s range.
public parse_i32: (source: []u8)
                  -> (result: i32) ! invalid_number | number_overflow =
    if negative(source) then
        magnitude: u32 = try scan_u32(unsigned_part(source), 2147483648)
        if magnitude == 2147483648 then
            result = 0 - 2147483647 - 1
        else
            result = 0 - i32(magnitude)
        end if
    else
        result = i32(try scan_u32(source, 2147483647))
    end if
end parse_i32

--- Parse an `i64` from bytes, as `parse_i8` does, within `i64`'s range.
public parse_i64: (source: []u8)
                  -> (result: i64) ! invalid_number | number_overflow =
    if negative(source) then
        magnitude: u64 = try scan_u64(unsigned_part(source),
                                      9223372036854775808)
        if magnitude == 9223372036854775808 then
            result = 0 - 9223372036854775807 - 1
        else
            result = 0 - i64(magnitude)
        end if
    else
        result = i64(try scan_u64(source, 9223372036854775807))
    end if
end parse_i64

--- Parse an `isize` from bytes, as `parse_i8` does, within the target's
--- `isize` range, so the same digits can parse on a 64-bit target and
--- overflow on a 32-bit one.
public parse_isize: (source: []u8)
                    -> (result: isize) ! invalid_number | number_overflow =
    largest: usize = (0 -% 1) >> 1
    if negative(source) then
        magnitude: usize = try scan_usize(unsigned_part(source), largest + 1)
        if magnitude == largest + 1 then
            result = 0 - isize(largest) - 1
        else
            result = 0 - isize(magnitude)
        end if
    else
        result = isize(try scan_usize(source, largest))
    end if
end parse_isize

--  A hexadecimal digit's value, or 16 for a byte that is not one.
hex_value: (byte: u8) -> (value: u8) =
    value = 16
    if byte >= u8('0') and byte <= u8('9') then
        value = byte - u8('0')
    elsif byte >= u8('a') and byte <= u8('f') then
        value = byte - u8('a') + 10
    elsif byte >= u8('A') and byte <= u8('F') then
        value = byte - u8('A') + 10
    end if
end hex_value

--- Parse nonempty hexadecimal digits from bytes into `u32`: `0` to `9`
--- and `a` to `f` in either case, with no `0x`, sign or space.  Refuses
--- any other byte or an empty slice with `invalid_number` and a value
--- above `u32`'s maximum with `number_overflow`, whichever the scan meets
--- first.
public parse_hex_u32: (source: []u8)
                      -> (result: u32) ! invalid_number | number_overflow =
    fail invalid_number when lenof source == 0
    mut value: u32 = 0
    for byte in source do
        digit: u8 = hex_value(byte)
        fail invalid_number when digit == 16
        fail number_overflow when value > u32(0 -% 1) >> 4
        value = (value << 4) | u32(digit)
    end for
    result = value
end parse_hex_u32

--- Parse hexadecimal digits from bytes into `u64`, as `parse_hex_u32`
--- does.
public parse_hex_u64: (source: []u8)
                      -> (result: u64) ! invalid_number | number_overflow =
    fail invalid_number when lenof source == 0
    mut value: u64 = 0
    for byte in source do
        digit: u8 = hex_value(byte)
        fail invalid_number when digit == 16
        fail number_overflow when value > u64(0 -% 1) >> 4
        value = (value << 4) | u64(digit)
    end for
    result = value
end parse_hex_u64

--- Parse hexadecimal digits from bytes into `usize`, as `parse_hex_u32`
--- does, at the target's width.
public parse_hex_usize: (source: []u8)
                        -> (result: usize) ! invalid_number | number_overflow =
    fail invalid_number when lenof source == 0
    mut value: usize = 0
    for byte in source do
        digit: u8 = hex_value(byte)
        fail invalid_number when digit == 16
        fail number_overflow when value > usize(0 -% 1) >> 4
        value = (value << 4) | usize(digit)
    end for
    result = value
end parse_hex_usize

--- Parse decimal text into the `f64` nearest it, ties to even: an
--- optional `-`, digits with an optional point and at least one digit
--- beside it, `1.5`, `2.`, `.25`, and an optional exponent, `e` or `E`
--- with an optional sign, `6.02e23`, `1e-7`; or `inf`, `infinity` or
--- `nan` in any case, after an optional `-`.  So it reads back
--- everything `append_f64` and the formats write, and C's and Rust's
--- decimal floats.  Refuses an empty slice, a `+` before the number,
--- whitespace, `_`, hexadecimal and any other byte with
--- `invalid_number`, and a finite decimal whose nearest `f64` is beyond
--- the greatest with `number_overflow`.  A decimal too small for the
--- least subnormal is zero of its sign.  Any number of digits is read,
--- and rounded once.
public parse_f64: (source: []u8) -> (result: f64) ! invalid_number | number_overflow =
    bits: u64 = try f64_bits(source)
    view: ptr f64 = ptr(usize(addr bits))
    result = view.val
end parse_f64

--- Parse decimal text into the `f32` nearest it, as `parse_f64` does,
--- rounded once from the decimal rather than through an `f64`.
public parse_f32: (source: []u8) -> (result: f32) ! invalid_number | number_overflow =
    bits: u32 = try f32_bits(source)
    view: ptr f32 = ptr(usize(addr bits))
    result = view.val
end parse_f32

--  Parsing in a radix from 2 to 36: digits `0` to `9`, then `a` to `z` in
--  either case for ten to thirty-five, each below the radix.  The prefix
--  that names the radix, `0x` for 16, `0o` for 8 and `0b` for 2, in
--  either case, may come first, after a signed value's `-`; no other
--  radix has one, so in radix 16 "0b1" is the digits b and 1.

--  A digit's value in radix 36, or 36 for a byte that is not one.
radix_value: (byte: u8) -> (value: u32) =
    value = 36
    if byte >= u8('0') and byte <= u8('9') then
        value = u32(byte - u8('0'))
    elsif byte >= u8('a') and byte <= u8('z') then
        value = u32(byte - u8('a')) + 10
    elsif byte >= u8('A') and byte <= u8('Z') then
        value = u32(byte - u8('A')) + 10
    end if
end radix_value

--  `source` without the prefix that names `radix`, when it has one.
unprefixed: (source: []u8, radix: u32) -> (digits: []u8 from source) =
    digits = source
    return when lenof source < 2 or source[0] <> u8('0')
    mark: u8 = source[1] | 32
    if (radix == 16 and mark == u8('x')) or (radix == 8 and mark == u8('o'))
      or (radix == 2 and mark == u8('b'))
    then
        digits = source[2..<lenof source]
    end if
end unprefixed

--  Digits in `radix`, after its optional prefix, into a `u32` no greater
--  than `limit`.  A radix outside 2 to 36 reads nothing.
scan_radix_u32: (source: []u8, radix: u32, limit: u32)
                -> (result: u32) ! invalid_number | number_overflow =
    fail invalid_number when radix < 2 or radix > 36
    digits: []u8 = unprefixed(source, radix)
    fail invalid_number when lenof digits == 0
    mut value: u32 = 0
    for byte in digits do
        digit: u32 = radix_value(byte)
        fail invalid_number when digit >= radix
        fail number_overflow when value > (limit - digit) / radix
        value = value * radix + digit
    end for
    result = value
end scan_radix_u32

--  Digits in `radix` into a `u64` no greater than `limit`.
scan_radix_u64: (source: []u8, radix: u32, limit: u64)
                -> (result: u64) ! invalid_number | number_overflow =
    fail invalid_number when radix < 2 or radix > 36
    digits: []u8 = unprefixed(source, radix)
    fail invalid_number when lenof digits == 0
    base: u64 = u64(radix)
    mut value: u64 = 0
    for byte in digits do
        digit: u32 = radix_value(byte)
        fail invalid_number when digit >= radix
        fail number_overflow when value > (limit - u64(digit)) / base
        value = value * base + u64(digit)
    end for
    result = value
end scan_radix_u64

--  Digits in `radix` into a `usize` no greater than `limit`.
scan_radix_usize: (source: []u8, radix: u32, limit: usize)
                  -> (result: usize) ! invalid_number | number_overflow =
    fail invalid_number when radix < 2 or radix > 36
    digits: []u8 = unprefixed(source, radix)
    fail invalid_number when lenof digits == 0
    base: usize = usize(radix)
    mut value: usize = 0
    for byte in digits do
        digit: u32 = radix_value(byte)
        fail invalid_number when digit >= radix
        fail number_overflow when value > (limit - usize(digit)) / base
        value = value * base + usize(digit)
    end for
    result = value
end scan_radix_usize

--- Parse digits in `radix`, 2 to 36, from bytes into `u8`: `0` to `9` and
--- then `a` to `z` in either case, each below the radix, after an optional
--- `0x` when the radix is 16, `0o` when it is 8 or `0b` when it is 2.
--- Refuses an empty slice, a prefix with no digits after it, a sign, a
--- digit not below the radix and any other byte with `invalid_number`,
--- as it does every source when the radix is outside 2 to 36, and a value
--- above 255 with `number_overflow`, whichever the scan meets first.
public parse_radix_u8: (source: []u8, radix: u32)
                       -> (result: u8) ! invalid_number | number_overflow =
    result = u8(try scan_radix_u32(source, radix, 255))
end parse_radix_u8

--- Parse digits in `radix` into `u16`, as `parse_radix_u8` does, up to
--- 65,535.
public parse_radix_u16: (source: []u8, radix: u32)
                        -> (result: u16) ! invalid_number | number_overflow =
    result = u16(try scan_radix_u32(source, radix, 65535))
end parse_radix_u16

--- Parse digits in `radix` into `u32`, as `parse_radix_u8` does.
public parse_radix_u32: (source: []u8, radix: u32)
                        -> (result: u32) ! invalid_number | number_overflow =
    result = try scan_radix_u32(source, radix, 0 -% 1)
end parse_radix_u32

--- Parse digits in `radix` into `u64`, as `parse_radix_u8` does.
public parse_radix_u64: (source: []u8, radix: u32)
                        -> (result: u64) ! invalid_number | number_overflow =
    result = try scan_radix_u64(source, radix, 0 -% 1)
end parse_radix_u64

--- Parse digits in `radix` into `usize`, as `parse_radix_u8` does, at the
--- target's width.
public parse_radix_usize: (source: []u8, radix: u32)
                          -> (result: usize)
                          ! invalid_number | number_overflow =
    result = try scan_radix_usize(source, radix, 0 -% 1)
end parse_radix_usize

--- Parse an `i8` in `radix`: an optional `-`, then what `parse_radix_u8`
--- reads, so "-0x80" in radix 16 is -128.  Refuses as `parse_radix_u8`
--- does, a lone `-` and a `+` with `invalid_number`, and a value outside
--- -128 to 127 with `number_overflow`.
public parse_radix_i8: (source: []u8, radix: u32)
                       -> (result: i8) ! invalid_number | number_overflow =
    if negative(source) then
        magnitude: u32 = try scan_radix_u32(unsigned_part(source), radix, 128)
        result = i8(0 - i32(magnitude))
    else
        result = i8(try scan_radix_u32(source, radix, 127))
    end if
end parse_radix_i8

--- Parse an `i16` in `radix`, as `parse_radix_i8` does, within -32,768
--- to 32,767.
public parse_radix_i16: (source: []u8, radix: u32)
                        -> (result: i16) ! invalid_number | number_overflow =
    if negative(source) then
        magnitude: u32 = try scan_radix_u32(unsigned_part(source), radix,
                                            32768)
        result = i16(0 - i32(magnitude))
    else
        result = i16(try scan_radix_u32(source, radix, 32767))
    end if
end parse_radix_i16

--- Parse an `i32` in `radix`, as `parse_radix_i8` does, within `i32`'s
--- range.
public parse_radix_i32: (source: []u8, radix: u32)
                        -> (result: i32) ! invalid_number | number_overflow =
    if negative(source) then
        magnitude: u32 = try scan_radix_u32(unsigned_part(source), radix,
                                            2147483648)
        if magnitude == 2147483648 then
            result = 0 - 2147483647 - 1
        else
            result = 0 - i32(magnitude)
        end if
    else
        result = i32(try scan_radix_u32(source, radix, 2147483647))
    end if
end parse_radix_i32

--- Parse an `i64` in `radix`, as `parse_radix_i8` does, within `i64`'s
--- range.
public parse_radix_i64: (source: []u8, radix: u32)
                        -> (result: i64) ! invalid_number | number_overflow =
    if negative(source) then
        magnitude: u64 = try scan_radix_u64(unsigned_part(source), radix,
                                            9223372036854775808)
        if magnitude == 9223372036854775808 then
            result = 0 - 9223372036854775807 - 1
        else
            result = 0 - i64(magnitude)
        end if
    else
        result = i64(try scan_radix_u64(source, radix, 9223372036854775807))
    end if
end parse_radix_i64

--- Parse an `isize` in `radix`, as `parse_radix_i8` does, within the
--- target's `isize` range.
public parse_radix_isize: (source: []u8, radix: u32)
                          -> (result: isize)
                          ! invalid_number | number_overflow =
    largest: usize = (0 -% 1) >> 1
    if negative(source) then
        magnitude: usize = try scan_radix_usize(unsigned_part(source), radix,
                                                largest + 1)
        if magnitude == largest + 1 then
            result = 0 - isize(largest) - 1
        else
            result = 0 - isize(magnitude)
        end if
    else
        result = isize(try scan_radix_usize(source, radix, largest))
    end if
end parse_radix_isize

--- Parse `true` or `false`, exactly and in lower case, as `format` writes
--- a `bool`.  Any other bytes, an empty slice, `True` and `1`
--- included, refuse `invalid_bool`.
public parse_bool: (source: []u8) -> (result: bool) ! invalid_bool =
    if bytes_equal(source, "true") then
        result = true
    elsif bytes_equal(source, "false") then
        result = false
    else
        fail invalid_bool
    end if
end parse_bool

--  Whether two byte slices hold the same bytes.
bytes_equal: (left: []u8, right: []u8) -> (yes: bool) =
    yes = lenof left == lenof right and bytes_start_with(left, right)
end bytes_equal
