composite_block: (key: u32) -> (value: usize) =
    value = usize(0)
    return when key >= 0x4400
    mut at: usize = usize(composite_block_top[usize(key >> 10)])
    at = usize(composite_block_stage3[(at << 3) | usize((key >> 7) & 7)])
    at = usize(composite_block_stage2[(at << 3) | usize((key >> 4) & 7)])
    at = usize(composite_block_stage1[(at << 2) | usize((key >> 2) & 3)])
    value = usize(composite_block_leaves[(at << 2) | usize(key & 3)])
end composite_block
