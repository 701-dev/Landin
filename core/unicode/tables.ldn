grapheme_code: (key: u32) -> (value: u8) =
    value = u8(0)
    return when key >= 0x110000
    mut at: usize = usize(grapheme_code_top[usize(key >> 13)])
    at = usize(grapheme_code_stage3[(at << 4) | usize((key >> 9) & 15)])
    at = usize(grapheme_code_stage2[(at << 3) | usize((key >> 6) & 7)])
    at = usize(grapheme_code_stage1[(at << 4) | usize((key >> 2) & 15)])
    value = u8(grapheme_code_leaves[(at << 2) | usize(key & 3)])
end grapheme_code

