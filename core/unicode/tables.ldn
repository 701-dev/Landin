combining_code: (key: u32) -> (value: u8) =
    value = u8(0)
    return when key >= 0x110000
    mut at: usize = usize(combining_code_top[usize(key >> 12)])
    at = usize(combining_code_stage3[(at << 5) | usize((key >> 7) & 31)])
    at = usize(combining_code_stage2[(at << 3) | usize((key >> 4) & 7)])
    at = usize(combining_code_stage1[(at << 2) | usize((key >> 2) & 3)])
    value = u8(combining_code_leaves[(at << 2) | usize(key & 3)])
end combining_code

