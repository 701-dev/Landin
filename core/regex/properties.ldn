--  The names \p takes: the general categories and their groups, by short
--  and long name, and the binary properties core/unicode holds.  A name
--  is matched loosely, as Unicode's UAX44-LM3 says: case, spaces,
--  underscores and hyphens are ignored, so `\p{Letter}`, `\p{letter}` and
--  `\p{L}` are one.  `gc=` or `General_Category=` may come before a
--  category.

import core/text

property_entry: type = struct
    name: utf8
    categories: u32
    flags: u8
end property_entry

all_categories: u32 = 0x3fff_ffff

properties: [74]property_entry = [
    (name: "l", categories: letters_mask, flags: 0),
    (name: "letter", categories: letters_mask, flags: 0),
    (name: "lc", categories: cased_letters_mask, flags: 0),
