more_properties: [21]property_entry = [
    (name: "cs", categories: 0x8000000, flags: 0),
    (name: "surrogate", categories: 0x8000000, flags: 0),
    (name: "co", categories: 0x10000000, flags: 0),
    (name: "privateuse", categories: 0x10000000, flags: 0),
