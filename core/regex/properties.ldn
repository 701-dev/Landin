    (name: "unassigned", categories: 0x20000000, flags: 0),
    (name: "any", categories: all_categories, flags: 0),
    (name: "assigned", categories: all_categories & ~0x20000000, flags: 0),
    (name: "alphabetic", categories: 0, flags: alphabetic_flag),
    (name: "alpha", categories: 0, flags: alphabetic_flag),
    (name: "whitespace", categories: 0, flags: white_space_flag),
    (name: "wspace", categories: 0, flags: white_space_flag),
    (name: "space", categories: 0, flags: white_space_flag),
