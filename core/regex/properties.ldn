    (name: "ascii", categories: 0, flags: 0)
]

--  The categories and flags a property name names, or whether it is
--  `ASCII`.  A name core/unicode holds no table for, a script's among
--  them, is `unsupported_pattern`.
property_named: (name: []u8) -> (categories: u32, flags: u8, ascii: bool)
                ! invalid_pattern | unsupported_pattern =
    categories = 0
    flags = 0
    ascii = false
    mut loose: [48]u8 = zeroed
    mut count: usize = 0
    mut value_at: usize = 0
    for byte in name do
        if byte == u8('=') or byte == u8(':') then
            fail invalid_pattern when value_at <> 0
            value_at = count
            continue
        end if
        continue when byte == u8(' ') or byte == u8('_') or byte == u8('-')
        fail unsupported_pattern when count == lenof loose
        loose[count] = if byte >= u8('A') and byte <= u8('Z') then byte | 0x20
                       else byte end if
        inc count
    end for
    fail invalid_pattern when count == 0
    mut value: []u8 = loose[0..<count]
    if value_at > 0 then
        key: []u8 = loose[0..<value_at]
        fail unsupported_pattern when not same_bytes(key, "gc")
          and not same_bytes(key, "generalcategory")
        value = loose[value_at..<count]
    end if
    for entry in properties do
        if same_bytes(text.bytes(entry.name), value) then
            categories = entry.categories
            flags = entry.flags
            return
        end if
    end for
    for entry in more_properties do
        if same_bytes(text.bytes(entry.name), value) then
            categories = entry.categories
            flags = entry.flags
            ascii = categories == 0 and flags == 0
            fail unsupported_pattern when value_at > 0 and categories == 0
            return
        end if
    end for
    fail unsupported_pattern
end property_named
