--  A deterministic generator of pseudorandom numbers: xoshiro256** 1.0,
--  by David Blackman and Sebastiano Vigna, "Scrambled linear pseudorandom
--  number generators", ACM Transactions on Mathematical Software 47(4),
--  2021, from their public-domain reference implementation at
--  https://prng.di.unimi.it/xoshiro256starstar.c, seeded from a 64-bit
--  seed through their splitmix64.c, as they suggest.  It is written with
--  shifts, exclusive ors and additions on `u64`, so a seed gives the same
--  sequence on every target, a 32-bit Cortex-M0 included, and its
--  multiplications by 5 and 9 are a shift and an addition each.  Its
--  `jump` is the same reference implementation's.  The draws over it,
--  floats, ranges, picks, samples, bytes and the normal and exponential
--  distributions, are this module's own, each stated where it is written;
--  `core/math` is the same on every target, so they are too.

import core/cmp
import core/io
import core/math

state_value: type = struct
    s0: u64
    s1: u64
    s2: u64
    s3: u64
end state_value

--- A generator: 256 bits of state that each draw advances.  It is a value
--- the caller keeps and passes `inout`.  A seed always gives the same
--- sequence, on every target, which is what makes it useful for tests,
--- simulations and sampling.  A generator is not cryptographic, and its
--- outputs reveal its state, so never make a key, a token or a password
--- with one: take those from `io.fill_random` directly.  Copying a
--- generator copies its state, and the copy repeats what the original
--- will draw.
public generator: type = state_value

--  splitmix64's step: advance `seed` by the golden ratio and mix it.
splitmix: (inout seed: u64) -> (value: u64) =
    seed = seed +% 0x9e3779b97f4a7c15
    mut z: u64 = seed
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    value = z ^ (z >> 31)
end splitmix

--- A generator seeded from `seed`: its state is four outputs of
--- splitmix64 started at `seed`, as the authors suggest, which are never
--- all zero.  Seed 0 gives first 11091344671253066420, as the reference
--- implementation does.
public new: (seed: u64) -> (result: generator) =
    mut at: u64 = seed
    first: u64 = splitmix(at)
    second: u64 = splitmix(at)
    third: u64 = splitmix(at)
    fourth: u64 = splitmix(at)
    result = (s0: first, s1: second, s2: third, s3: fourth)
end new

--- A generator seeded from 32 bytes of the provider's entropy, read as
--- four little-endian `u64`s, so no two runs repeat each other.  The one
--- state xoshiro256** cannot leave, all zero, is replaced by `new(0)`'s.
--- It fails as the provider fails.
public from_entropy: (provider: type is io.entropy, host: provider)
                     -> (result: generator) ! io.io_failed =
    mut bytes: [32]u8 = zeroed
    try io.fill_random(host, bytes[0..<32])
    result = (s0: little_endian(bytes[0..<8]),
              s1: little_endian(bytes[8..<16]),
              s2: little_endian(bytes[16..<24]),
              s3: little_endian(bytes[24..<32]))
    if result.s0 == 0 and result.s1 == 0 and result.s2 == 0
      and result.s3 == 0 then
        result = new(0)
    end if
end from_entropy

--- A hash seed for a map keyed by outside data: 16 bytes of the
--- provider's entropy, read as two little-endian `u64`s and given to
--- `cmp.seed_from`.  No generator is involved, so nothing a program draws
--- from one reveals it.  It fails as the provider fails.
public hash_seed: (provider: type is io.entropy, host: provider)
                  -> (seed: cmp.hash_seed) ! io.io_failed =
    mut bytes: [16]u8 = zeroed
    try io.fill_random(host, bytes[0..<16])
    seed = cmp.seed_from(little_endian(bytes[0..<8]),
                         little_endian(bytes[8..<16]))
end hash_seed

--  The eight bytes of `bytes`, least significant first.
little_endian: (bytes: []u8) -> (value: u64) =
    value = 0
    for index in usize(0)..<8 do
        value = value | (u64(bytes[index]) << u64(8 * index))
    end for
end little_endian

--  `value` rotated left by `count` bits, 0 < count < 64.
rotate: (value: u64, count: u64) -> (result: u64) =
    result = (value << count) | (value >> (64 - count))
end rotate

--- The next 64 bits of the sequence, each value equally likely.
public next: (inout source: generator) -> (value: u64) =
    s1: u64 = source.s1
    times_five: u64 = (s1 << 2) +% s1
    rotated: u64 = rotate(times_five, 7)
    value = (rotated << 3) +% rotated
    t: u64 = s1 << 17
    source.s2 = source.s2 ^ source.s0
    source.s3 = source.s3 ^ source.s1
    source.s1 = source.s1 ^ source.s2
    source.s0 = source.s0 ^ source.s3
    source.s2 = source.s2 ^ t
    source.s3 = rotate(source.s3, 45)
end next

--- The next 32 bits of the sequence: the upper half of `next`.  Every
--- bit of xoshiro256**'s output passes its authors' tests, unlike the low
--- bits of xoshiro256+, so either half would do; the upper is the one
--- their reference code keeps when it narrows a draw.
public next_u32: (inout source: generator) -> (value: u32) =
    value = u32(next(source) >> 32)
end next_u32

--- A value from 0 to `bound - 1`, each equally likely.  It takes the next
--- draw's bits below `bound`'s highest bit and draws again while they are
--- `bound` or more, which is never more often than not.  So no value is
--- favoured, as a remainder would favour some, and it uses no division.
--- A `bound` of zero has no value below it, and traps as a remainder by
--- zero does, with `overflow`.
public below: (inout source: generator, bound: u64) -> (value: u64) =
    --  A bound of zero is the remainder's zero divisor, which this checked
    --  subtraction meets as `%` would.
    mut mask: u64 = bound - 1
    mask = mask | (mask >> 1)
    mask = mask | (mask >> 2)
    mask = mask | (mask >> 4)
    mask = mask | (mask >> 8)
    mask = mask | (mask >> 16)
    mask = mask | (mask >> 32)
    loop do
        value = next(source) & mask
        return when value < bound
    end loop
end below

--- Put `values` in an order drawn uniformly from every order they could
--- have, by Fisher and Yates's shuffle: from the last, each is swapped
--- with one drawn by `below` from those before it and itself.
public shuffle: (item: type, values: []mut item, inout source: generator)
                -> none =
    mut at: usize = lenof values
    while at > 1 do
        chosen: usize = usize(below(source, u64(at)))
        dec at
        saved: item = values[at]
        values[at] = values[chosen]
        values[chosen] = saved
    end while
end shuffle

--- A float from 0 up to but not including 1: the next draw's upper 53
--- bits, each of the 2^53 multiples of 2^-53 below 1 equally likely.
--- Every value is exact, and 1 is never drawn.
public unit_f64: (inout source: generator) -> (value: f64) =
    value = f64(next(source) >> 11) * 0x1.0p-53
end unit_f64

--- A float from 0 up to but not including 1: the next draw's upper 24
--- bits, each of the 2^24 multiples of 2^-24 below 1 equally likely.
public unit_f32: (inout source: generator) -> (value: f32) =
    value = f32(next(source) >> 40) * 0x1.0p-24
end unit_f32

--- A value from `low` to `high`, both included, each equally likely: `low`
--- and `below` of the range's width, or the next draw whole when the range
--- is every `u64`.  A `low` above `high` is no range, and traps with
--- `overflow`, as the width's checked subtraction does.
public between_u64: (inout source: generator, low: u64, high: u64)
                    -> (value: u64) =
    width: u64 = high - low
    if width == 18446744073709551615 then
        value = next(source)
    else
        value = low + below(source, width + 1)
    end if
end between_u64

--  `value`'s place among the `i64`s as a `u64`, which keeps their order:
--  -2^63 is 0 and 2^63 - 1 is the largest `u64`.
signed_place: (value: i64) -> (place: u64) =
    if value < 0 then
        place = u64((value + 1) + 9223372036854775807)
    else
        place = u64(value) + 9223372036854775808
    end if
end signed_place

--  The `i64` at `place`, as `signed_place` numbers them.
signed_at: (place: u64) -> (value: i64) =
    if place < 9223372036854775808 then
        value = (i64(place) - 9223372036854775807) - 1
    else
        value = i64(place - 9223372036854775808)
    end if
end signed_at

--- A value from `low` to `high`, both included, each equally likely, over
--- every `i64` from -2^63 to 2^63 - 1.  A half-open range from `low` to
--- `high` is `between_i64(source, low, high - 1)`.  A `low` above `high`
--- traps with `overflow`, as `between_u64` does.
public between_i64: (inout source: generator, low: i64, high: i64)
                    -> (value: i64) =
    value = signed_at(between_u64(source, signed_place(low),
                                  signed_place(high)))
end between_i64

--- One of `values`, each place equally likely, drawn by `below`.  An empty
--- slice has none, and traps with `overflow`, as `below` of zero does.
public pick: (item: type, inout source: generator, values: []item)
             -> (chosen: item) =
    chosen = values[usize(below(source, u64(lenof values)))]
end pick

--- Fill `into` with as many of `values` as it has places, drawn without
--- replacement, every choice of them equally likely, kept in the order
--- they have in `values`.  It is Knuth's selection sampling, his Algorithm
--- S: each of `values` in turn is taken when a draw `below` those left is
--- under the number still wanted, so it makes at most one draw for each
--- of `values` and needs no storage of its own.  Put the result through
--- `shuffle` when its order should be drawn too.  An `into` longer than
--- `values` cannot be filled, and traps with `overflow`.
public sample: (item: type, into: []mut item, inout source: generator,
                values: []item) -> none =
    mut left: usize = lenof values
    mut wanted: usize = lenof into
    --  More wanted than there are is the checked subtraction's overflow.
    _ = left - wanted
    mut at: usize = 0
    for value in values do
        return when wanted == 0
        if below(source, u64(left)) < u64(wanted) then
            into[at] = value
            inc at
            dec wanted
        end if
        dec left
    end for
end sample

--- A place in `weights` drawn with the chance its weight is of their sum:
--- a draw `below` the sum, and the first place whose running total
--- passes it.  A weight of zero is never drawn.  Weights whose sum is
--- zero have no place to draw, and trap with `overflow`, as `below` of
--- zero does, and so does a sum past the largest `u64`.
public weighted: (inout source: generator, weights: []u64)
                 -> (index: usize) =
    mut total: u64 = 0
    for weight in weights do
        total = total + weight
    end for
    drawn: u64 = below(source, total)
    mut running: u64 = 0
    index = 0
    for weight in weights do
        running = running + weight
        return when drawn < running
        inc index
    end for
end weighted

--- Fill `bytes` from the generator: each eight of them a draw, least
--- significant byte first, and a last part shorter than eight the low
--- bytes of one more draw.  Bytes for a key, a token or a password come
--- from `io.fill_random` instead.
public fill: (bytes: []mut u8, inout source: generator) -> none =
    mut at: usize = 0
    while at < lenof bytes do
        mut value: u64 = next(source)
        mut count: usize = 0
        while count < 8 and at < lenof bytes do
            bytes[at] = u8(value & 0xff)
            value = value >> 8
            inc at
            inc count
        end while
    end while
end fill

--- A draw from the standard normal distribution, mean 0 and standard
--- deviation 1; `mean + deviation * normal(source)` draws from any other.
--- It is Marsaglia's polar method: a point drawn by `unit_f64` in the
--- square from -1 to 1 is drawn again until it is inside the unit circle
--- and not its centre, about one time in five, and its first coordinate
--- times `sqrt(-2 log s / s)`, `s` its squared distance, is normal.  The
--- method makes two values; the second is not kept, so the generator
--- holds no more than its state.
public normal: (inout source: generator) -> (value: f64) =
    loop do
        u: f64 = 2.0 * unit_f64(source) - 1.0
        v: f64 = 2.0 * unit_f64(source) - 1.0
        s: f64 = u * u + v * v
        if s < 1.0 and s > 0.0 then
            value = u * math.sqrt(-2.0 * math.log(s) / s)
            return
        end if
    end loop
end normal

--- A draw from the exponential distribution of rate 1, whose mean is 1;
--- dividing it by a rate draws from that rate's.  It is the inverse of
--- the distribution: `-log(1 - u)` for `u` drawn by `unit_f64`, which is
--- below 1, so the logarithm is of a value above 0 and the draw is finite.
public exponential: (inout source: generator) -> (value: f64) =
    value = 0.0 - math.log(1.0 - unit_f64(source))
end exponential

--  The reference implementation's polynomial for a jump of 2^128 draws.
jump_polynomial: [4]u64 = [0x180ec6d33cfd0aba, 0xd5a61266f0c9392c,
                           0xa9582618e03fc9aa, 0x39abdc4529b1661c]

--- Advance the generator as 2^128 draws would, as the reference
--- implementation's `jump` does.  A copy of a generator jumped once, a
--- copy of that jumped again and so on start 2^128 draws apart, so as
--- many threads or fibres as there are copies each draw a sequence of
--- their own from one seed, none overlapping another's within 2^128 draws.
public jump: (inout source: generator) -> none =
    mut result: generator = (s0: 0, s1: 0, s2: 0, s3: 0)
    for word in jump_polynomial do
        for bit in u64(0)..<64 do
            if (word >> bit) & 1 == 1 then
                result.s0 = result.s0 ^ source.s0
                result.s1 = result.s1 ^ source.s1
                result.s2 = result.s2 ^ source.s2
                result.s3 = result.s3 ^ source.s3
            end if
            _ = next(source)
        end for
    end for
    source = result
end jump
