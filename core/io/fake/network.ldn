--  A network in memory, beside the memory world: a provider of `net.network`
--  whose sockets are the caller's records, for a test that runs a client
--  and a server in one thread, or in fibres that take turns, and wants the
--  same answer every run.

import core/fibre
import core/io
import core/mem
import core/net
import core/text
import core/time

--- Caller-owned state of a memory network: the next port it gives a socket
--- bound to port 0, its counters, and what a test may set.  Declare it
--- `zeroed` and give it to `network_over`, which fills it; it must outlive
--- the network's handle.  `without_ipv6` makes IPv6 missing, as on a
--- system that does not have it, so every IPv6 address is
--- `address_unavailable`.  `fail_at` names the call of the network that
--- fails `io_failed`, counted from one in `calls`; zero fails none.
--- `connections` counts connections made, `datagrams` datagrams delivered
--- and `losses` datagrams no socket took.  `moves` counts what changed
--- something a call may wait for: a connection made or taken, bytes or a
--- datagram delivered or taken, a shutdown, a close and the advance of a
--- clock `clock_over_beside` made beside it.  `turns` counts the turns its
--- calls took while they waited, and `sleepers` the fibres sleeping on
--- such a clock.
public network_space: type = struct
    next_port: usize
    arrivals: usize
    calls: usize
    fail_at: usize
    without_ipv6: bool
    connections: usize
    datagrams: usize
    losses: usize
    moves: usize
    turns: usize
    sleepers: usize
end network_space

--  What a socket record is: free for the network to open, a listener, one
--  end of a connection, or a datagram socket.  A routine that takes any
--  open socket asks for `free_slot`, which no open socket is.
free_slot: atom
listening_slot: atom
connection_slot: atom
datagram_slot: atom
socket_role: type = free_slot | listening_slot | connection_slot
    | datagram_slot

--- One socket of a memory network, the caller's: `buffer` holds what has
--- arrived for it and not yet been received, its receive buffer, so a
--- send that does not fit waits as a real one would.  Make each with
--- `socket_over`; the other fields are the network's.  A free record is
--- a socket the network can open; one that is open is a file of the
--- network until `close` frees it again.
public network_socket: type = struct
    buffer: []mut u8
    role: socket_role
    local: net.address
    peer: net.address
    partner: usize
    listener: usize
    order: usize
    pending: bool
    start: usize
    filled: usize
    receiving_closed: bool
    sending_closed: bool
    peer_finished: bool
    peer_gone: bool
    receive_limit: u64
    send_limit: u64
    no_delay: bool
    named: bool
    path: [108]u8
    path_length: usize
    flags: u8
    numbers: [4]u32
    spans: [2]u64
    lingering: bool
    linger_limit: u64
    group: net.address
    joined: bool
    interface: net.address
end network_socket

--- A free socket record whose received bytes wait in `buffer`.
public socket_over: (buffer: []mut u8)
                    -> (slot: network_socket from buffer) =
    slot = (buffer: buffer, role: free_slot,
            local: net.unspecified(net.ipv4, 0), peer: net.unspecified(net.ipv4, 0),
            partner: 0, listener: 0, order: 0, pending: false, start: 0,
            filled: 0, receiving_closed: false, sending_closed: false,
            peer_finished: false, peer_gone: false, receive_limit: 0,
            send_limit: 0, no_delay: false, named: false, path: zeroed,
            path_length: 0, flags: 0, numbers: zeroed, spans: zeroed,
            lingering: false, linger_limit: 0,
            group: net.unspecified(net.ipv4, 0), joined: false,
            interface: net.unspecified(net.ipv4, 0))
end socket_over

network_value: type = struct
    state: ptr mut network_space
    sockets: []mut network_socket
    runs: any fibre.turns
    takes_turns: bool
    names: []u8
end network_value

--- A network of one machine in memory, a provider of `network`, `reader`
--- and `writer` over the caller's socket records; copies share them.  Its
--- only interfaces are the loopback addresses, `127.0.0.0/8` and `::1`:
--- binding another address is `address_unavailable`, connecting to one
--- `unreachable`, and connecting to a port nothing listens on `refused`.
--- A port is in use for a binding of its family that the address of
--- another socket of its protocol at that port would also take, the
--- unspecified address taking every one, as Linux has it; Darwin and
--- FreeBSD let a listener take a specific address beside one on the
--- unspecified address.
--- A connection and a datagram arrive at once, whole and in order, and
--- a datagram sent to a port no socket holds, or larger than the room its
--- socket has left, is lost, as UDP's may be.
---
--- In a network made by `network_over`, nothing waits, since in one thread
--- nothing else could end the wait.  Where a real socket would wait, for a
--- connection to accept, for bytes to receive or for room to send into, the
--- call fails `timed_out` at once, whether or not a limit was set, after a
--- send has delivered what fits.  In a network made by `network_over_turns`, a
--- call that would wait takes a turn of the scheduler it was given instead, so
--- that the other fibres run, and looks again.  It fails `timed_out` only
--- after a whole round in which nothing moved anywhere in the network, so
--- nothing it waits for arrived, while no fibre sleeps on a clock
--- `clock_over_beside` made beside it, which would move it when it wakes.  A
--- call whose socket was closed, or shut for what the call waits for, while it
--- waited fails `io_failed` (D449, D483, D493).  `accept`, `send`, `receive`,
--- `receive_from`, `read`, `write` and `write_some` are the calls that may
--- wait and so switch; the others never do.  A send to a connection whose peer
--- has closed is `disconnected` at once, where a real one may take one send
--- before it says so.  The network does not model loss on a connection, a
--- peer's reset, partial reads, nor a port held after its socket closed.  It
--- reads no zone: `::1%lo` is its loopback address, and `fe80::1%lo`, as every
--- other address, none of its interfaces.  A connection is made at once or
--- refused, so `connect_within`'s limit is never reached.  A datagram from a
--- socket bound to the unspecified address arrives from the loopback
--- address of its family, as a system fills in the address it leaves by.
---
--- The network keeps every option a socket is given and reads it back as
--- it was set, a span in whole seconds, without any changing what it does
--- (D3078).  It knows the names `with_names` gave it, and `resolve` never
--- waits.  A Unix-domain socket keeps its path in its record, and a path is
--- in use while a socket bound to it is open, since the network has no
--- files.  A datagram socket joins one group at a time, through the
--- unspecified or a loopback address, and a datagram sent to a group goes
--- to every socket that joined it at the port.
public network: type = network_value

--  The scheduler of a network that does not take turns: it runs nothing
--  and is never called.
alone: type = struct
    reserved: u32
end alone

alone_start: (self: alone, escaping record: ptr mut fibre.record,
              escaping stack: []mut u8, escaping work: any fibre.task)
             -> none ! mem.out_of_memory =
    _ = self
    _ = record
    _ = stack
    _ = work
end alone_start

alone_finished: (self: alone, record: fibre.record) -> (yes: bool) =
    _ = self
    _ = record
    yes = true
end alone_finished

alone_wait: (self: alone) -> none =
    _ = self
end alone_wait

alone is fibre.scheduler (start: alone_start, finished: alone_finished,
                          wait: alone_wait)
alone is fibre.turns (yield: alone_wait)

nobody: alone = zeroed

--- Fill `state` for a memory network over `sockets`, every one of them
--- free, and return its handle.  Ports bound to port 0 are given from
--- 49152 up.
public network_over: (inout state: network_space,
                      sockets: []mut network_socket)
                     -> (host: network from state, sockets) =
    freed(state, sockets)
    host = (state: addr state, sockets: sockets, runs: any(addr nobody),
            takes_turns: false, names: "")
end network_over

--- Fill `state` for a memory network over `sockets` whose calls take
--- turns on `runs` where they would wait, and return its handle.  The
--- fibres that use it are `runs`'s, and the network borrows the
--- scheduler for as long as it is used.
public network_over_turns: (inout state: network_space,
                            runs: any fibre.turns,
                            sockets: []mut network_socket)
                           -> (host: network from state, sockets, runs) =
    freed(state, sockets)
    host = (state: addr state, sockets: sockets, runs: runs,
            takes_turns: true, names: "")
end network_over_turns

--- The network `host` whose `resolve` answers from `names`, the text of
--- a hosts file as `net.hosts_lookup` reads one, which it borrows; a
--- network made without names knows none, and every name is
--- `unknown_name` to it.  It never waits for a name.
public with_names: (host: network, names: []u8)
                   -> (named: network from host, names) =
    named = host
    named.names = names
end with_names

--  Fill `state` and free every socket.
freed: (inout state: network_space, sockets: []mut network_socket)
       -> none =
    state = (next_port: 49152, arrivals: 0, calls: 0, fail_at: 0,
             without_ipv6: false, connections: 0, datagrams: 0, losses: 0,
             moves: 0, turns: 0, sleepers: 0)
    for index in usize(0)..<lenof sockets do
        sockets[index].role = free_slot
        sockets[index].start = 0
        sockets[index].filled = 0
    end for
end freed

--  Note that something a call may wait for changed.
moved: (self: network) -> none =
    state: ptr mut network_space = self.state
    inc state.val.moves
end moved

--  Where a call would wait: over turns, take a turn and say whether
--  anything moved in the network meanwhile, or a fibre sleeps on a clock
--  beside it that will move it, so the call looks again; otherwise, or
--  after a whole round in which nothing moved and nobody slept, no.
waited: (self: network) -> (again: bool) =
    again = false
    return when not self.takes_turns
    state: ptr mut network_space = self.state
    before: usize = state.val.moves
    inc state.val.turns
    self.runs.yield()
    again = state.val.moves <> before or state.val.sleepers > 0
end waited

--  Count a call, failing the one the test chose.
counted: (self: network) -> none ! io.io_failed =
    state: ptr mut network_space = self.state
    inc state.val.calls
    fail io.io_failed when state.val.calls == state.val.fail_at
end counted

--  Whether the network has the address's family.
has_family: (self: network, at: net.address) -> (yes: bool) =
    yes = at.family == net.ipv4 or not self.state.val.without_ipv6
end has_family

--  Whether an address is one of this machine's: a loopback address.
is_local: (at: net.address) -> (yes: bool) =
    if at.family == net.ipv4 then
        yes = at.octets[0] == 127
    else
        yes = true
        for index in usize(0)..<15 do
            if at.octets[index] <> 0 then yes = false end if
        end for
        yes = yes and at.octets[15] == 1
    end if
end is_local

--  Whether two addresses of one family name the same machine address.
--  The network reads no zone, so `::1%lo` is `::1` here, and the port is
--  the caller's to compare.
same_host: (one: net.address, other: net.address) -> (same: bool) =
    same = true
    for index in usize(0)..<16 do
        if one.octets[index] <> other.octets[index] then same = false end if
    end for
end same_host

--  Whether a socket bound to `held` takes what is sent to `wanted`: the
--  same family and port, and the same address or the unspecified one.
takes: (held: net.address, wanted: net.address) -> (yes: bool) =
    yes = held.family == wanted.family and held.port == wanted.port
          and (net.is_unspecified(held) or same_host(held, wanted))
end takes

--  Whether two bindings would take the same traffic.
overlaps: (one: net.address, other: net.address) -> (yes: bool) =
    yes = one.family == other.family and one.port == other.port
          and (net.is_unspecified(one) or net.is_unspecified(other)
               or same_host(one, other))
end overlaps

--  Whether a socket of `role` holds a port that overlaps `at`: datagram
--  sockets hold UDP's ports, and listeners TCP's; a connection's port is
--  taken by a connection or a listener, but a listener may take one beside
--  connections, as the hosted provider's listeners do with SO_REUSEADDR,
--  so a server can listen again while connections it accepted live on.
port_taken: (self: network, at: net.address, role: socket_role)
            -> (taken: bool) =
    taken = false
    for index in usize(0)..<lenof self.sockets do
        held: ptr network_socket = addr self.sockets[index]
        same_kind: bool = if held.val.named then false
                          elsif role == datagram_slot
                          then held.val.role == datagram_slot
                          elsif role == listening_slot then held.val.role == listening_slot
                          else held.val.role == listening_slot
                               or held.val.role == connection_slot end if
        if same_kind and overlaps(held.val.local, at) then taken = true end if
    end for
end port_taken

--  The address with a free port of `role`'s kind in place of port 0.
with_free_port: (self: network, at: net.address, role: socket_role)
                -> (given: net.address) ! net.address_in_use =
    given = at
    return when at.port <> 0
    state: ptr mut network_space = self.state
    for tries in usize(0)..<16384 do
        _ = tries
        port: usize = state.val.next_port
        state.val.next_port = if port >= 65535 then 49152 else port + 1 end if
        given = net.with_port(at, u16(port))
        return when not port_taken(self, given, role)
    end for
    fail net.address_in_use
end with_free_port

--  A free record's index.
free_index: (self: network) -> (index: usize) ! io.io_failed =
    for at in usize(0)..<lenof self.sockets do
        if self.sockets[at].role == free_slot then
            index = at
            return
        end if
    end for
    fail io.io_failed
end free_index

--  Open a record as a socket of `role` at `local`.
opened: (self: network, index: usize, role: socket_role, local: net.address)
        -> none =
    slot: ptr mut network_socket = addr self.sockets[index]
    slot.val.role = role
    slot.val.local = local
    slot.val.peer = net.unspecified(local.family, 0)
    slot.val.partner = index
    slot.val.listener = index
    slot.val.order = 0
    slot.val.pending = false
    slot.val.start = 0
    slot.val.filled = 0
    slot.val.receiving_closed = false
    slot.val.sending_closed = false
    slot.val.peer_finished = false
    slot.val.peer_gone = false
    slot.val.receive_limit = 0
    slot.val.send_limit = 0
    slot.val.no_delay = false
    slot.val.named = false
    slot.val.path_length = 0
    slot.val.flags = 0
    if local.family == net.ipv6 then slot.val.flags = ipv6_only_bit end if
    slot.val.numbers[0] = u32(lenof slot.val.buffer)
    slot.val.numbers[1] = u32(lenof slot.val.buffer)
    slot.val.numbers[2] = 64
    slot.val.numbers[3] = 1
    slot.val.spans[0] = 7200
    slot.val.spans[1] = 75
    slot.val.lingering = false
    slot.val.linger_limit = 0
    slot.val.group = net.unspecified(local.family, 0)
    slot.val.joined = false
    slot.val.interface = net.unspecified(local.family, 0)
end opened

--  The open socket a file is, of `role` when that is not free.
slot_of: (self: network, socket: io.file, role: socket_role)
         -> (slot: ptr mut network_socket from self) ! io.io_failed =
    index: usize = usize(socket)
    fail io.io_failed when index >= lenof self.sockets
    slot = addr self.sockets[index]
    fail io.io_failed when slot.val.role == free_slot
      or (role <> free_slot and slot.val.role <> role)
      or slot.val.pending
end slot_of

--  Bind a socket of `role` at `at`.
bound_at: (self: network, at: net.address, role: socket_role)
          -> (socket: io.file)
          ! net.address_in_use | net.address_unavailable | io.io_failed =
    try counted(self)
    fail net.address_unavailable when not has_family(self, at)
      or not (net.is_unspecified(at) or is_local(at))
    fail net.address_in_use when at.port <> 0 and port_taken(self, at, role)
    index: usize = try free_index(self)
    local: net.address = try with_free_port(self, at, role)
    opened(self, index, role, local)
    socket = io.file(index)
end bound_at

network_listen: (self: network, at: net.address) -> (listener: io.file)
                ! net.address_in_use | net.address_unavailable | io.no_access
                | io.io_failed =
    listener = try bound_at(self, at, listening_slot)
end network_listen

network_open_datagram: (self: network, at: net.address)
                       -> (socket: io.file)
                       ! net.address_in_use | net.address_unavailable | io.no_access
                       | io.io_failed =
    socket = try bound_at(self, at, datagram_slot)
end network_open_datagram

network_connect: (self: network, to: net.address) -> (connected: io.file)
                 ! net.refused | net.unreachable | net.address_unavailable | net.timed_out
                 | io.io_failed =
    try counted(self)
    fail net.address_unavailable when not has_family(self, to)
    fail net.unreachable when not is_local(to)
    mut listener: usize = lenof self.sockets
    for index in usize(0)..<lenof self.sockets do
        if self.sockets[index].role == listening_slot
          and not self.sockets[index].named
          and takes(self.sockets[index].local, to) then
            listener = index
        end if
    end for
    fail net.refused when listener == lenof self.sockets
    client: usize = try free_index(self)
    self.sockets[client].role = connection_slot
    server: usize = free_index(self) else (problem)
        self.sockets[client].role = free_slot
        fail problem
    end
    self.sockets[client].role = free_slot
    local: net.address = with_free_port(self, net.loopback(to.family, 0),
                                        connection_slot) else (problem)
        _ = problem
        fail io.io_failed
    end
    opened(self, client, connection_slot, local)
    opened(self, server, connection_slot, to)
    state: ptr mut network_space = self.state
    self.sockets[client].peer = to
    self.sockets[client].partner = server
    self.sockets[server].peer = local
    self.sockets[server].partner = client
    self.sockets[server].pending = true
    self.sockets[server].listener = listener
    self.sockets[server].order = state.val.arrivals
    inc state.val.arrivals
    inc state.val.connections
    moved(self)
    connected = io.file(client)
end network_connect

--  A connection here is made at once or refused, so no limit is reached.
network_connect_within: (self: network, to: net.address,
                         limit: time.duration) -> (connected: io.file)
                        ! net.refused | net.unreachable
                        | net.address_unavailable | net.timed_out
                        | io.io_failed =
    _ = limit
    connected = try network_connect(self, to)
end network_connect_within

network_accept: (self: network, listener: io.file) -> (accepted: io.file)
                ! net.timed_out | io.io_failed =
    try counted(self)
    mut found: usize = lenof self.sockets
    loop do
        --  A listener closed while the call waited fails it here.
        _ = try slot_of(self, listener, listening_slot)
        for index in usize(0)..<lenof self.sockets do
            candidate: ptr network_socket = addr self.sockets[index]
            if candidate.val.pending
              and candidate.val.listener == usize(listener)
              and (found == lenof self.sockets
                   or candidate.val.order < self.sockets[found].order) then
                found = index
            end if
        end for
        break when found < lenof self.sockets
        fail net.timed_out when not waited(self)
    end loop
    self.sockets[found].pending = false
    moved(self)
    accepted = io.file(found)
end network_accept

--  Move what waits in a socket's buffer to its front.
compacted: (slot: ptr mut network_socket) -> none =
    return when slot.val.start == 0
    waiting: usize = slot.val.filled - slot.val.start
    mem.copy(slot.val.buffer[0..<waiting],
             slot.val.buffer[slot.val.start..<slot.val.filled]) else none
    slot.val.start = 0
    slot.val.filled = waiting
end compacted

--  Deliver as much of `bytes` as the partner's buffer has room for: how
--  much.
delivered: (self: network, sender: ptr mut network_socket,
            bytes: []u8) -> (count: usize) =
    to: ptr mut network_socket = addr self.sockets[sender.val.partner]
    count = lenof bytes
    return when to.val.receiving_closed
    compacted(to)
    left: usize = lenof to.val.buffer - to.val.filled
    if count > left then count = left end if
    ends: usize = to.val.filled + count
    mem.copy(to.val.buffer[to.val.filled..<ends], bytes[0..<count]) else none
    to.val.filled = ends
    if count > 0 then moved(self) end if
end delivered

--  Send what fits of `bytes` on a connection: how much.
sent_part: (self: network, connection: io.file, bytes: []u8)
           -> (count: usize) ! net.disconnected | io.io_failed =
    slot: ptr mut network_socket = try slot_of(self, connection,
                                               connection_slot)
    fail net.disconnected when slot.val.sending_closed or slot.val.peer_gone
    count = delivered(self, slot, bytes)
end sent_part

--  Send what fits of `bytes`, and over turns wait for room until some
--  comes: how much, nothing only when `bytes` is empty or no room came.
sent_some: (self: network, connection: io.file, bytes: []u8)
           -> (count: usize) ! net.disconnected | io.io_failed =
    try counted(self)
    loop do
        count = try sent_part(self, connection, bytes)
        return when count > 0 or lenof bytes == 0 or not waited(self)
    end loop
end sent_some

network_send: (self: network, connection: io.file, bytes: []u8)
              -> none ! net.disconnected | net.timed_out | io.io_failed =
    try counted(self)
    mut sent: usize = try sent_part(self, connection, bytes)
    while sent < lenof bytes do
        fail net.timed_out when not waited(self)
        sent += try sent_part(self, connection, bytes[sent..<lenof bytes])
    end while
end network_send

network_receive: (self: network, connection: io.file, into: []mut u8)
                 -> (count: usize)
                 ! net.disconnected | net.timed_out | io.io_failed =
    try counted(self)
    count = 0
    mut waits: bool = false
    mut waiting: usize = 0
    loop do
        held: ptr mut network_socket = try slot_of(self, connection,
                                                   connection_slot)
        --  Shut for receiving while the call waited (D449).
        fail io.io_failed when waits and held.val.receiving_closed
        return when held.val.receiving_closed or lenof into == 0
        waiting = held.val.filled - held.val.start
        break when waiting > 0
        return when held.val.peer_finished
        fail net.timed_out when not waited(self)
        waits = true
    end loop
    slot: ptr mut network_socket = addr self.sockets[usize(connection)]
    count = if waiting < lenof into then waiting else lenof into end if
    ends: usize = slot.val.start + count
    mem.copy(into[0..<count], slot.val.buffer[slot.val.start..<ends])
        else (problem)
        _ = problem
        fail io.io_failed
    end
    slot.val.start = ends
    moved(self)
end network_receive

--  A datagram's record in its receiver's buffer: the sender's family,
--  sixteen bytes of address and two of port, two of length, and then the
--  bytes.
datagram_header: usize = 21

--- The longest datagram a memory network carries, as IPv4's UDP does.
public longest_datagram: usize = 65507

--  Put a datagram from `sender` in `receiver`'s buffer, or count it lost
--  when it has no room left.
queued: (self: network, receiver: ptr mut network_socket,
         sender: net.address, bytes: []u8) -> none ! io.io_failed =
    state: ptr mut network_space = self.state
    compacted(receiver)
    needed: usize = datagram_header + lenof bytes
    if needed > lenof receiver.val.buffer - receiver.val.filled then
        inc state.val.losses
        return
    end if
    at: usize = receiver.val.filled
    receiver.val.buffer[at] = if sender.family == net.ipv4 then 4 else 6 end if
    for octet in usize(0)..<16 do
        receiver.val.buffer[at + 1 + octet] = sender.octets[octet]
    end for
    receiver.val.buffer[at + 17] = u8(sender.port >> 8)
    receiver.val.buffer[at + 18] = u8(sender.port & 255)
    receiver.val.buffer[at + 19] = u8(lenof bytes >> 8)
    receiver.val.buffer[at + 20] = u8(lenof bytes & 255)
    mem.copy(receiver.val.buffer[at + datagram_header..<at + needed],
             bytes) else (problem)
        _ = problem
        fail io.io_failed
    end
    receiver.val.filled = at + needed
    inc state.val.datagrams
    moved(self)
end queued

network_send_to: (self: network, socket: io.file, bytes: []u8,
                  to: net.address) -> none
                 ! net.unreachable | net.timed_out | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try slot_of(self, socket, datagram_slot)
    fail io.io_failed when lenof bytes > longest_datagram or slot.val.named
      or to.family <> slot.val.local.family
    state: ptr mut network_space = self.state
    if is_group(to) then
        --  Every socket that joined the group at the port takes a copy.
        mut taken: bool = false
        for index in usize(0)..<lenof self.sockets do
            member: ptr mut network_socket = addr self.sockets[index]
            if member.val.role == datagram_slot and member.val.joined
              and same_host(member.val.group, to)
              and member.val.local.family == to.family
              and member.val.local.port == to.port then
                try queued(self, member, slot.val.local, bytes)
                taken = true
            end if
        end for
        if not taken then inc state.val.losses end if
        return
    end if
    fail net.unreachable when not is_local(to)
    --  A socket bound to the unspecified address sends from the loopback
    --  one, as a system fills in the address its datagram leaves by.
    mut source: net.address = slot.val.local
    if net.is_unspecified(source) then
        source = net.loopback(source.family, source.port)
    end if
    for index in usize(0)..<lenof self.sockets do
        receiver: ptr mut network_socket = addr self.sockets[index]
        if receiver.val.role == datagram_slot and not receiver.val.named
          and takes(receiver.val.local, to) then
            try queued(self, receiver, source, bytes)
            return
        end if
    end for
    inc state.val.losses
end network_send_to

network_receive_from: (self: network, socket: io.file,
                       into: []mut u8)
                      -> (received: net.datagram) ! net.timed_out | io.io_failed =
    try counted(self)
    loop do
        --  A socket closed while the call waited fails it here.
        held: ptr mut network_socket = try slot_of(self, socket,
                                                   datagram_slot)
        fail io.io_failed when held.val.named
        break when held.val.filled - held.val.start >= datagram_header
        fail net.timed_out when not waited(self)
    end loop
    slot: ptr mut network_socket = addr self.sockets[usize(socket)]
    at: usize = slot.val.start
    family: net.address_family = if slot.val.buffer[at] == 4 then net.ipv4
                                 else net.ipv6 end if
    mut sender: net.address = net.unspecified(family, 0)
    for octet in usize(0)..<16 do
        sender.octets[octet] = slot.val.buffer[at + 1 + octet]
    end for
    sender.port = (u16(slot.val.buffer[at + 17]) << 8)
                  | u16(slot.val.buffer[at + 18])
    length: usize = (usize(slot.val.buffer[at + 19]) << 8)
                    | usize(slot.val.buffer[at + 20])
    count: usize = if length < lenof into then length else lenof into end if
    begins: usize = at + datagram_header
    mem.copy(into[0..<count], slot.val.buffer[begins..<begins + count])
        else (problem)
        _ = problem
        fail io.io_failed
    end
    slot.val.start = begins + length
    moved(self)
    received = (count: count, sender: sender)
end network_receive_from

network_shutdown: (self: network, connection: io.file,
                   stopping: net.direction) -> none ! io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try slot_of(self, connection,
                                               connection_slot)
    if stopping <> net.sending then
        slot.val.receiving_closed = true
        slot.val.start = 0
        slot.val.filled = 0
    end if
    if stopping <> net.receiving then
        slot.val.sending_closed = true
        if partnered(self, usize(connection)) then
            self.sockets[slot.val.partner].peer_finished = true
        end if
    end if
    moved(self)
end network_shutdown

network_local_address: (self: network, socket: io.file)
                       -> (at: net.address) ! io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try slot_of(self, socket, free_slot)
    at = slot.val.local
end network_local_address

network_peer_address: (self: network, connection: io.file)
                      -> (at: net.address) ! io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try slot_of(self, connection,
                                               connection_slot)
    at = slot.val.peer
end network_peer_address

network_set_timeouts: (self: network, socket: io.file,
                       receive_limit: time.duration, send_limit: time.duration)
                      -> none ! io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try slot_of(self, socket, free_slot)
    slot.val.receive_limit = u64(receive_limit)
    slot.val.send_limit = u64(send_limit)
end network_set_timeouts

network_set_no_delay: (self: network, connection: io.file, on: bool)
                      -> none ! io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try slot_of(self, connection,
                                               connection_slot)
    slot.val.no_delay = on
end network_set_no_delay

--  Whether the connection in slot `index` still has its other end.  A
--  slot keeps its partner's index after that end has closed, and the next
--  socket opened may take the index: the socket there is this one's peer
--  only while this end has not been told its peer is gone and that slot
--  is a connection naming this one.
partnered: (self: network, index: usize) -> (yes: bool) =
    slot: ptr mut network_socket = addr self.sockets[index]
    yes = false
    return when slot.val.role <> connection_slot or slot.val.peer_gone
    other: ptr mut network_socket = addr self.sockets[slot.val.partner]
    yes = other.val.role == connection_slot and other.val.partner == index
end partnered

--  The other end of a connection that has gone: what it already received
--  stays, and then its stream ends, and what it sends is disconnected.
orphaned: (self: network, index: usize) -> none =
    other: ptr mut network_socket = addr self.sockets[index]
    other.val.peer_finished = true
    other.val.peer_gone = true
end orphaned

network_close_socket: (self: network, sink socket: io.file)
                      -> none ! io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try slot_of(self, socket, free_slot)
    index: usize = usize(socket)
    if slot.val.role == connection_slot then
        if partnered(self, index) then
            orphaned(self, slot.val.partner)
        end if
    elsif slot.val.role == listening_slot then
        --  Connections waiting to be accepted are reset with it.
        for pending in usize(0)..<lenof self.sockets do
            waiting: ptr mut network_socket = addr self.sockets[pending]
            if waiting.val.pending and waiting.val.listener == index then
                if partnered(self, pending) then
                    orphaned(self, waiting.val.partner)
                end if
                waiting.val.pending = false
                waiting.val.role = free_slot
            end if
        end for
    end if
    slot.val.role = free_slot
    slot.val.start = 0
    slot.val.filled = 0
    moved(self)
end network_close_socket

network_read: (self: network, opened: io.file, into: []mut u8)
              -> (count: usize) ! io.io_failed =
    count = network_receive(self, opened, into) else (problem)
        _ = problem
        fail io.io_failed
    end
end network_read

network_write: (self: network, opened: io.file, bytes: []u8)
               -> none ! io.io_failed =
    network_send(self, opened, bytes) else (problem)
        _ = problem
        fail io.io_failed
    end
end network_write

--  What fits, or `io_failed` when nothing does, since a write that makes
--  no progress breaks the writer's contract; over turns, it waits for
--  room first.
network_write_some: (self: network, opened: io.file, bytes: []u8)
                    -> (count: usize) ! io.io_failed =
    count = sent_some(self, opened, bytes) else (problem)
        _ = problem
        fail io.io_failed
    end
    fail io.io_failed when count == 0 and lenof bytes > 0
end network_write_some

--  The bit of a socket's `flags` each flag option keeps.
reuse_address_bit: u8 = 1
reuse_port_bit: u8 = 2
keep_alive_bit: u8 = 4
broadcast_bit: u8 = 8
ipv6_only_bit: u8 = 16

flag_bit: (which: net.flag_option) -> (bit: u8) =
    bit = match which
        net.reuse_address: reuse_address_bit
        net.reuse_port: reuse_port_bit
        net.keep_alive: keep_alive_bit
        net.broadcast: broadcast_bit
        net.ipv6_only: ipv6_only_bit
    end match
end flag_bit

--  An open internet socket, whose options these are.
optioned: (self: network, socket: io.file)
          -> (slot: ptr mut network_socket from self) ! io.io_failed =
    slot = try slot_of(self, socket, free_slot)
    fail io.io_failed when slot.val.named
end optioned

network_set_flag: (self: network, socket: io.file, which: net.flag_option,
                   on: bool) -> none ! net.unsupported | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try optioned(self, socket)
    fail io.io_failed when which == net.ipv6_only
      and slot.val.local.family <> net.ipv6
    bit: u8 = flag_bit(which)
    slot.val.flags = if on then slot.val.flags | bit
                     else slot.val.flags & (255 ^ bit) end if
end network_set_flag

network_flag: (self: network, socket: io.file, which: net.flag_option)
              -> (on: bool) ! net.unsupported | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try optioned(self, socket)
    fail io.io_failed when which == net.ipv6_only
      and slot.val.local.family <> net.ipv6
    on = (slot.val.flags & flag_bit(which)) <> 0
end network_flag

number_index: (which: net.number_option) -> (index: usize) =
    index = match which
        net.receive_buffer: 0
        net.send_buffer: 1
        net.unicast_hops: 2
        net.multicast_hops: 3
    end match
end number_index

network_set_number: (self: network, socket: io.file,
                     which: net.number_option, value: u32)
                    -> none ! net.unsupported | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try optioned(self, socket)
    fail io.io_failed when value > 255
      and (which == net.unicast_hops or which == net.multicast_hops)
    fail io.io_failed when value == 0 and which <> net.multicast_hops
    slot.val.numbers[number_index(which)] = value
end network_set_number

network_number: (self: network, socket: io.file, which: net.number_option)
                -> (value: u32) ! net.unsupported | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try optioned(self, socket)
    value = slot.val.numbers[number_index(which)]
end network_number

--  A span in whole seconds, a part of one rounded up.
whole_seconds: (span: time.duration) -> (count: u64) =
    count = u64(span) / 1000000000
    if u64(span) - count * 1000000000 > 0 then inc count end if
end whole_seconds

network_set_span: (self: network, socket: io.file, which: net.span_option,
                   value: time.duration) -> none ! net.unsupported | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try optioned(self, socket)
    fail io.io_failed when u64(value) == 0
    index: usize = if which == net.keep_alive_idle then 0 else 1 end if
    slot.val.spans[index] = whole_seconds(value)
end network_set_span

network_span: (self: network, socket: io.file, which: net.span_option)
              -> (value: time.duration) ! net.unsupported | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try optioned(self, socket)
    index: usize = if which == net.keep_alive_idle then 0 else 1 end if
    value = time.seconds(slot.val.spans[index])
end network_span

network_set_linger: (self: network, socket: io.file, on: bool,
                     limit: time.duration) -> none ! io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try optioned(self, socket)
    slot.val.lingering = on
    slot.val.linger_limit = if on then whole_seconds(limit) else 0 end if
end network_set_linger

network_linger: (self: network, socket: io.file)
                -> (on: bool, limit: time.duration) ! io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try optioned(self, socket)
    on = slot.val.lingering
    limit = time.seconds(slot.val.linger_limit)
end network_linger

--  Whether an address is a multicast group's: 224.0.0.0/4 or ff00::/8.
is_group: (at: net.address) -> (yes: bool) =
    yes = if at.family == net.ipv4 then at.octets[0] >= 224 and at.octets[0] <= 239
          else at.octets[0] == 255 end if
end is_group

--  The datagram socket a group is joined on, the group's family its own,
--  through one of this machine's interfaces.
grouped_socket: (self: network, socket: io.file, group: net.address,
                 through: net.address)
                -> (slot: ptr mut network_socket from self)
                ! net.address_unavailable | io.io_failed =
    slot = try slot_of(self, socket, datagram_slot)
    fail io.io_failed when slot.val.named
    fail net.address_unavailable when not is_group(group)
      or group.family <> slot.val.local.family
      or not (net.is_unspecified(through) or is_local(through))
end grouped_socket

network_join_group: (self: network, socket: io.file, group: net.address,
                     through: net.address)
                    -> none ! net.address_unavailable | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try grouped_socket(self, socket, group,
                                                      through)
    fail io.io_failed when slot.val.joined
    slot.val.group = group
    slot.val.joined = true
end network_join_group

network_leave_group: (self: network, socket: io.file, group: net.address,
                      through: net.address)
                     -> none ! net.address_unavailable | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try grouped_socket(self, socket, group,
                                                      through)
    fail net.address_unavailable when not slot.val.joined
      or not same_host(slot.val.group, group)
    slot.val.joined = false
end network_leave_group

--  The fake has the loopback interface alone, so an interface is the
--  unspecified address or a loopback one, and reads back as it was set.
network_set_multicast_interface: (self: network, socket: io.file,
                                  through: net.address)
                                 -> none ! net.address_unavailable
                                         | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try slot_of(self, socket, datagram_slot)
    fail io.io_failed when slot.val.named
    fail net.address_unavailable when not (net.is_unspecified(through)
                                           or is_local(through))
    slot.val.interface = through
end network_set_multicast_interface

network_multicast_interface: (self: network, socket: io.file)
                             -> (through: net.address) ! io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try slot_of(self, socket, datagram_slot)
    fail io.io_failed when slot.val.named
    through = slot.val.interface
end network_multicast_interface

--  Names come from the hosts text the test put in the space, and nothing
--  waits.
network_resolve: (self: network, name: []u8, port: u16,
                  into: []mut net.address)
                 -> (count: usize) ! net.unknown_name | net.timed_out
                                   | io.io_failed =
    try counted(self)
    fail net.unknown_name when not net.is_host_name(name)
    count = net.hosts_lookup(self.names, name, port, into, 0)
    fail net.unknown_name when count == 0
end network_resolve

--  A Unix-domain path's bytes, as a socket record keeps them: 1 to 107
--  bytes, none of them NUL.
path_bytes: (path: text.os_string) -> (bytes: []u8 from path)
            ! net.invalid_address =
    bytes = text.os_string_bytes(path)
    fail net.invalid_address when lenof bytes == 0 or lenof bytes >= 108
      or mem.find(bytes, 0) < lenof bytes
end path_bytes

--  Whether the record at `index` is a Unix-domain socket of `role` bound
--  to `bytes`.
named_at: (self: network, index: usize, role: socket_role, bytes: []u8)
          -> (yes: bool) =
    slot: ptr network_socket = addr self.sockets[index]
    yes = slot.val.named and slot.val.role == role and not slot.val.pending
          and slot.val.path_length == lenof bytes
    return when not yes
    for at in usize(0)..<lenof bytes do
        if slot.val.path[at] <> bytes[at] then yes = false end if
    end for
end named_at

--  Name the record at `index` by `bytes`.
named_as: (self: network, index: usize, bytes: []u8) -> none =
    slot: ptr mut network_socket = addr self.sockets[index]
    slot.val.named = true
    slot.val.path = zeroed
    for at in usize(0)..<lenof bytes do
        slot.val.path[at] = bytes[at]
    end for
    slot.val.path_length = lenof bytes
end named_as

--  Bind a Unix-domain socket of `role` at `path`: a path another such
--  socket holds is in use, as long as that socket is open.
named_bound: (self: network, path: text.os_string, role: socket_role)
             -> (socket: io.file)
             ! net.address_in_use | net.invalid_address | io.io_failed =
    try counted(self)
    bytes: []u8 = try path_bytes(path)
    for index in usize(0)..<lenof self.sockets do
        fail net.address_in_use when named_at(self, index, listening_slot, bytes)
          or named_at(self, index, datagram_slot, bytes)
    end for
    index: usize = try free_index(self)
    opened(self, index, role, net.unspecified(net.ipv4, 0))
    named_as(self, index, bytes)
    socket = io.file(index)
end named_bound

network_listen_local: (self: network, path: text.os_string)
                      -> (listener: io.file)
                      ! net.address_in_use | net.invalid_address
                      | net.unsupported | io.no_access | io.io_failed =
    listener = try named_bound(self, path, listening_slot)
end network_listen_local

network_open_local_datagram: (self: network, path: text.os_string)
                             -> (socket: io.file)
                             ! net.address_in_use | net.invalid_address
                             | net.unsupported | io.no_access | io.io_failed =
    socket = try named_bound(self, path, datagram_slot)
end network_open_local_datagram

network_connect_local: (self: network, path: text.os_string)
                       -> (connected: io.file)
                       ! net.refused | net.invalid_address | net.unsupported
                       | io.no_access | io.io_failed =
    try counted(self)
    bytes: []u8 = try path_bytes(path)
    mut listener: usize = lenof self.sockets
    for index in usize(0)..<lenof self.sockets do
        if named_at(self, index, listening_slot, bytes) then listener = index end if
    end for
    fail net.refused when listener == lenof self.sockets
    client: usize = try free_index(self)
    self.sockets[client].role = connection_slot
    server: usize = free_index(self) else (problem)
        self.sockets[client].role = free_slot
        fail problem
    end
    nowhere: net.address = net.unspecified(net.ipv4, 0)
    opened(self, client, connection_slot, nowhere)
    opened(self, server, connection_slot, nowhere)
    self.sockets[client].named = true
    named_as(self, server, bytes)
    state: ptr mut network_space = self.state
    self.sockets[client].partner = server
    self.sockets[server].partner = client
    self.sockets[server].pending = true
    self.sockets[server].listener = listener
    self.sockets[server].order = state.val.arrivals
    inc state.val.arrivals
    inc state.val.connections
    moved(self)
    connected = io.file(client)
end network_connect_local

--  Put a Unix-domain datagram in `receiver`'s buffer, behind the header
--  whose family byte is 1 and whose next byte counts the sender's path,
--  which comes before the bytes; or count it lost when it has no room.
queued_named: (self: network, receiver: ptr mut network_socket,
               sender: ptr network_socket, bytes: []u8)
              -> none ! io.io_failed =
    state: ptr mut network_space = self.state
    compacted(receiver)
    named: usize = sender.val.path_length
    needed: usize = datagram_header + named + lenof bytes
    if needed > lenof receiver.val.buffer - receiver.val.filled then
        inc state.val.losses
        return
    end if
    at: usize = receiver.val.filled
    receiver.val.buffer[at] = 1
    receiver.val.buffer[at + 1] = u8(named)
    receiver.val.buffer[at + 19] = u8(lenof bytes >> 8)
    receiver.val.buffer[at + 20] = u8(lenof bytes & 255)
    for index in usize(0)..<named do
        receiver.val.buffer[at + datagram_header + index] =
            sender.val.path[index]
    end for
    begins: usize = at + datagram_header + named
    mem.copy(receiver.val.buffer[begins..<at + needed], bytes) else (problem)
        _ = problem
        fail io.io_failed
    end
    receiver.val.filled = at + needed
    inc state.val.datagrams
    moved(self)
end queued_named

network_send_to_local: (self: network, socket: io.file, bytes: []u8,
                        path: text.os_string)
                       -> none ! net.refused | net.invalid_address
                               | net.timed_out | io.io_failed =
    try counted(self)
    slot: ptr mut network_socket = try slot_of(self, socket, datagram_slot)
    fail io.io_failed when not slot.val.named or lenof bytes > longest_datagram
    wanted: []u8 = try path_bytes(path)
    for index in usize(0)..<lenof self.sockets do
        if named_at(self, index, datagram_slot, wanted) then
            try queued_named(self, addr self.sockets[index], slot, bytes)
            return
        end if
    end for
    fail net.refused
end network_send_to_local

network_receive_from_local: (self: network, socket: io.file, into: []mut u8,
                             room: []mut u8)
                            -> (count: usize, sender: text.os_string from room)
                            ! net.timed_out | io.io_failed =
    try counted(self)
    loop do
        held: ptr mut network_socket = try slot_of(self, socket,
                                                   datagram_slot)
        fail io.io_failed when not held.val.named
        break when held.val.filled - held.val.start >= datagram_header
        fail net.timed_out when not waited(self)
    end loop
    slot: ptr mut network_socket = addr self.sockets[usize(socket)]
    at: usize = slot.val.start
    named: usize = usize(slot.val.buffer[at + 1])
    length: usize = (usize(slot.val.buffer[at + 19]) << 8)
                    | usize(slot.val.buffer[at + 20])
    fail io.io_failed when named > lenof room
    for index in usize(0)..<named do
        room[index] = slot.val.buffer[at + datagram_header + index]
    end for
    begins: usize = at + datagram_header + named
    count = if length < lenof into then length else lenof into end if
    mem.copy(into[0..<count], slot.val.buffer[begins..<begins + count])
        else (problem)
        _ = problem
        fail io.io_failed
    end
    slot.val.start = begins + length
    moved(self)
    sender = text.os_string_over(room[0..<named])
end network_receive_from_local


network is io.reader (read: network_read)
network is io.writer (write: network_write,
                      write_some: network_write_some)
network is net.network
    (connect: network_connect, connect_within: network_connect_within,
     listen: network_listen,
     accept: network_accept, open_datagram: network_open_datagram,
     send: network_send, receive: network_receive,
     send_to: network_send_to, receive_from: network_receive_from,
     shutdown: network_shutdown, local_address: network_local_address,
     peer_address: network_peer_address,
     set_timeouts: network_set_timeouts,
     set_no_delay: network_set_no_delay,
     close: network_close_socket,
     set_flag: network_set_flag, flag: network_flag,
     set_number: network_set_number, number: network_number,
     set_span: network_set_span, span: network_span,
     set_linger: network_set_linger, linger: network_linger,
