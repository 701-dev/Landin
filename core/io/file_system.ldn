--  The rest of the file system: opening with options, renaming, a file's
--  status, read-only files, synchronizing, sizes, reading and writing at
--  an offset, temporary files and the working directory, a concept beside
--  `files` and `directories` and outside `world`; and terminals, another.
--  A firmware image that never asks for either carries neither.

import core/mem
import core/text
import core/time

--- How `open_file` opens a file.  `read` and `write` open it to read, to
--- write, or both.  `append` sends every write to the end of the file, and
--- `truncate` cuts it to nothing as it is opened; each needs `write`.
--- `create` makes the file when it is missing.  `exclusive` with `create`
--- refuses a file that is there, `already_exists`, and no other program can
--- come in between.  Any other combination, and one that neither reads nor
--- writes, is `io_failed` before the provider is asked.
public open_options: type = struct
    read: bool
    write: bool
    append: bool
    create: bool
    exclusive: bool
    truncate: bool
end open_options

--- Read and write a file that exists, from its start, keeping what it
--- holds.
public updating: open_options = (read: true, write: true, append: false,
                                 create: false, exclusive: false,
                                 truncate: false)

--- Write at the end of a file, making it when it is missing: a log.
public appending: open_options = (read: false, write: true, append: true,
                                  create: true, exclusive: false,
                                  truncate: false)

--- Read and write a new file, refusing a name that is taken with
--- `already_exists`: the file is this program's alone.
public creating: open_options = (read: true, write: true, append: false,
                                 create: true, exclusive: true,
                                 truncate: false)

--- Follow a symbolic link that ends a path to what it names.
public following: atom
--- Take a symbolic link that ends a path as itself.
public not_following: atom
--- What `status_of` does with a symbolic link that ends its path.
public link_handling: type = following | not_following

--- Write a file's data and its status to lasting storage.
public data_and_status: atom
--- Write a file's data and only the status that reading it back needs.
public data_only: atom
--- What `synchronize` writes to lasting storage.
public synchronizing: type = data_and_status | data_only

--- The little that every system says alike about a file: its size in bytes,
--- what it is, when it was last written, as the wall clock read then,
--- whether it is `read_only`, which on POSIX means that no permission bit
--- lets anyone write it, and whether it is `executable`: a regular file the
--- system would run as a program, which on POSIX means that some
--- permission bit lets someone execute it and on Windows, which keeps no
--- such bit, that its name ends in `.exe` or `.com`.  A directory is never
--- executable.  A directory's own size differs between file systems; a
--- symbolic link's is the length of its target.
public status: type = struct
    size: u64
    kind: entry_kind
    modified: time.wall_time
    read_only: bool
    executable: bool
end status

--- A temporary file `make_temporary` made: the file, open for reading and
--- writing, and its path, the directory's path and a name of its own, lent
--- from the caller's buffer.  Nothing removes it: on every way out, close
--- it, then rename it into place or remove it.
public temporary: type = struct
    opened: file
    path: text.os_string
end temporary

--  One close for every file, whichever call opened it: spec.md's D357.
--- The rest of the file system: a concept that refines `files`, so a
--- provider of it opens with `open_read`, `open_write` and `open_file` and
--- closes every one of them with `files`' `close`, the one close a file
--- has.  It is outside `world`, beside `directories`.  A path is a host
--- string, as `files` takes one, and a file is a `file` of the provider,
--- which `reader`, `writer` and `files` take too.
public file_system: type = concept (provider: type) is files
    --- Open the file at `path` as `options` say.  A missing file without
    --- `create`, and a path through something that is not a directory, are
    --- `mem.not_found`; a file that `exclusive` finds is `already_exists`; a
    --- file the provider may not open that way is `no_access`; and a path
    --- that names a directory is `is_a_directory`.
    open_file: (self: provider, path: text.os_string,
                options: open_options)
               -> (opened: file)
               ! already_exists | mem.not_found | no_access | is_a_directory
               | io_failed
    --- Give the file at `old` the name `new` in one step, replacing a file
    --- already named `new`; a missing `old` or parent of `new` is
    --- `mem.not_found`.  A rename does not cross from one file system to
    --- another, which is `io_failed`, and never puts a directory where a
    --- file is or a file where a directory is.
    rename: (self: provider, old: text.os_string, new: text.os_string)
            -> none ! mem.not_found | no_access | io_failed
    --- The status of the file at `path`.  When the path ends in a symbolic
    --- link, `following` gives the status of the link's target and
    --- `not_following` that of the link itself.
    status_of: (self: provider, path: text.os_string,
                links: link_handling)
               -> (found: status) ! mem.not_found | no_access | io_failed
    --- The status of an open file.
    status_of_file: (self: provider, opened: file) -> (found: status)
                    ! io_failed
    --- Make the file at `path` read-only, or with `read_only` false
    --- writable by its owner again.
    set_read_only: (self: provider, path: text.os_string, read_only: bool)
                   -> none ! mem.not_found | no_access | io_failed
    --- Write what the provider holds of an open file to lasting storage
    --- before returning: its data and its status, or with `data_only` its
    --- data and only the status that reading it back needs.
    synchronize: (self: provider, opened: file, writing: synchronizing)
                 -> none ! io_failed
    --- Give a file open for writing the size `size`, cutting it or
    --- extending it with zeros.
    truncate: (self: provider, opened: file, size: u64) -> none ! io_failed
    --- Read at most `lenof into` bytes of an open file from `offset` on,
    --- without moving the position `read` reads from.  It returns the
    --- count, which is zero at or past the file's end.
    read_at: (self: provider, opened: file, offset: u64, into: []mut u8)
             -> (count: usize) ! io_failed
    --- Write all of `bytes` into an open file from `offset` on, without
    --- moving the position `write` writes at; a write past the end
    --- extends the file, and what lies between reads as zeros.  Never
    --- write at an offset to a file opened to `append`.
    write_at: (self: provider, opened: file, offset: u64, bytes: []u8)
              -> none ! io_failed
    --- Make and open a new file in `directory`, empty for the working
    --- directory, and put its path in `into`.  Its name, which no other
    --- file has, is made from bytes of `names` and tried again when it is
    --- taken.  It is made exclusively, so no other program's file is ever
    --- opened in its place, and readable and writable by its owner alone.
    make_temporary: (self: provider, names: any entropy,
                     directory: text.os_string, into: []mut u8)
                    -> (made: temporary from into)
                    ! mem.not_found | no_access | io_failed
    --- The working directory's path, put in `into`; a path too long for it
    --- is `io_failed`.  Nothing here changes the working directory, which
    --- is the whole process's: make a path from this one instead.
    current_directory: (self: provider, into: []mut u8)
                       -> (path: text.os_string from into) ! io_failed
end file_system

--- Whether `options` is a combination an open can have: it reads or writes,
--- it appends or truncates only when it writes, and it is `exclusive` only
--- when it may `create`.  A provider refuses any other combination with
--- `io_failed` before it asks anything.
public valid_options: (options: open_options) -> (yes: bool) =
    some: bool = options.read or options.write
    writes: bool = options.write or not (options.append or options.truncate)
    makes: bool = options.create or not options.exclusive
    yes = some and writes and makes
end valid_options

--- Open the file at `path` as `options` say, through `file_system`
--- evidence; close it through the same provider's `files`.
public open_file: (provider: type is file_system, host: provider,
                   path: text.os_string, options: open_options)
                  -> (opened: file)
                  ! already_exists | mem.not_found | no_access | is_a_directory
                  | io_failed =
    opened = try provider.open_file(host, path, options)
end open_file

--- Give the file at `old` the name `new`, replacing a file already named
--- `new` in the same step: no program sees both names or neither.  The way
--- to replace a file whole is to write a `make_temporary` file beside it,
--- `synchronize` it, close it and rename it onto the file.
public rename: (provider: type is file_system, host: provider,
                old: text.os_string, new: text.os_string)
               -> none ! mem.not_found | no_access | io_failed =
    try provider.rename(host, old, new)
end rename

--- The status of the file at `path`.  When the path ends in a symbolic
--- link, `following` gives the status of the link's target and
--- `not_following` that of the link itself.
public status_of: (provider: type is file_system, host: provider,
                   path: text.os_string, links: link_handling)
                  -> (found: status) ! mem.not_found | no_access | io_failed =
    found = try provider.status_of(host, path, links)
end status_of

--- The status of an open file.
public status_of_file: (provider: type is file_system, host: provider,
                        opened: file) -> (found: status) ! io_failed =
    found = try provider.status_of_file(host, opened)
end status_of_file

--- Make the file at `path` read-only, or writable by its owner again.
--- Opening a read-only file for writing is refused, `no_access`, except for
--- a process the system lets past every permission, as POSIX's root.
public set_read_only: (provider: type is file_system, host: provider,
                       path: text.os_string, read_only: bool)
                      -> none ! mem.not_found | no_access | io_failed =
    try provider.set_read_only(host, path, read_only)
end set_read_only

--- Write what the provider holds of an open file to lasting storage before
--- returning, its status too unless `writing` is `data_only`.
public synchronize: (provider: type is file_system, host: provider,
                     opened: file, writing: synchronizing)
                    -> none ! io_failed =
    try provider.synchronize(host, opened, writing)
end synchronize

--- Give a file open for writing the size `size`, cutting it or extending
--- it with zeros.
public truncate: (provider: type is file_system, host: provider,
                  opened: file, size: u64) -> none ! io_failed =
    try provider.truncate(host, opened, size)
end truncate

--- Read at most `lenof into` bytes of an open file from `offset` on: the
--- count, which may be short, and zero at or past its end.
public read_at: (provider: type is file_system, host: provider,
                 opened: file, offset: u64, into: []mut u8)
                -> (count: usize) ! io_failed =
    count = try provider.read_at(host, opened, offset, into)
end read_at

--- Write all of `bytes` into an open file from `offset` on; a write past
--- the end leaves zeros between.  A failure may follow part of them.
public write_at: (provider: type is file_system, host: provider,
                  opened: file, offset: u64, bytes: []u8)
                 -> none ! io_failed =
    try provider.write_at(host, opened, offset, bytes)
end write_at

--- Make and open a new file in `directory` under a name no other file has,
--- made from bytes the entropy `names` gives, and put its path in `into`.
--- `into` must hold the directory, a `/` and the 21 bytes of the name:
--- `.tmp-` and sixteen hexadecimal digits, which an ordinary listing hides.
--- The hosted provider is its own entropy too, `io.make_temporary(host,
--- host, directory, buffer)`, and a test passes scripted bytes to see a
--- name that is taken tried again.
public make_temporary: (provider: type is file_system, host: provider,
                        source: type is entropy, names: source,
                        directory: text.os_string, into: []mut u8)
                       -> (made: temporary from into)
                       ! mem.not_found | no_access | io_failed =
    erased: any entropy = any(addr names)
    made = try provider.make_temporary(host, erased, directory, into)
end make_temporary

--- The working directory's path, put in `into`.
public current_directory: (provider: type is file_system, host: provider,
                           into: []mut u8)
                          -> (path: text.os_string from into)
                          ! io_failed =
    path = try provider.current_directory(host, into)
end current_directory

--  How a search path divides its entries and a path its parts: `:` and
--  `/` on POSIX, `;` and `\` on Windows, where a name without an
--  extension is run as `.exe`, as CreateProcessW runs it.
fixed if compiler.os == windows then
    path_list_separator: u8 = u8(';')
    path_separator: u8 = u8('\\')
    program_suffix: []u8 = ".exe"
else
    path_list_separator: u8 = u8(':')
    path_separator: u8 = u8('/')
    program_suffix: []u8 = ""
end if

--  Whether `name` names a place of its own rather than a program to
--  search for: it holds a `/`, or on Windows a `\` or a drive's `:`.
placed: (name: []u8) -> (yes: bool) =
    yes = mem.find(name, u8('/')) < lenof name
          or mem.find(name, path_separator) < lenof name
          or (path_separator <> u8('/') and lenof name > 1
              and name[1] == u8(':'))
end placed

--  The suffix a program named `name` is run with: Windows' `.exe` when its
--  last part has no extension, and nothing otherwise.
suffix_for: (name: []u8) -> (suffix: []u8) =
    suffix = ""
    return when lenof program_suffix == 0
    mut at: usize = lenof name
    while at > 0 do
        byte: u8 = name[at - 1]
        return when byte == u8('.')
        break when byte == u8('/') or byte == path_separator
        at -= 1
    end while
    suffix = program_suffix
end suffix_for

--  Put `parts` one after another in `into` and say whether they fit.
put_parts: (into: []mut u8, parts: [4][]u8) -> (length: usize, fits: bool) =
    length = 0
    fits = false
    for part in parts do
        return when lenof part > lenof into - length
        mem.copy(into[length..<length + lenof part], part) else none
        length += lenof part
    end for
    fits = true
end put_parts

--  Whether the file at `path` is a program to run: a regular file, after
--  any link it ends in, whose status says it is executable.  A path the
--  provider cannot read the status of is none.
runs: (provider: type is file_system, host: provider, path: []u8)
      -> (yes: bool) =
    found: status = provider.status_of(host, text.os_string_over(path),
                                       following) else (problem)
        _ = problem
        yes = false
        return
    end
    yes = found.kind == regular and found.executable
end runs

--- Find the program `name` as a shell finds a command, without starting it,
--- and put its path in `into` for `spawn` to start: the first entry of the
--- search path `search` holding an executable regular file of that name,
--- joined to it with the separator the entry writes its parts with, `/` unless
--- it is a Windows entry written with `\`. `search` is a `PATH` value, which
--- `variable_named` reads, its entries divided by `:` on POSIX and by `;` on
--- Windows; an empty entry is passed over rather than read as the current
--- directory, so a program in it is never run by accident. A `name` that holds
--- a `/`, or on Windows a `\` or a drive, names its own place and is not
--- searched for: it is put in `into` when it is executable. On Windows, which
--- runs only programs whose names end in `.exe` or `.com`, a name whose last
--- part has no extension is looked for with `.exe` after it, as CreateProcessW
--- looks for it. It reports `mem.not_found` when no entry holds the program,
--- `name` is empty, or the place it names is not executable, and `io_failed`
--- when a path to try does not fit in `into`. A file is executable as `status`
--- says.
public find_program: (provider: type is file_system, host: provider,
                      name: text.os_string, search: text.os_string,
                      into: []mut u8)
                     -> (found: text.os_string from into)
                     ! mem.not_found | io_failed =
    found = text.os_string_over(into[0..<0])
    wanted: []u8 = text.os_string_bytes(name)
    fail mem.not_found when lenof wanted == 0
    suffix: []u8 = suffix_for(wanted)
    if placed(wanted) then
        (length, fits) := put_parts(into, [wanted, suffix, "", ""])
        fail io_failed when not fits
        fail mem.not_found when not runs(host, into[0..<length])
        found = text.os_string_over(into[0..<length])
        return
    end if
    entries: []u8 = text.os_string_bytes(search)
    mut start: usize = 0
    while start <= lenof entries do
        rest: []u8 = entries[start..<lenof entries]
        width: usize = mem.find(rest, path_list_separator)
        entry: []u8 = rest[0..<width]
        start += width + 1
        if lenof entry > 0 then
            ends_divided: bool = entry[lenof entry - 1] == path_separator
                                 or entry[lenof entry - 1] == u8('/')
            --  The separator the entry writes its own parts with: Windows'
            --  `\` where it has one, and `/` otherwise, which Windows takes
            --  too.
            divider: [1]u8 = [if mem.find(entry, path_separator) < lenof entry
                              then path_separator else u8('/') end if]
            between: []u8 = if ends_divided then "" else divider[0..<1] end if
            (length, fits) := put_parts(into, [entry, between, wanted, suffix])
            fail io_failed when not fits
            if runs(host, into[0..<length]) then
                found = text.os_string_over(into[0..<length])
                return
            end if
        end if
    end while
    fail mem.not_found
end find_program

--- How many times `make_temporary` tries a name before it gives up with
--- `io_failed`: a name is taken only when the bytes `names` gives repeat.
public temporary_tries: usize = 16

--- The path `make_temporary` tries, from eight bytes of `names`: the
--- directory, a `/` unless it is empty or ends in one, `.tmp-` and the
--- bytes as sixteen lower-case hexadecimal digits, put in `into`; a path
--- that does not fit is `io_failed`.  For a provider in another module.
public temporary_path: (directory: text.os_string, bytes: [8]u8,
                        into: []mut u8)
                       -> (path: text.os_string from into) ! io_failed =
    path = text.os_string_over(into[0..<0])
    mut made := text.over(into)
    folder: []u8 = text.os_string_bytes(directory)
    text.append(made, folder) else (problem)
        _ = problem
        fail io_failed
    end
    divided: bool = lenof folder == 0 or folder[lenof folder - 1] == u8('/')
    separator: []u8 = if divided then "" else "/" end if
    text.append(made, separator) else (problem)
        _ = problem
        fail io_failed
    end
    text.append(made, ".tmp-") else (problem)
        _ = problem
        fail io_failed
    end
    for byte in bytes do
        start: usize = text.length(made)
        text.append_hex_u32(made, u32(byte)) else (problem)
            _ = problem
            fail io_failed
        end
        text.align_right(made, start, 2, u8('0')) else (problem)
            _ = problem
            fail io_failed
        end
    end for
    length: usize = text.length(made)
    path = text.os_string_over(into[0..<length])
end temporary_path

--- The file is not a terminal.
public not_a_terminal: atom

--- A terminal's size in characters: its rows and columns.
public window: type = struct
    rows: u16
    columns: u16
end window

--- Terminals: whether a stream is one, and its size, so a program can
--- tell a person from a pipe and fit what it writes to the screen.  A
--- concept of its own, outside `world`.
public terminals: type = concept (provider: type)
    --- Whether `stream` is a terminal.
    is_terminal: (self: provider, stream: file) -> (yes: bool)
    --- The size of the terminal `stream`, `not_a_terminal` for anything
    --- else.  A terminal nothing has sized is zero by zero.
    window_size: (self: provider, stream: file) -> (size: window)
                 ! not_a_terminal | io_failed
end terminals

--- Whether `stream` is a terminal, through `terminals` evidence: false
--- for a file, a pipe and a socket, whatever a program writes to it.
public is_terminal: (provider: type is terminals, host: provider,
                     stream: file) -> (yes: bool) =
    yes = provider.is_terminal(host, stream)
end is_terminal

--- The size of the terminal `stream` in rows and columns.
public window_size: (provider: type is terminals, host: provider,
                     stream: file) -> (size: window)
                    ! not_a_terminal | io_failed =
    size = try provider.window_size(host, stream)
end window_size
