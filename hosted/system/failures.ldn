--  Words for whatever a program over the hosted services fails with: an
--  errno from `platform/posix`, which words its own, or a core library
--  failure, which `core/failure` words.  The two meet here rather than in
--  the system layer, which imports nothing above it (D1951).

import core/cache
import core/failure
import core/io
import core/line
import core/map
import core/mem
import core/net
import core/text
import core/tree
import platform/posix

--- A failure of a program over the hosted services: an errno, or one of
--- the core library's failures, which every provider over them also
--- reports.
public reason: type = posix.errno | failure.reason

--- A short English phrase for a failure: `posix.words` for an errno and
--- `failure.words` for a library failure (D582), in lower case but for a
--- name's own capitals and with no final stop, so that it reads after a
--- subject and a colon.  The phrase is static text: it borrows nothing and
--- is never freed.
public words: (problem: reason) -> (phrase: []u8) =
    --  An arm names one atom, so each library atom has its own, and what
    --  is left is an errno: an atom added to `failure.reason` without an
    --  arm here is refused where the rest is passed to `posix.words`.
    phrase = match problem
        mem.out_of_bounds: failure.words(mem.out_of_bounds)
        mem.empty: failure.words(mem.empty)
        mem.full: failure.words(mem.full)
        mem.not_empty: failure.words(mem.not_empty)
        mem.out_of_memory: failure.words(mem.out_of_memory)
        map.missing: failure.words(map.missing)
        map.end_of_entries: failure.words(map.end_of_entries)
        tree.no_such_node: failure.words(tree.no_such_node)
        tree.invalid_children: failure.words(tree.invalid_children)
        tree.too_many_nodes: failure.words(tree.too_many_nodes)
        tree.too_many_leaves: failure.words(tree.too_many_leaves)
        io.not_found: failure.words(io.not_found)
        io.no_access: failure.words(io.no_access)
        io.io_failed: failure.words(io.io_failed)
        io.is_a_directory: failure.words(io.is_a_directory)
        io.no_argument: failure.words(io.no_argument)
        io.already_exists: failure.words(io.already_exists)
        io.no_variable: failure.words(io.no_variable)
        io.line_too_long: failure.words(io.line_too_long)
        io.not_a_terminal: failure.words(io.not_a_terminal)
        net.invalid_address: failure.words(net.invalid_address)
        net.refused: failure.words(net.refused)
        net.unreachable: failure.words(net.unreachable)
        net.address_in_use: failure.words(net.address_in_use)
        net.address_unavailable: failure.words(net.address_unavailable)
        net.timed_out: failure.words(net.timed_out)
        net.disconnected: failure.words(net.disconnected)
        text.past_end: failure.words(text.past_end)
        text.invalid_text: failure.words(text.invalid_text)
        text.invalid_number: failure.words(text.invalid_number)
        text.number_overflow: failure.words(text.number_overflow)
        text.no_space: failure.words(text.no_space)
        text.invalid_format: failure.words(text.invalid_format)
        text.not_found: failure.words(text.not_found)
        text.invalid_scalar: failure.words(text.invalid_scalar)
        cache.misaligned: failure.words(cache.misaligned)
        cache.bad_line: failure.words(cache.bad_line)
        line.unsupported_rate: failure.words(line.unsupported_rate)
        line.unsupported_format: failure.words(line.unsupported_format)
        _ (rest): posix.words(rest)
    end match
end words
