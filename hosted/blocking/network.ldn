--  The blocking provider's `net.network`: a socket is a descriptor of
--  platform/posix's, a file of hosted/system's like any other, so `io.read`
--  and `io.write` take a connection as they take a file, and every call
--  that waits blocks the thread.  Written once, over platform/posix, like
--  the rest; windows_network.ldn is Windows'.

import core/io
import core/net
import core/text
import core/time
import hosted/system
import platform/posix

fixed if compiler.os <> windows then
    --  How many connections may wait to be accepted, which each system caps at
    --  its own limit: the BSDs' SOMAXCONN.
    backlog: i32 = 128

    --  Whether an errno says the caller may not do what it asked.
    refused: (problem: posix.errno) -> (yes: bool) =
        yes = problem == posix.eperm or problem == posix.eacces
              or problem == posix.erofs
    end refused

    --  Close a socket no caller is told about.
    quietly_closed: (closing: posix.descriptor) -> none =
        posix.close(closing) else none
    end quietly_closed

    --  The family of socket an address needs.
    family_of: (at: net.address) -> (family: posix.socket_family) =
        family = if at.family == net.ipv4 then posix.internet
                 else posix.internet6 end if
    end family_of

    --  Whether an errno says the system does not have the address here: no
    --  interface holds it, its zone names no interface, or the family is
    --  missing altogether.
    unavailable: (problem: posix.errno) -> (yes: bool) =
        yes = problem == posix.eaddrnotavail or problem == posix.eafnosupport
              or problem == posix.epfnosupport or problem == posix.enodev
              or problem == posix.enxio
    end unavailable

    --  Whether an errno says the peer has gone: it closed or reset the
    --  connection, or the system gave up on it.
    gone: (problem: posix.errno) -> (yes: bool) =
        yes = problem == posix.epipe or problem == posix.econnreset
              or problem == posix.etimedout or problem == posix.enotconn
    end gone

    --  A socket bound to `at`, a listener when `listening`: an IPv6 socket
    --  takes IPv6 alone on every system, and a listener may take an address
    --  its earlier connections still hold.
    bound: (at: net.address, kind: posix.socket_kind, listening: bool)
           -> (socket: posix.descriptor) ! posix.errno =
        socket = try posix.socket(family_of(at), kind)
        undo quietly_closed(socket)
        if at.family == net.ipv6 then
            try posix.set_ipv6_only(socket, true)
        end if
        if listening then
            try posix.set_reuse_address(socket, true)
        end if
        try posix.bind(socket, try system.internet_address(at))
        if listening then
            try posix.listen(socket, backlog)
        end if
    end bound

    --  The errno a binding failed with, as the concept's atoms.
    bind_failure: (self: host, problem: posix.errno)
                  -> none ! net.address_in_use | net.address_unavailable
                          | io.no_access | io.io_failed =
        record(self, problem)
        fail net.address_in_use when problem == posix.eaddrinuse
        fail net.address_unavailable when unavailable(problem)
        fail io.no_access when refused(problem)
        fail io.io_failed
    end bind_failure

    blocking_listen: (self: host, at: net.address) -> (listener: io.file)
                     ! net.address_in_use | net.address_unavailable | io.no_access
                     | io.io_failed =
        cleared(self)
        made: posix.descriptor = bound(at, posix.stream, true) else (problem)
            try bind_failure(self, problem)
            fail io.io_failed
        end
        listener = system.socket_of(made)
    end blocking_listen

    blocking_open_datagram: (self: host, at: net.address) -> (socket: io.file)
                            ! net.address_in_use | net.address_unavailable
                            | io.no_access | io.io_failed =
        cleared(self)
        made: posix.descriptor = bound(at, posix.datagram, false) else (problem)
            try bind_failure(self, problem)
            fail io.io_failed
        end
        socket = system.socket_of(made)
    end blocking_open_datagram

    --  A connection a signal interrupted goes on without its caller: wait
    --  until it is writable, which it is once it has ended either way, and
    --  take its outcome from the socket.
    finished: (socket: posix.descriptor) -> none ! posix.errno =
        mut entries: [1]posix.poll_entry =
            [posix.watch(socket, posix.poll_output)]
        loop do
            _ = posix.poll(entries[0..<1], -1) else (problem)
                continue when problem == posix.eintr
                fail problem
            end
            break
        end loop
        try posix.pending_error(socket)
    end finished

    connected: (to: net.address) -> (socket: posix.descriptor) ! posix.errno =
        target: posix.socket_address = try system.internet_address(to)
        socket = try posix.socket(family_of(to), posix.stream)
        undo quietly_closed(socket)
        posix.connect(socket, target) else (problem)
            fail problem when problem <> posix.eintr
            try finished(socket)
        end
    end connected

    --  Wait until a connection begun on `socket` has ended either way, or
    --  the clock has reached `deadline`, `etimedout`; take its outcome from
    --  the socket.  A poll a signal interrupts, or that ends early, is asked
    --  again for what is left, rounded up to the millisecond so that it
    --  never ends before the deadline.
    finished_by: (socket: posix.descriptor, deadline: u64) -> none ! posix.errno =
        mut entries: [1]posix.poll_entry =
            [posix.watch(socket, posix.poll_output)]
        loop do
            now: u64 = reading()
            fail posix.etimedout when now >= deadline
            left: u64 = deadline - now
            mut milliseconds: u64 = left / 1000000
            if left - milliseconds * 1000000 > 0 then inc milliseconds end if
            bounded: i32 = if milliseconds > 2147483647 then 2147483647
                           else i32(milliseconds) end if
            found: usize = posix.poll(entries[0..<1], bounded) else (problem)
                continue when problem == posix.eintr
                fail problem
            end
            break when found > 0
        end loop
        try posix.pending_error(socket)
    end finished_by

    --  A connection begun on a non-blocking socket, so that its wait can be
    --  limited, and the socket made to block again once it is made, as every
    --  other socket of this provider's does (D580).
    connected_by: (to: net.address, deadline: u64)
                  -> (socket: posix.descriptor) ! posix.errno =
        target: posix.socket_address = try system.internet_address(to)
        socket = try posix.socket(family_of(to), posix.stream)
        undo quietly_closed(socket)
        try posix.set_non_blocking(socket, true)
        posix.connect(socket, target) else (problem)
            fail problem when problem <> posix.einprogress
              and problem <> posix.eintr
            try finished_by(socket, deadline)
        end
        try posix.set_non_blocking(socket, false)
    end connected_by

    --  The errno a connection failed with, as the concept's atoms.
    connect_failure: (self: host, problem: posix.errno)
                     -> none ! net.refused | net.unreachable
                             | net.address_unavailable | net.timed_out
                             | io.io_failed =
        record(self, problem)
        fail net.refused when problem == posix.econnrefused
        fail net.unreachable when problem == posix.enetunreach
          or problem == posix.ehostunreach
        fail net.address_unavailable when unavailable(problem)
        fail net.timed_out when problem == posix.etimedout
        fail io.io_failed
    end connect_failure

    blocking_connect: (self: host, to: net.address) -> (opened: io.file)
                      ! net.refused | net.unreachable | net.address_unavailable
                      | net.timed_out | io.io_failed =
        cleared(self)
        made: posix.descriptor = connected(to) else (problem)
            try connect_failure(self, problem)
            fail io.io_failed
        end
        opened = system.socket_of(made)
    end blocking_connect

    blocking_connect_within: (self: host, to: net.address, limit: time.duration)
                             -> (opened: io.file)
                             ! net.refused | net.unreachable
                             | net.address_unavailable | net.timed_out
                             | io.io_failed =
        if u64(limit) == 0 then
            opened = try blocking_connect(self, to)
            return
        end if
        cleared(self)
        made: posix.descriptor = connected_by(to, deadline_after(limit))
            else (problem)
            try connect_failure(self, problem)
            fail io.io_failed
        end
        opened = system.socket_of(made)
    end blocking_connect_within

    blocking_accept: (self: host, listener: io.file) -> (accepted: io.file)
                     ! net.timed_out | io.io_failed =
        cleared(self)
        loop do
            made: posix.descriptor =
                posix.accept(system.descriptor_of(listener)) else (problem)
                    --  An interrupted accept took nothing, and a connection
                    --  its peer reset before it was taken is no connection.
                    continue when problem == posix.eintr
                      or problem == posix.econnaborted
                    record(self, problem)
                    fail net.timed_out when problem == posix.eagain
                    fail io.io_failed
                end
            accepted = system.socket_of(made)
            return
        end loop
    end blocking_accept

    blocking_send: (self: host, connection: io.file, bytes: []u8)
                   -> none ! net.disconnected | net.timed_out | io.io_failed =
        cleared(self)
        mut sent: usize = 0
        while sent < lenof bytes do
            --  A send interrupted before it sent anything is made again with
            --  what is left; a short one goes on from where it stopped.
            accepted: usize =
                posix.send(system.descriptor_of(connection),
                           bytes[sent..<lenof bytes]) else (problem)
                    continue when problem == posix.eintr
                    record(self, problem)
                    fail net.disconnected when gone(problem)
                    fail net.timed_out when problem == posix.eagain
                    fail io.io_failed
                end
            fail io.io_failed when accepted == 0
              or accepted > lenof bytes - sent
            sent += accepted
        end while
    end blocking_send

    blocking_receive: (self: host, connection: io.file, into: []mut u8)
                      -> (count: usize)
                      ! net.disconnected | net.timed_out | io.io_failed =
        cleared(self)
        count = 0
        return when lenof into == 0
        loop do
            got: usize = posix.receive(system.descriptor_of(connection), into)
                else (problem)
                continue when problem == posix.eintr
                record(self, problem)
                fail net.disconnected when gone(problem)
                fail net.timed_out when problem == posix.eagain
                fail io.io_failed
            end
            fail io.io_failed when got > lenof into
            count = got
            return
        end loop
    end blocking_receive

    blocking_send_to: (self: host, socket: io.file, bytes: []u8,
                       to: net.address) -> none
                      ! net.unreachable | net.timed_out | io.io_failed =
        cleared(self)
        --  A zone that names no interface leads nowhere.
        target: posix.socket_address = system.internet_address(to) else (problem)
            record(self, problem)
            fail net.unreachable
        end
        loop do
            accepted: usize =
                posix.send_to(system.descriptor_of(socket), bytes,
                              target) else (problem)
                    continue when problem == posix.eintr
                    record(self, problem)
                    fail net.unreachable when problem == posix.enetunreach
                      or problem == posix.ehostunreach
                    fail net.timed_out when problem == posix.eagain
                    fail io.io_failed
                end
            --  A datagram goes whole or not at all.
            fail io.io_failed when accepted <> lenof bytes
            return
        end loop
    end blocking_send_to

    blocking_receive_from: (self: host, socket: io.file, into: []mut u8)
                           -> (taken: net.datagram) ! net.timed_out | io.io_failed =
        cleared(self)
        loop do
            got: posix.received =
                posix.receive_from(system.descriptor_of(socket), into)
                else (problem)
                    continue when problem == posix.eintr
                    record(self, problem)
                    fail net.timed_out when problem == posix.eagain
                    fail io.io_failed
                end
            fail io.io_failed when got.count > lenof into
            sender: net.address = system.address_of(got.sender) else (problem)
                record(self, problem)
                fail io.io_failed
            end
            taken = (count: got.count, sender: sender)
            return
        end loop
    end blocking_receive_from

    blocking_shutdown: (self: host, connection: io.file,
                        stopping: net.direction) -> none ! io.io_failed =
        cleared(self)
        side: posix.shutdown_side = match stopping
            net.receiving: posix.shut_reading
            net.sending: posix.shut_writing
            net.both_directions: posix.shut_both
        end match
        posix.shutdown(system.descriptor_of(connection), side) else (problem)
            record(self, problem)
            fail io.io_failed
        end
    end blocking_shutdown

    --  The internet address of a socket's own end, or with `peer` of the
    --  other end.
    named: (socket: io.file, peer: bool) -> (at: net.address) ! posix.errno =
        record: posix.socket_address =
            if peer then try posix.peer_name(system.descriptor_of(socket))
            else try posix.socket_name(system.descriptor_of(socket)) end if
        at = try system.address_of(record)
    end named

    blocking_local_address: (self: host, socket: io.file) -> (at: net.address)
                            ! io.io_failed =
        cleared(self)
        at = named(socket, false) else (problem)
            record(self, problem)
            fail io.io_failed
        end
    end blocking_local_address

    blocking_peer_address: (self: host, connection: io.file)
                           -> (at: net.address) ! io.io_failed =
        cleared(self)
        at = named(connection, true) else (problem)
            record(self, problem)
            fail io.io_failed
        end
    end blocking_peer_address

    --  A span as the system's seconds and nanoseconds.
    time_of: (span: time.duration) -> (reading: posix.time_value) =
        whole: u64 = u64(span) / 1000000000
        reading = (seconds: i64(whole),
                   nanoseconds: u32(u64(span) - whole * 1000000000))
    end time_of

    limited: (socket: io.file, receive_limit: time.duration,
              send_limit: time.duration) -> none ! posix.errno =
        try posix.set_receive_timeout(system.descriptor_of(socket),
                                      time_of(receive_limit))
        try posix.set_send_timeout(system.descriptor_of(socket),
                                   time_of(send_limit))
    end limited

    blocking_set_timeouts: (self: host, socket: io.file,
                            receive_limit: time.duration, send_limit: time.duration)
                           -> none ! io.io_failed =
        cleared(self)
        limited(socket, receive_limit, send_limit) else (problem)
            record(self, problem)
            fail io.io_failed
        end
    end blocking_set_timeouts

    blocking_set_no_delay: (self: host, connection: io.file, on: bool)
                           -> none ! io.io_failed =
        cleared(self)
        posix.set_no_delay(system.descriptor_of(connection), on) else (problem)
            record(self, problem)
            fail io.io_failed
        end
    end blocking_set_no_delay

    --  A failed close may already have released the descriptor, as a file's
    --  may, so it is never retried.
    blocking_close_socket: (self: host, sink socket: io.file)
                           -> none ! io.io_failed =
        cleared(self)
        posix.close(system.descriptor_of(socket)) else (problem)
            record(self, problem)
            fail io.io_failed
        end
    end blocking_close_socket

    --  The errno an option failed with, as the concept's atoms: an option
    --  the system does not have is `unsupported`.
    option_failure: (self: host, problem: posix.errno)
                    -> none ! net.unsupported | io.io_failed =
        record(self, problem)
        fail net.unsupported when problem == posix.enoprotoopt
          or problem == posix.eopnotsupp
        fail io.io_failed
    end option_failure

    blocking_set_flag: (self: host, socket: io.file, which: net.flag_option,
                        on: bool) -> none ! net.unsupported | io.io_failed =
        cleared(self)
        system.set_socket_flag(socket, which, on) else (problem)
            try option_failure(self, problem)
            fail io.io_failed
        end
    end blocking_set_flag

    blocking_flag: (self: host, socket: io.file, which: net.flag_option)
                   -> (on: bool) ! net.unsupported | io.io_failed =
        cleared(self)
        on = system.socket_flag(socket, which) else (problem)
            try option_failure(self, problem)
            fail io.io_failed
        end
    end blocking_flag

    blocking_set_number: (self: host, socket: io.file,
                          which: net.number_option, value: u32)
                         -> none ! net.unsupported | io.io_failed =
        cleared(self)
        system.set_socket_number(socket, which, value) else (problem)
            try option_failure(self, problem)
            fail io.io_failed
        end
    end blocking_set_number

    blocking_number: (self: host, socket: io.file, which: net.number_option)
                     -> (value: u32) ! net.unsupported | io.io_failed =
        cleared(self)
        value = system.socket_number(socket, which) else (problem)
            try option_failure(self, problem)
            fail io.io_failed
        end
    end blocking_number

    blocking_set_span: (self: host, socket: io.file, which: net.span_option,
                        value: time.duration)
                       -> none ! net.unsupported | io.io_failed =
        cleared(self)
        system.set_socket_span(socket, which, value) else (problem)
            try option_failure(self, problem)
            fail io.io_failed
        end
    end blocking_set_span

    blocking_span: (self: host, socket: io.file, which: net.span_option)
                   -> (value: time.duration) ! net.unsupported | io.io_failed =
        cleared(self)
        value = system.socket_span(socket, which) else (problem)
            try option_failure(self, problem)
            fail io.io_failed
        end
    end blocking_span

    blocking_set_linger: (self: host, socket: io.file, on: bool,
                          limit: time.duration) -> none ! io.io_failed =
        cleared(self)
        system.set_socket_linger(socket, on, limit) else (problem)
            record(self, problem)
            fail io.io_failed
        end
    end blocking_set_linger

    blocking_linger: (self: host, socket: io.file)
                     -> (on: bool, limit: time.duration) ! io.io_failed =
        cleared(self)
        (on: lingers, limit: kept) := system.socket_linger(socket)
            else (problem)
            record(self, problem)
            fail io.io_failed
        end
        on = lingers
        limit = kept
    end blocking_linger

    --  Join or leave a group, its errno as the concept's atoms.
    membership: (self: host, socket: io.file, group: net.address,
                 through: net.address, joining: bool)
                -> none ! net.address_unavailable | io.io_failed =
        cleared(self)
        system.socket_membership(socket, group, through, joining)
            else (problem)
            record(self, problem)
            fail net.address_unavailable when unavailable(problem)
              or problem == posix.einval
            fail io.io_failed
        end
    end membership

    blocking_join_group: (self: host, socket: io.file, group: net.address,
                          through: net.address)
                         -> none ! net.address_unavailable | io.io_failed =
        try membership(self, socket, group, through, true)
    end blocking_join_group

    blocking_leave_group: (self: host, socket: io.file, group: net.address,
                           through: net.address)
                          -> none ! net.address_unavailable | io.io_failed =
        try membership(self, socket, group, through, false)
    end blocking_leave_group

    blocking_resolve: (self: host, name: []u8, port: u16,
                       into: []mut net.address)
                      -> (count: usize)
                      ! net.unknown_name | net.timed_out | io.io_failed =
        cleared(self)
        count = try system.resolve_over(self, name, port, into)
    end blocking_resolve

    --  The system's record of a Unix-domain path: a path it cannot hold is
    --  `invalid_address`.
    local_record: (self: host, path: text.os_string)
                  -> (made: posix.socket_address) ! net.invalid_address =
        made = posix.unix_address(path) else (problem)
            record(self, problem)
            fail net.invalid_address
        end
    end local_record

    --  A Unix-domain socket of `kind` bound to `at`, a listener when
    --  `listening`.
    bound_locally: (at: posix.socket_address, kind: posix.socket_kind,
                    listening: bool) -> (socket: posix.descriptor) ! posix.errno =
        socket = try posix.socket(posix.local, kind)
        undo quietly_closed(socket)
        try posix.bind(socket, at)
        if listening then
            try posix.listen(socket, backlog)
        end if
    end bound_locally

    --  The errno a Unix-domain binding failed with, as the concept's atoms.
    local_bind_failure: (self: host, problem: posix.errno)
                        -> none ! net.address_in_use | net.unsupported
                                | io.no_access | io.io_failed =
        record(self, problem)
        fail net.address_in_use when problem == posix.eaddrinuse
        fail net.unsupported when problem == posix.eafnosupport
          or problem == posix.eprotonosupport
        fail io.no_access when refused(problem)
        fail io.io_failed
    end local_bind_failure

    blocking_listen_local: (self: host, path: text.os_string)
                           -> (listener: io.file)
                           ! net.address_in_use | net.invalid_address
                           | net.unsupported | io.no_access | io.io_failed =
        cleared(self)
        at: posix.socket_address = try local_record(self, path)
        made: posix.descriptor = bound_locally(at, posix.stream, true)
            else (problem)
            try local_bind_failure(self, problem)
            fail io.io_failed
        end
        listener = system.socket_of(made)
    end blocking_listen_local

    blocking_open_local_datagram: (self: host, path: text.os_string)
                                  -> (socket: io.file)
                                  ! net.address_in_use | net.invalid_address
                                  | net.unsupported | io.no_access
                                  | io.io_failed =
        cleared(self)
        at: posix.socket_address = try local_record(self, path)
        made: posix.descriptor = bound_locally(at, posix.datagram, false)
            else (problem)
            try local_bind_failure(self, problem)
            fail io.io_failed
        end
        socket = system.socket_of(made)
    end blocking_open_local_datagram

    --  A Unix-domain connection to `at`, a signal's interruption waited out
    --  as an internet connection's is.
    connected_locally: (at: posix.socket_address)
                       -> (socket: posix.descriptor) ! posix.errno =
        socket = try posix.socket(posix.local, posix.stream)
        undo quietly_closed(socket)
        posix.connect(socket, at) else (problem)
            fail problem when problem <> posix.eintr
            try finished(socket)
        end
    end connected_locally

    --  Whether an errno says nothing is bound at a Unix-domain path.
    nobody_there: (problem: posix.errno) -> (yes: bool) =
        yes = problem == posix.econnrefused or problem == posix.enoent
              or problem == posix.enotsock or problem == posix.eprototype
    end nobody_there

    blocking_connect_local: (self: host, path: text.os_string)
                            -> (connected: io.file)
                            ! net.refused | net.invalid_address
                            | net.unsupported | io.no_access | io.io_failed =
        cleared(self)
        at: posix.socket_address = try local_record(self, path)
        made: posix.descriptor = connected_locally(at) else (problem)
            record(self, problem)
            fail net.refused when nobody_there(problem)
            fail net.unsupported when problem == posix.eafnosupport
            fail io.no_access when refused(problem)
            fail io.io_failed
        end
        connected = system.socket_of(made)
    end blocking_connect_local

    blocking_send_to_local: (self: host, socket: io.file, bytes: []u8,
                             path: text.os_string)
                            -> none ! net.refused | net.invalid_address
                                    | net.timed_out | io.io_failed =
        cleared(self)
        target: posix.socket_address = try local_record(self, path)
        loop do
            accepted: usize =
                posix.send_to(system.descriptor_of(socket), bytes, target)
                else (problem)
                    continue when problem == posix.eintr
                    record(self, problem)
                    fail net.refused when nobody_there(problem)
                    fail net.timed_out when problem == posix.eagain
                    fail io.io_failed
                end
            fail io.io_failed when accepted <> lenof bytes
            return
        end loop
    end blocking_send_to_local

    --  The path of a Unix-domain sender, into `room`.
    sender_path: (self: host, sender: posix.socket_address, room: []mut u8)
                 -> (path: text.os_string from room) ! io.io_failed =
        path = posix.unix_path(sender, room) else (problem)
            record(self, problem)
            fail io.io_failed
        end
    end sender_path

    blocking_receive_from_local: (self: host, socket: io.file, into: []mut u8,
                                  room: []mut u8)
                                 -> (count: usize,
                                     sender: text.os_string from room)
                                 ! net.timed_out | io.io_failed =
        cleared(self)
        loop do
            got: posix.received =
                posix.receive_from(system.descriptor_of(socket), into)
                else (problem)
                    continue when problem == posix.eintr
                    record(self, problem)
                    fail net.timed_out when problem == posix.eagain
                    fail io.io_failed
                end
            fail io.io_failed when got.count > lenof into
            sender = try sender_path(self, got.sender, room)
            count = got.count
            return
        end loop
    end blocking_receive_from_local

    host is net.network
        (connect: blocking_connect, connect_within: blocking_connect_within,
         listen: blocking_listen,
         accept: blocking_accept, open_datagram: blocking_open_datagram,
         send: blocking_send, receive: blocking_receive, send_to: blocking_send_to,
         receive_from: blocking_receive_from, shutdown: blocking_shutdown,
         local_address: blocking_local_address,
         peer_address: blocking_peer_address,
         set_timeouts: blocking_set_timeouts, set_no_delay: blocking_set_no_delay,
         close: blocking_close_socket,
         set_flag: blocking_set_flag, flag: blocking_flag,
         set_number: blocking_set_number, number: blocking_number,
         set_span: blocking_set_span, span: blocking_span,
         set_linger: blocking_set_linger, linger: blocking_linger,
         join_group: blocking_join_group, leave_group: blocking_leave_group,
         resolve: blocking_resolve,
         connect_local: blocking_connect_local,
         listen_local: blocking_listen_local,
         open_local_datagram: blocking_open_local_datagram,
         send_to_local: blocking_send_to_local,
         receive_from_local: blocking_receive_from_local)
end if
